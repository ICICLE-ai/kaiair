@@ -279,12 +279,14 @@ inline float pktr_gamma_now(float env_fallback)
 /// IPC-UL actuation policy.
 inline float pktr_ul_sinr_offset_db(const pktr_link_state& ls, const pktr_settings& s)
 {
-  if (not pktr_actuate_now(s.actuate) or not ls.has_samples() or ls.std_ni_db() > s.sigma_transient_db) {
+  if (not pktr_actuate_now(s.actuate) or not ls.has_samples() or ls.sigma_sinr_db() > s.sigma_transient_db) {
     return 0.0F;
   }
+  // Full Cantelli sigma = sqrt(Var[S] + Var[NI]), the std of (S - I) per pktR_CR Eq. (2) / thesis
+  // ch.4 Eq. (4.46), NOT the interference std alone.
