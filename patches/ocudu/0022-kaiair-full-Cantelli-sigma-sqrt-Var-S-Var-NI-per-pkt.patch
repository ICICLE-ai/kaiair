-// The reliability target is 1 - beta.
+// The reliability target is 1 - beta (no deadline configured).
 TEST(pktr_dl_power_controller_test, target_is_one_minus_beta)
 {
   EXPECT_NEAR(pktr_dl_power_controller(loop_settings(0.9F)).target(), 0.1F, 1e-6F);
   EXPECT_NEAR(pktr_dl_power_controller(loop_settings(0.99F)).target(), 0.01F, 1e-6F);
 }
 
+// LDP composition: with a deadline affording N in-deadline transmissions, the BLER target is
+// 1 - p_req(N) with p_req = 1 - (1-pkt_beta)^(1/N), the same single composition point as the UL
+// cushion. Deadline 10 ms at (first 5, retx 5) -> N = 2 -> p_req = 1 - 0.1^(1/2) ~= 0.6838.
+TEST(pktr_dl_power_controller_test, target_composes_ldp_deadline)
+{
+  pktr_settings s     = loop_settings(0.9F);
+  s.ldp.deadline_ms   = 10.0F;
+  s.ldp.pkt_beta      = 0.9F;
+  s.ldp.first_tx_ms   = 5.0F;
+  s.ldp.retx_interval_ms = 5.0F;
+  const float p_req = ldp_required_tx_reliability(0.9F, 2);
+  EXPECT_NEAR(pktr_dl_power_controller(s).target(), 1.0F - p_req, 1e-5F);
+  EXPECT_GT(pktr_dl_power_controller(s).target(), 0.1F); // looser than the no-deadline 10% target
+}
+
 // Starts at the (backed-off) nominal offset, quantized to the 1-dB field.
 TEST(pktr_dl_power_controller_test, starts_at_nominal)
 {
diff --git a/tests/unittests/scheduler/kaiair/pktr_link_state_test.cpp b/tests/unittests/scheduler/kaiair/pktr_link_state_test.cpp
index 9a49a260d5..7da4d5a3db 100644
--- a/tests/unittests/scheduler/kaiair/pktr_link_state_test.cpp
+++ b/tests/unittests/scheduler/kaiair/pktr_link_state_test.cpp
@@ -103,3 +103,45 @@ TEST(pktr_link_state_test, reset_clears_state)
   EXPECT_FALSE(ls.has_samples());
   EXPECT_EQ(ls.nof_samples(), 0U);
 }
+
+// Signal-side statistics: first sample sets the signal mean with zero variance, so the full
+// Cantelli sigma sqrt(Var[S] + Var[NI]) starts at zero.
+TEST(pktr_link_state_test, signal_stats_tracked_alongside_ni)
+{
+  pktr_link_state ls;
+  ls.push_ul_measurement(/*sinr_db=*/5.0F, /*rsrp_db=*/-20.0F);
+  EXPECT_FLOAT_EQ(ls.mean_signal_db(), -20.0F);
+  EXPECT_FLOAT_EQ(ls.var_signal(), 0.0F);
+  EXPECT_FLOAT_EQ(ls.sigma_sinr_db(), 0.0F);
+}
+
+// Paper anchor (pktR_CR Eq. (2) via ch.4 Eq. (4.45)): sigma is the std of (S - I), i.e.
+// sqrt(Var[S] + Var[NI]), a fluctuating SIGNAL with constant NI must inflate the cushion sigma
+// even though the NI std alone stays ~0.
+TEST(pktr_link_state_test, sigma_includes_signal_variance)
+{
+  pktr_link_state ls;
+  // RSRP alternates -18/-22 while SINR moves with it so NI = RSRP - SINR stays constant at -25.
+  for (int i = 0; i < 400; ++i) {
+    const float rsrp = (i % 2 == 0) ? -18.0F : -22.0F;
+    ls.push_ul_measurement(/*sinr_db=*/rsrp - (-25.0F), rsrp);
+  }
+  EXPECT_NEAR(ls.std_ni_db(), 0.0F, 1e-3F);
+  EXPECT_GT(ls.std_signal_db(), 0.5F);
+  // sigma == sqrt(VarS + VarNI) reduces to the signal std here.
+  EXPECT_NEAR(ls.sigma_sinr_db(), ls.std_signal_db(), 1e-4F);
+}
+
+// Independent jitter on both sides adds in variance: sigma^2 == Var[S] + Var[NI] exactly.
+TEST(pktr_link_state_test, sigma_is_root_sum_of_variances)
+{
+  pktr_link_state ls;
+  for (int i = 0; i < 500; ++i) {
+    const float s_jit  = (i % 2 == 0) ? 1.0F : -1.0F;
+    const float ni_jit = (i % 3 == 0) ? 1.5F : -0.75F;
+    ls.push_ul_measurement(/*sinr_db=*/(-20.0F + s_jit) - (-28.0F + ni_jit), /*rsrp_db=*/-20.0F + s_jit);
+  }
+  EXPECT_NEAR(ls.sigma_sinr_db() * ls.sigma_sinr_db(), ls.var_signal() + ls.var_ni(), 1e-3F);
+  EXPECT_GT(ls.sigma_sinr_db(), ls.std_ni_db());
+  EXPECT_GT(ls.sigma_sinr_db(), ls.std_signal_db());
+}
