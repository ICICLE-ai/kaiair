--- a/lib/scheduler/kaiair/pktr_link_state.h
+++ b/lib/scheduler/kaiair/pktr_link_state.h
@@ -16,9 +16,16 @@
 // memory of the filter: c -> 1 is stable/slow, c -> 0 is agile. The PRKS/PktR work uses c = 15/16.
 // This mirrors the EWMA interference filter in the PktR papers (I_R(t+1) = c*I_R(t) + (1-c)*I_R(t+1)).
 //
-// Scope: one instance per link (per UE, per direction). Channel-side statistics (predicted gain
-// G-hat and Var[G]) and the beta-quantile of SINR are added in later increments; this class
-// currently tracks the interference side only.
+// The same EWMA is kept for the received signal power S (RSRP), so the full Cantelli sigma of the
+// PktR power-control law (pktR_CR Eq. (2), thesis ch.4 Eq. (4.45)) is available:
+//
+//   sigma_SINR = sqrt(Var[S] + Var[NI])
+//
+// Var[S] proxies the channel-gain variance Var[G] under quasi-static transmit power (the TPC
+// accumulator moves in sub-dB steps at steady state). The ch.4 refinement, slow/fast channel
+// decomposition with a Kalman predictor for G-hat, is a later increment.
+//
+// Scope: one instance per link (per UE, per direction).
 
 #pragma once
 
@@ -38,18 +45,24 @@ public:
   explicit pktr_link_state(float ewma_c = default_ewma_c) : c(ewma_c) {}
 
   /// Feed one per-packet UL measurement: the SINR and the received signal power (RSRP), both in dB.
-  /// Updates the running mean and variance of the receiver interference-plus-noise NI = RSRP - SINR.
+  /// Updates the running mean/variance of the interference-plus-noise NI = RSRP - SINR and of the
+  /// received signal power S = RSRP (the channel-side term of the Cantelli sigma).
   void push_ul_measurement(float sinr_db, float rsrp_db)
   {
     const float ni    = rsrp_db - sinr_db; // receiver-side interference + noise (dB)
     const float alpha = 1.0F - c;          // new-sample weight
     if (nof_samples_ == 0) {
-      mean_ni_db_ = ni;
-      var_ni_     = 0.0F;
+      mean_ni_db_  = ni;
+      var_ni_      = 0.0F;
+      mean_sig_db_ = rsrp_db;
+      var_sig_     = 0.0F;
     } else {
       const float delta = ni - mean_ni_db_;
       mean_ni_db_ += alpha * delta;
       var_ni_ = (1.0F - alpha) * (var_ni_ + alpha * delta * delta);
+      const float sdelta = rsrp_db - mean_sig_db_;
+      mean_sig_db_ += alpha * sdelta;
+      var_sig_ = (1.0F - alpha) * (var_sig_ + alpha * sdelta * sdelta);
     }
     latest_ni_db_ = ni;
     ++nof_samples_;
@@ -74,12 +87,33 @@ public:
   /// EWMA standard deviation of the interference-plus-noise (dB).
   float std_ni_db() const { return std::sqrt(var_ni_ > 0.0F ? var_ni_ : 0.0F); }
 
+  /// EWMA mean of the received signal power S (dB).
+  float mean_signal_db() const { return mean_sig_db_; }
+
+  /// EWMA variance of the received signal power (dB^2), the channel-side term of the Cantelli
+  /// sigma (Var[S] ~ Var[G] under quasi-static transmit power).
+  float var_signal() const { return var_sig_; }
+
+  /// EWMA standard deviation of the received signal power (dB).
+  float std_signal_db() const { return std::sqrt(var_sig_ > 0.0F ? var_sig_ : 0.0F); }
+
+  /// Full Cantelli sigma of the PktR power-control law: sigma = sqrt(Var[S] + Var[NI]) (dB).
+  /// This is the std of (S - I) from pktR_CR Eq. (2) under the ch.4 independence decomposition
+  /// (Eq. 4.45), and the value the reliability cushion sigma*k(beta) must use.
+  float sigma_sinr_db() const
+  {
+    const float v = (var_sig_ > 0.0F ? var_sig_ : 0.0F) + (var_ni_ > 0.0F ? var_ni_ : 0.0F);
+    return std::sqrt(v);
+  }
+
   /// Clear all accumulated statistics.
   void reset()
   {
     nof_samples_  = 0;
     mean_ni_db_   = 0.0F;
     var_ni_       = 0.0F;
+    mean_sig_db_  = 0.0F;
+    var_sig_      = 0.0F;
     latest_ni_db_ = 0.0F;
   }
 
@@ -88,6 +122,8 @@ private:
   uint64_t nof_samples_ = 0;
   float    mean_ni_db_   = 0.0F;
   float    var_ni_       = 0.0F;
+  float    mean_sig_db_  = 0.0F;
+  float    var_sig_      = 0.0F;
   float    latest_ni_db_ = 0.0F;
 };
 
