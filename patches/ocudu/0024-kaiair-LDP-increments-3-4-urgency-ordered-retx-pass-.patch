diff --git a/lib/scheduler/kaiair/pktr_ldp.h b/lib/scheduler/kaiair/pktr_ldp.h
index 4bd0b1740d..07b79e0bcf 100644
--- a/lib/scheduler/kaiair/pktr_ldp.h
+++ b/lib/scheduler/kaiair/pktr_ldp.h
@@ -87,6 +87,19 @@ inline unsigned ldp_deadline_slots(const ldp_config& cfg, unsigned slots_per_ms)
   return static_cast<unsigned>(std::lround(cfg.deadline_ms * static_cast<float>(slots_per_ms)));
 }
 
+/// Deadline-aware cap on HARQ retransmissions: a TB whose deadline affords N(D) in-deadline
+/// transmissions should never be configured for more than N(D)-1 retransmissions -- the budget is
+/// then enforced by construction at allocation time (the abandonment check remains the backstop
+/// for slots that slip). Passes the configured max through unchanged when LDP is disabled.
+inline unsigned ldp_capped_max_retxs(const ldp_config& cfg, unsigned configured_max)
+{
+  if (cfg.deadline_ms <= 0.0F) {
+    return configured_max;
+  }
+  const unsigned budget = ldp_tx_budget(cfg); // >= 1 (first tx included)
+  return std::min(configured_max, budget - 1U);
+}
