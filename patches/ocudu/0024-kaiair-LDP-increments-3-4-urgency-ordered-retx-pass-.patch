+
+// N(D)-capped retransmissions: a TB never plans more than N(D)-1 retxs; disabled LDP passes the
+// configured max through; a single-shot deadline (N=1) means zero retransmissions.
+TEST(pktr_ldp_test, capped_max_retxs)
+{
+  ldp_config cfg; // disabled by default
+  EXPECT_EQ(ldp_capped_max_retxs(cfg, 4), 4U);
+
+  cfg.deadline_ms      = 20.0F; // first 5, retx 5 -> N = 4
+  cfg.first_tx_ms      = 5.0F;
+  cfg.retx_interval_ms = 5.0F;
+  EXPECT_EQ(ldp_tx_budget(cfg), 4U);
+  EXPECT_EQ(ldp_capped_max_retxs(cfg, 4), 3U); // N-1
+  EXPECT_EQ(ldp_capped_max_retxs(cfg, 2), 2U); // configured max still binds if tighter
+
+  cfg.deadline_ms = 5.0F; // N = 1 -> single shot
+  EXPECT_EQ(ldp_capped_max_retxs(cfg, 4), 0U);
+}
