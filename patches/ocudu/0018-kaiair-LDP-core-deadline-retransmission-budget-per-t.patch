diff --git a/tests/unittests/scheduler/kaiair/pktr_ldp_test.cpp b/tests/unittests/scheduler/kaiair/pktr_ldp_test.cpp
new file mode 100644
index 0000000000..4719e6fce6
--- /dev/null
+++ b/tests/unittests/scheduler/kaiair/pktr_ldp_test.cpp
@@ -0,0 +1,94 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#include "lib/scheduler/kaiair/pktr_ldp.h"
+#include <gtest/gtest.h>
+
+using namespace ocudu;
+using namespace ocudu::kaiair;
+
+// N(D): first attempt at first_tx_ms, one more per retx_interval_ms, floor semantics.
+TEST(pktr_ldp_test, tx_budget_counts_in_deadline_attempts)
+{
+  ldp_config cfg;
+  cfg.first_tx_ms      = 5.0F;
+  cfg.retx_interval_ms = 5.0F;
+
+  cfg.deadline_ms = 5.0F; // exactly the first attempt
+  EXPECT_EQ(ldp_tx_budget(cfg), 1U);
+  cfg.deadline_ms = 9.9F; // first attempt + not-quite one retry
+  EXPECT_EQ(ldp_tx_budget(cfg), 1U);
+  cfg.deadline_ms = 10.0F; // first + 1 retry
+  EXPECT_EQ(ldp_tx_budget(cfg), 2U);
+  cfg.deadline_ms = 25.0F; // first + 4 retries
+  EXPECT_EQ(ldp_tx_budget(cfg), 5U);
+}
+
+// A deadline tighter than even the first attempt still yields one attempt (never zero).
+TEST(pktr_ldp_test, tx_budget_never_zero)
+{
+  ldp_config cfg;
+  cfg.deadline_ms      = 1.0F;
+  cfg.first_tx_ms      = 5.0F;
+  cfg.retx_interval_ms = 5.0F;
+  EXPECT_EQ(ldp_tx_budget(cfg), 1U);
+}
+
+// Budget is clamped to the numeric ceiling for absurdly loose deadlines.
+TEST(pktr_ldp_test, tx_budget_clamped)
+{
+  ldp_config cfg;
+  cfg.deadline_ms      = 1e9F;
+  cfg.first_tx_ms      = 5.0F;
+  cfg.retx_interval_ms = 5.0F;
+  EXPECT_EQ(ldp_tx_budget(cfg), 64U);
+}
+
+// p_req: N=1 degenerates to the packet target itself; more attempts relax the per-tx requirement.
+TEST(pktr_ldp_test, required_reliability_monotone_in_budget)
+{
+  const float beta_pkt = 0.99F;
+  const float p1       = ldp_required_tx_reliability(beta_pkt, 1);
+  const float p2       = ldp_required_tx_reliability(beta_pkt, 2);
+  const float p5       = ldp_required_tx_reliability(beta_pkt, 5);
+  EXPECT_NEAR(p1, beta_pkt, 1e-6F);
+  EXPECT_LT(p2, p1);
+  EXPECT_LT(p5, p2);
+  // Known anchor: 1-(1-0.99)^(1/2) = 0.9 exactly.
+  EXPECT_NEAR(p2, 0.9F, 1e-4F);
+}
+
+// Composition closes: using p_req for N attempts achieves at least beta_pkt.
+TEST(pktr_ldp_test, required_reliability_meets_packet_target)
+{
+  for (unsigned n : {1U, 2U, 3U, 5U, 10U, 64U}) {
+    const float p_req    = ldp_required_tx_reliability(0.999F, n);
+    const float achieved = ldp_achieved_pkt_reliability(p_req, n);
+    EXPECT_GE(achieved, 0.999F - 1e-4F) << "n=" << n;
+  }
+}
+
+// The Cantelli cushion shrinks as the deadline loosens: fewer dB needed per attempt when HARQ
+// can absorb failures, the power-vs-latency trade LDP exists to expose.
+TEST(pktr_ldp_test, cushion_shrinks_with_looser_deadline)
+{
+  ldp_config cfg;
+  cfg.pkt_beta         = 0.99F;
+  cfg.first_tx_ms      = 5.0F;
+  cfg.retx_interval_ms = 5.0F;
+
+  cfg.deadline_ms  = 5.0F; // N=1
+  const float k_tight = cantelli_sigma_factor(ldp_effective_tx_beta(cfg, 0.9F));
+  cfg.deadline_ms  = 25.0F; // N=5
+  const float k_loose = cantelli_sigma_factor(ldp_effective_tx_beta(cfg, 0.9F));
+  EXPECT_GT(k_tight, k_loose);
+  // N=1: per-tx beta = pkt beta 0.99 -> k = sqrt(0.99/0.01) ~ 9.95
+  EXPECT_NEAR(k_tight, 9.9499F, 1e-2F);
+}
+
+// Deadline disabled -> the static per-transmission beta passes through untouched.
+TEST(pktr_ldp_test, disabled_passthrough)
+{
+  ldp_config cfg; // deadline_ms = 0
+  EXPECT_NEAR(ldp_effective_tx_beta(cfg, 0.9F), 0.9F, 1e-6F);
+}
