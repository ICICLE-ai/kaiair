index 0000000000..979b63c2c4
--- /dev/null
+++ b/lib/scheduler/kaiair/pktr_ldp.h
@@ -0,0 +1,90 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+//
+// KaiAir / PktR, LDP (Latest-Deadline / retransmission-budget) core.
+//
+// PRK-family URLLC delivers a packet with reliability beta_pkt BEFORE its deadline D. A single
+// transmission attempt only needs reliability p if there is time for retries: with N in-deadline
+// transmission opportunities, P(delivered) = 1 - (1 - p)^N, so the REQUIRED per-attempt
+// reliability is
+//
+//   p_req(N) = 1 - (1 - beta_pkt)^(1/N).
+//
+// LDP therefore composes with the Cantelli power loop (pktr_ipc.h): the deadline and the HARQ
+// retransmission cadence fix N; N and beta_pkt fix p_req; p_req becomes the per-transmission beta
+// that sizes the Cantelli cushion sigma*k(p_req). Tight deadlines (small N) demand more power per
+// attempt; loose deadlines let HARQ absorb failures and save power/interference, the exact
+// power-vs-latency trade PktR is built to expose.
+//
+// This header is pure math (no scheduler state, no I/O), mirroring pktr_ipc.h. Times are in ms.
+
+#pragma once
+
+#include "pktr_ipc.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace ocudu {
+namespace kaiair {
+
+/// Static configuration for the LDP retransmission-budget computation.
+struct ldp_config {
+  /// Packet delivery deadline D (ms). <= 0 disables LDP (fall back to the static per-tx beta).
+  float deadline_ms = 0.0F;
+  /// End-to-end per-packet delivery reliability target in (0, 1).
+  float pkt_beta = 0.99F;
+  /// Latency from packet arrival to the END of its first transmission attempt (ms):
+  /// scheduling/grant access delay on this TDD configuration.
+  float first_tx_ms = 5.0F;
+  /// Interval between successive HARQ (re)transmission opportunities (ms): NACK turnaround plus
+  /// the wait for the next UL slot of the TDD pattern.
+  float retx_interval_ms = 5.0F;
+};
+
+/// Number of transmission opportunities that fit before the deadline: the first attempt completes
+/// at first_tx_ms, each retry costs retx_interval_ms more. Always >= 1 (a packet gets at least one
+/// attempt even if the deadline is already tight) and clamped to a sane ceiling.
+inline unsigned ldp_tx_budget(const ldp_config& cfg)
+{
+  constexpr unsigned max_budget = 64; // beyond this the per-tx requirement is numerically flat
+  if (cfg.deadline_ms <= cfg.first_tx_ms) {
+    return 1;
+  }
+  const float retx = std::max(cfg.retx_interval_ms, 0.1F);
+  const float extra = (cfg.deadline_ms - cfg.first_tx_ms) / retx;
+  const unsigned n = 1U + static_cast<unsigned>(extra); // floor
+  return std::min(n, max_budget);
+}
+
+/// Required per-transmission success probability so that N in-deadline attempts meet the
+/// end-to-end packet reliability: p_req = 1 - (1 - beta_pkt)^(1/N).
+inline float ldp_required_tx_reliability(float pkt_beta, unsigned nof_tx)
+{
+  const float b = std::clamp(pkt_beta, 0.0F, 0.999999F);
+  const unsigned n = std::max(nof_tx, 1U);
+  return 1.0F - std::pow(1.0F - b, 1.0F / static_cast<float>(n));
+}
+
+/// Achieved end-to-end packet reliability for a given per-transmission reliability and budget:
+/// 1 - (1 - p)^N. Inverse of ldp_required_tx_reliability (up to clamping).
+inline float ldp_achieved_pkt_reliability(float tx_reliability, unsigned nof_tx)
+{
+  const float p = std::clamp(tx_reliability, 0.0F, 1.0F);
+  const unsigned n = std::max(nof_tx, 1U);
+  return 1.0F - std::pow(1.0F - p, static_cast<float>(n));
+}
+
+/// The effective per-transmission beta the Cantelli loop should target. With LDP enabled
+/// (deadline > 0) this is p_req(N(D)); otherwise the caller's static per-tx beta passes through.
+/// This is the single composition point between LDP and the IPC power loop.
+inline float ldp_effective_tx_beta(const ldp_config& cfg, float static_beta)
+{
+  if (cfg.deadline_ms <= 0.0F) {
+    return static_beta;
+  }
+  return ldp_required_tx_reliability(cfg.pkt_beta, ldp_tx_budget(cfg));
+}
+
+} // namespace kaiair
+} // namespace ocudu
