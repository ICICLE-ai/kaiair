+  s.ldp.first_tx_ms      = std::max(0.1F, env_float("KAIAIR_PKTR_TX0_MS", 5.0F));
+  s.ldp.retx_interval_ms = std::max(0.1F, env_float("KAIAIR_PKTR_RETX_MS", 5.0F));
   return s;
 }
 
@@ -271,7 +282,9 @@ inline float pktr_ul_sinr_offset_db(const pktr_link_state& ls, const pktr_settin
   if (not pktr_actuate_now(s.actuate) or not ls.has_samples() or ls.std_ni_db() > s.sigma_transient_db) {
     return 0.0F;
   }
-  return ls.std_ni_db() * cantelli_sigma_factor(s.ipc.beta);
+  // LDP composition: with a deadline configured, the cushion targets the per-transmission
+  // reliability p_req(N(D)) needed to deliver the PACKET by its deadline via HARQ retries.
+  return ls.std_ni_db() * cantelli_sigma_factor(ldp_effective_tx_beta(s.ldp, s.ipc.beta));
 }
 
