@@ -0,0 +1,95 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+//
+// KaiAir / PktR, per-link running statistics of the receiver-side interference, derived from
+// per-packet uplink measurements. This is the interference-side state that PktR's power control
+// (the Cantelli transmit-power target) and K-adaptation consume.
+//
+// For a link with receiver R, each measured uplink packet yields a received signal power (RSRP)
+// and an SINR; the receiver-side interference-plus-noise is NI = RSRP - SINR (dB). We maintain an
+// exponentially-weighted moving mean and variance of NI:
+//
+//   mean(t) = c*mean(t-1) + (1-c)*NI(t)
+//   var(t)  = (1-alpha)*( var(t-1) + alpha*(NI(t) - mean(t-1))^2 ),   alpha = 1-c
+//
+// (Finch, "Incremental calculation of weighted mean and variance".) The weight c in [0,1) is the
+// memory of the filter: c -> 1 is stable/slow, c -> 0 is agile. The PRKS/PktR work uses c = 15/16.
+// This mirrors the EWMA interference filter in the PktR papers (I_R(t+1) = c*I_R(t) + (1-c)*I_R(t+1)).
+//
+// Scope: one instance per link (per UE, per direction). Channel-side statistics (predicted gain
+// G-hat and Var[G]) and the beta-quantile of SINR are added in later increments; this class
+// currently tracks the interference side only.
+
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+
+namespace ocudu {
+namespace kaiair {
+
+/// Running interference statistics for one PktR link, fed from per-packet UL measurements.
+class pktr_link_state
+{
+public:
+  /// Default EWMA old-sample weight c (filter memory). 15/16 follows PRKS/PktR.
+  static constexpr float default_ewma_c = 15.0F / 16.0F;
+
+  explicit pktr_link_state(float ewma_c = default_ewma_c) : c(ewma_c) {}
+
+  /// Feed one per-packet UL measurement: the SINR and the received signal power (RSRP), both in dB.
+  /// Updates the running mean and variance of the receiver interference-plus-noise NI = RSRP - SINR.
+  void push_ul_measurement(float sinr_db, float rsrp_db)
+  {
+    const float ni    = rsrp_db - sinr_db; // receiver-side interference + noise (dB)
+    const float alpha = 1.0F - c;          // new-sample weight
+    if (nof_samples_ == 0) {
+      mean_ni_db_ = ni;
+      var_ni_     = 0.0F;
+    } else {
+      const float delta = ni - mean_ni_db_;
+      mean_ni_db_ += alpha * delta;
+      var_ni_ = (1.0F - alpha) * (var_ni_ + alpha * delta * delta);
+    }
+    latest_ni_db_ = ni;
+    ++nof_samples_;
+  }
+
+  /// Whether at least one measurement has been fed.
+  bool has_samples() const { return nof_samples_ > 0; }
+
+  /// Number of measurements fed so far.
+  uint64_t nof_samples() const { return nof_samples_; }
+
+  /// Most recent raw NI sample (dB).
+  float latest_ni_db() const { return latest_ni_db_; }
+
+  /// EWMA mean interference-plus-noise (dB), PktR's I_R.
+  float mean_ni_db() const { return mean_ni_db_; }
+
+  /// EWMA variance of the interference-plus-noise (dB^2), feeds the interference part of the
+  /// Cantelli sigma term, sigma = sqrt(Var[G] + Var[NI]).
+  float var_ni() const { return var_ni_; }
+
+  /// EWMA standard deviation of the interference-plus-noise (dB).
+  float std_ni_db() const { return std::sqrt(var_ni_ > 0.0F ? var_ni_ : 0.0F); }
+
+  /// Clear all accumulated statistics.
+  void reset()
+  {
+    nof_samples_  = 0;
+    mean_ni_db_   = 0.0F;
+    var_ni_       = 0.0F;
+    latest_ni_db_ = 0.0F;
+  }
+
+private:
+  float    c;                  // EWMA old-sample weight (filter memory)
+  uint64_t nof_samples_ = 0;
+  float    mean_ni_db_   = 0.0F;
+  float    var_ni_       = 0.0F;
+  float    latest_ni_db_ = 0.0F;
+};
+
+} // namespace kaiair
+} // namespace ocudu
