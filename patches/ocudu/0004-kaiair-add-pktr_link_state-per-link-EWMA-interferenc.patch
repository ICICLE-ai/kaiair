--- /dev/null
+++ b/tests/unittests/scheduler/kaiair/pktr_link_state_test.cpp
@@ -0,0 +1,105 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#include "lib/scheduler/kaiair/pktr_link_state.h"
+#include <gtest/gtest.h>
+
+using namespace ocudu;
+using namespace ocudu::kaiair;
+
+// A fresh link reports no samples and is in a clean state.
+TEST(pktr_link_state_test, empty_on_construction)
+{
+  pktr_link_state ls;
+  EXPECT_FALSE(ls.has_samples());
+  EXPECT_EQ(ls.nof_samples(), 0U);
+}
+
+// NI is derived as RSRP - SINR; the first sample sets the mean exactly with zero variance.
+TEST(pktr_link_state_test, first_sample_sets_mean_to_ni_with_zero_variance)
+{
+  pktr_link_state ls;
+  ls.push_ul_measurement(/*sinr_db=*/-2.0F, /*rsrp_db=*/-6.0F);
+  EXPECT_TRUE(ls.has_samples());
+  EXPECT_EQ(ls.nof_samples(), 1U);
+  EXPECT_FLOAT_EQ(ls.latest_ni_db(), -4.0F); // -6 - (-2) = -4
+  EXPECT_FLOAT_EQ(ls.mean_ni_db(), -4.0F);
+  EXPECT_FLOAT_EQ(ls.var_ni(), 0.0F);
+}
+
+// A constant NI stream keeps the mean exact and the variance at zero.
+TEST(pktr_link_state_test, constant_stream_keeps_mean_exact_and_zero_variance)
+{
+  pktr_link_state ls;
+  for (int i = 0; i < 200; ++i) {
+    ls.push_ul_measurement(/*sinr_db=*/0.0F, /*rsrp_db=*/-3.0F); // NI = -3 every time
+  }
+  EXPECT_NEAR(ls.mean_ni_db(), -3.0F, 1e-4F);
+  EXPECT_NEAR(ls.var_ni(), 0.0F, 1e-4F);
+  EXPECT_NEAR(ls.std_ni_db(), 0.0F, 1e-4F);
+}
+
+// After a step change in NI, the EWMA mean converges toward the new level.
+TEST(pktr_link_state_test, mean_converges_after_step_change)
+{
+  pktr_link_state ls; // default c = 15/16
+  // Warm up at NI = 0.
+  for (int i = 0; i < 100; ++i) {
+    ls.push_ul_measurement(0.0F, 0.0F); // NI = 0
+  }
+  EXPECT_NEAR(ls.mean_ni_db(), 0.0F, 1e-3F);
+  // Step to NI = 10 and let it settle.
+  for (int i = 0; i < 300; ++i) {
+    ls.push_ul_measurement(0.0F, 10.0F); // NI = 10
+  }
+  EXPECT_NEAR(ls.mean_ni_db(), 10.0F, 0.1F);
+}
+
+// A varying NI stream produces a positive variance; a constant one does not.
+TEST(pktr_link_state_test, variance_positive_for_varying_stream)
+{
+  pktr_link_state ls;
+  // Alternate NI around 0 by +/- 2 dB.
+  for (int i = 0; i < 500; ++i) {
+    const float rsrp = (i % 2 == 0) ? 2.0F : -2.0F;
+    ls.push_ul_measurement(/*sinr_db=*/0.0F, /*rsrp_db=*/rsrp); // NI = +/-2
+  }
+  EXPECT_NEAR(ls.mean_ni_db(), 0.0F, 0.5F);
+  EXPECT_GT(ls.var_ni(), 1.0F);  // spread of +/-2 -> variance on the order of a few dB^2
+  EXPECT_GT(ls.std_ni_db(), 0.5F);
+}
+
+// A more agile filter (smaller c) tracks a step faster than a stable one (larger c).
+// Both must first be warmed up to a common level, since the first sample initializes the mean
+// directly regardless of c.
+TEST(pktr_link_state_test, agile_filter_tracks_faster_than_stable)
+{
+  pktr_link_state agile(/*ewma_c=*/0.5F);
+  pktr_link_state stable(/*ewma_c=*/0.99F);
+  // Warm up both at NI = 0.
+  for (int i = 0; i < 50; ++i) {
+    agile.push_ul_measurement(0.0F, 0.0F);
+    stable.push_ul_measurement(0.0F, 0.0F);
+  }
+  ASSERT_NEAR(agile.mean_ni_db(), 0.0F, 1e-3F);
+  ASSERT_NEAR(stable.mean_ni_db(), 0.0F, 1e-3F);
+  // Step to NI = 10 for a few samples and compare how far each has moved.
+  for (int i = 0; i < 5; ++i) {
+    agile.push_ul_measurement(0.0F, 10.0F);  // NI = 10
+    stable.push_ul_measurement(0.0F, 10.0F); // NI = 10
+  }
+  EXPECT_GT(agile.mean_ni_db(), stable.mean_ni_db());
+  EXPECT_GT(agile.mean_ni_db(), 5.0F);   // agile has moved well toward 10
+  EXPECT_LT(stable.mean_ni_db(), 5.0F);  // stable has barely moved
+}
+
+// reset() clears all state.
+TEST(pktr_link_state_test, reset_clears_state)
+{
+  pktr_link_state ls;
+  ls.push_ul_measurement(5.0F, 1.0F);
+  ASSERT_TRUE(ls.has_samples());
+  ls.reset();
+  EXPECT_FALSE(ls.has_samples());
+  EXPECT_EQ(ls.nof_samples(), 0U);
+}
