 // SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
 // SPDX-License-Identifier: BSD-3-Clause-Open-MPI
 //
-// KaiAir / PktR, LDP (Latest-Deadline / retransmission-budget) core.
+// KaiAir / PktR, LDP (deadline-aware retransmission-budget) core, per LDP-TR.
 //
-// PRK-family URLLC delivers a packet with reliability beta_pkt BEFORE its deadline D. A single
-// transmission attempt only needs reliability p if there is time for retries: with N in-deadline
-// transmission opportunities, P(delivered) = 1 - (1 - p)^N, so the REQUIRED per-attempt
-// reliability is
+// PRK-family URLLC delivers a packet with reliability P (pkt_beta) BEFORE its deadline D. The
+// paper's architecture (LDP-TR §II-B): power control (PktR) holds the PER-TRANSMISSION success
+// probability at a controlled level p, p is an INPUT here, never a derived quantity, and LDP
+// translates the probabilistic requirement into a deterministic reservation:
 //
-//   p_req(N) = 1 - (1 - beta_pkt)^(1/N).
+//   X = ceil( log_{1-p}(1 - P) )   transmission opportunities, all before the deadline D.
 //
-// LDP therefore composes with the Cantelli power loop (pktr_ipc.h): the deadline and the HARQ
-// retransmission cadence fix N; N and beta_pkt fix p_req; p_req becomes the per-transmission beta
-// that sizes the Cantelli cushion sigma*k(p_req). Tight deadlines (small N) demand more power per
-// attempt; loose deadlines let HARQ absorb failures and save power/interference, the exact
-// power-vs-latency trade PktR is built to expose.
+// The scheduler side then (a) reserves/permits up to N(D) in-deadline attempts (budget cap),
+// (b) abandons retransmissions past D (Definition 1: late = dropped), and (c) orders pending
+// retransmissions by urgency. The Cantelli power cushion is sized by the static per-transmission
+// beta ALONE, LDP does not feed back into power control. (An earlier revision inverted the X
+// equation to relax the power target from the deadline budget; that both departed from the paper
+// and destabilized the bench link, and was removed.)
 //
 // This header is pure math (no scheduler state, no I/O), mirroring pktr_ipc.h. Times are in ms.
 
@@ -100,15 +101,18 @@ inline unsigned ldp_capped_max_retxs(const ldp_config& cfg, unsigned configured_
   return std::min(configured_max, budget - 1U);
 }
 
-/// The effective per-transmission beta the Cantelli loop should target. With LDP enabled
-/// (deadline > 0) this is p_req(N(D)); otherwise the caller's static per-tx beta passes through.
-/// This is the single composition point between LDP and the IPC power loop.
-inline float ldp_effective_tx_beta(const ldp_config& cfg, float static_beta)
+/// LDP-TR: required number of transmission opportunities X = ceil(log_{1-p}(1-P)), where p is the
+/// CONTROLLED per-transmission reliability (PktR's beta) and P the end-to-end packet reliability
+/// target. The paper's direction: power control holds p; LDP derives the budget X from (p, P) and
+/// reserves those opportunities before the deadline. Returns >= 1; clamped to a sane ceiling.
+inline unsigned ldp_required_tx_count(float pkt_beta, float per_tx_beta)
 {
-  if (cfg.deadline_ms <= 0.0F) {
-    return static_beta;
-  }
-  return ldp_required_tx_reliability(cfg.pkt_beta, ldp_tx_budget(cfg));
+  const float P = std::clamp(pkt_beta, 0.0F, 0.999999F);
+  const float p = std::clamp(per_tx_beta, 0.000001F, 0.999999F);
+  const float x = std::log(1.0F - P) / std::log(1.0F - p);
+  // Epsilon before the ceil: float log rounding can push an exact-integer boundary (e.g.
+  // log_0.1(0.001) = 3) infinitesimally above it, which would over-reserve one opportunity.
+  return static_cast<unsigned>(std::clamp(std::ceil(x - 1e-4F), 1.0F, 64.0F));
 }
 
 } // namespace kaiair
