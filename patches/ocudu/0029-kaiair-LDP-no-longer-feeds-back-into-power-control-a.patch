     return 0.0F;
   }
-  // Full Cantelli sigma = sqrt(Var[S] + Var[NI]), the std of (S - I) per pktR_CR Eq. (2) / thesis
+  // Full Cantelli sigma = sqrt(Var[S] + Var[NI]), the std of (S - I) per pktR_CR Eq. (2) /
   // dissertation Eq. (4.46), NOT the interference std alone.
-  // LDP composition: with a deadline configured, the cushion targets the per-transmission
-  // reliability p_req(N(D)) needed to deliver the PACKET by its deadline via HARQ retries.
-  // Floored at min_cushion_db: the LDP-relaxed k(p_req) may not push the operating point into the
-  // bench's bistable-collapse zone (see min_cushion_db), LDP still saves the difference to the
-  // full k(beta) cushion, just not past the link-survival margin.
-  const float cushion = ls.sigma_sinr_db() * cantelli_sigma_factor(ldp_effective_tx_beta(s.ldp, s.ipc.beta));
+  // The cushion is sized by the STATIC per-transmission beta (LDP-TR: power control holds the
+  // per-tx reliability p; LDP derives the retx budget FROM p and never feeds back into power).
+  // Floored at min_cushion_db as a bench safety margin (bistable-collapse zone).
+  const float cushion = ls.sigma_sinr_db() * cantelli_sigma_factor(s.ipc.beta);
   return std::max(cushion, s.min_cushion_db);
 }
 
