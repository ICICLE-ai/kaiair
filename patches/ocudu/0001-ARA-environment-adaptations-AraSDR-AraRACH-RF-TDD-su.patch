@@ -183,13 +187,38 @@ downlink_processor_baseband_impl::process(baseband_gateway_timestamp timestamp)
       fill_zeros(result.buffer->get_writer(), result.metadata);
       result.metadata.is_empty = true;
     }
+  } else {
+    // Prepare result metadata.
+    result = {.metadata = {.ts = timestamp, .is_empty = false}, .buffer = std::move(pdxch_baseband_result.buffer)};
+  }
+
+  // Apply TDD burst gating, if configured. For non-DL slots we mark the buffer empty so the radio drops the burst;
+  // for partial DL slots we set tx_end so the radio cuts the burst at the last active DL symbol.
+  if (tdd_config && !result.metadata.is_empty) {
+    const ofdm_symbol_range active_dl_symbols = get_active_tdd_dl_symbols(*tdd_config, i_slot, cp);
 
-    return result;
+    if (active_dl_symbols.length() == 0) {
+      // Slot has no active DL symbols (UL or special slot), drop the burst.
+      result.metadata.is_empty = true;
+    } else if (active_dl_symbols.length() < nof_symbols_per_slot) {
+      // Partial DL slot, compute sample offset of the first symbol after the last active DL symbol, within the slot.
+      const unsigned dl_end_sample_in_slot =
+          std::accumulate(symbol_sizes_slot.begin(), symbol_sizes_slot.begin() + active_dl_symbols.stop(), 0U);
+
+      if (dl_end_sample_in_slot <= i_sample_slot) {
+        // This buffer starts after the last active DL symbol, nothing to transmit.
+        result.metadata.is_empty = true;
+      } else {
+        const unsigned dl_end_in_buffer = dl_end_sample_in_slot - i_sample_slot;
+        // Only set tx_end if the DL burst genuinely ends inside this buffer.
+        if (dl_end_in_buffer < result.buffer->get_nof_samples()) {
+          result.metadata.tx_end = dl_end_in_buffer;
+        }
+      }
+    }
   }
 
-  // Prepare result metadata.
-  return processing_result{.metadata = {.ts = timestamp, .is_empty = false},
-                           .buffer   = std::move(pdxch_baseband_result.buffer)};
