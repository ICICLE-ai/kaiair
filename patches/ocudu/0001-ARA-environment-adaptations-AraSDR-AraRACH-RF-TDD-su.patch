@@ -384,3 +384,111 @@ INSTANTIATE_TEST_SUITE_P(
                        ::testing::Values(std::make_tuple(subcarrier_spacing::kHz15, cyclic_prefix::NORMAL),
                                          std::make_tuple(subcarrier_spacing::kHz30, cyclic_prefix::NORMAL),
                                          std::make_tuple(subcarrier_spacing::kHz60, cyclic_prefix::EXTENDED))));
+
+// Verifies that the TDD-aware burst gating in downlink_processor_baseband_impl produces the right metadata
+// (is_empty / tx_end) for full-DL, partial-DL (special) and UL slots, walking one full TDD period at slot boundaries.
+TEST(LowerPhyDownlinkProcessorTddGating, FullDlSpecialAndUlSlots)
+{
+  static constexpr subcarrier_spacing scs          = subcarrier_spacing::kHz30;
+  static constexpr cyclic_prefix      cp           = cyclic_prefix::NORMAL;
+  const sampling_rate                 srate        = sampling_rate::from_MHz(7.68);
+  static constexpr unsigned           nof_tx_ports = 1;
+
+  // DDDDDDDSUU: 10 slots/period, 7 full DL, 1 special (6 DL symbols), 2 full UL, no UL symbols in the DL→UL boundary.
+  tdd_ul_dl_config_common tdd{.ref_scs  = scs,
+                              .pattern1 = {.dl_ul_tx_period_nof_slots = 10,
+                                           .nof_dl_slots              = 7,
+                                           .nof_dl_symbols            = 6,
+                                           .nof_ul_slots              = 2,
+                                           .nof_ul_symbols            = 0}};
+
+  manual_task_worker                                    modulation_executor(MAX_NSYMB_PER_SLOT * MAX_PORTS);
+  std::shared_ptr<pdxch_processor_factory_spy>          pdxch_proc_factory = std::make_shared<pdxch_processor_factory_spy>();
+  std::shared_ptr<lower_phy_downlink_processor_factory> dl_proc_factory =
+      create_downlink_processor_factory_sw(pdxch_proc_factory);
+
+  downlink_processor_configuration config = {.sector_id           = 0,
+                                             .scs                 = scs,
+                                             .cp                  = cp,
+                                             .rate                = srate,
+                                             .bandwidth_prb       = MAX_NOF_PRBS,
+                                             .center_frequency_Hz = 3.5e6,
+                                             .nof_tx_ports        = nof_tx_ports,
+                                             .tdd_config          = tdd};
+
+  std::unique_ptr<lower_phy_downlink_processor> dl_processor = dl_proc_factory->create(config, modulation_executor);
+  ASSERT_NE(dl_processor, nullptr);
+
+  downlink_processor_notifier_spy downlink_proc_notifier_spy;
+  pdxch_processor_notifier_spy    pdxch_proc_notifier_spy;
+  dl_processor->connect(downlink_proc_notifier_spy, pdxch_proc_notifier_spy);
+  downlink_processor_baseband& dl_proc_baseband = dl_processor->get_baseband();
+
+  // Walk one full TDD period starting at slot 0 (timestamp 0 ⇒ aligned to a slot boundary). The PDxCH spy uses a
+  // single-buffer pool, so each iteration must release its buffer before the next process() call.
+  baseband_gateway_timestamp timestamp = 0;
+  for (unsigned i_slot = 0; i_slot != 10; ++i_slot) {
+    auto r = dl_proc_baseband.process(timestamp);
+    ASSERT_TRUE(r.buffer) << "slot " << i_slot;
+    unsigned nof_samples = r.buffer->get_nof_samples();
+
+    if (i_slot <= 6) {
+      // Full DL: nothing gated.
+      EXPECT_FALSE(r.metadata.is_empty) << "slot " << i_slot;
+      EXPECT_FALSE(r.metadata.tx_end.has_value()) << "slot " << i_slot;
+    } else if (i_slot == 7) {
+      // Special slot (6 DL symbols): non-empty with tx_end set strictly inside the buffer.
+      EXPECT_FALSE(r.metadata.is_empty);
+      ASSERT_TRUE(r.metadata.tx_end.has_value());
+      EXPECT_GT(*r.metadata.tx_end, 0U);
+      EXPECT_LT(*r.metadata.tx_end, nof_samples);
+    } else {
+      // Slots 8..9 are full UL: burst dropped.
+      EXPECT_TRUE(r.metadata.is_empty) << "slot " << i_slot;
+    }
+
+    timestamp += nof_samples;
+    r.buffer = nullptr;
+  }
+}
+
+// Verifies that without a TDD configuration the gating path is inert: every slot stays non-empty with no tx_end.
+TEST(LowerPhyDownlinkProcessorTddGating, FddPathUnaffected)
+{
+  static constexpr subcarrier_spacing scs          = subcarrier_spacing::kHz30;
+  static constexpr cyclic_prefix      cp           = cyclic_prefix::NORMAL;
+  const sampling_rate                 srate        = sampling_rate::from_MHz(7.68);
+  static constexpr unsigned           nof_tx_ports = 1;
+
+  manual_task_worker                                    modulation_executor(MAX_NSYMB_PER_SLOT * MAX_PORTS);
+  std::shared_ptr<pdxch_processor_factory_spy>          pdxch_proc_factory = std::make_shared<pdxch_processor_factory_spy>();
+  std::shared_ptr<lower_phy_downlink_processor_factory> dl_proc_factory =
+      create_downlink_processor_factory_sw(pdxch_proc_factory);
+
+  // No tdd_config: FDD path.
+  downlink_processor_configuration config = {.sector_id           = 0,
+                                             .scs                 = scs,
+                                             .cp                  = cp,
+                                             .rate                = srate,
+                                             .bandwidth_prb       = MAX_NOF_PRBS,
+                                             .center_frequency_Hz = 3.5e6,
+                                             .nof_tx_ports        = nof_tx_ports};
+
+  std::unique_ptr<lower_phy_downlink_processor> dl_processor = dl_proc_factory->create(config, modulation_executor);
+  ASSERT_NE(dl_processor, nullptr);
+
+  downlink_processor_notifier_spy downlink_proc_notifier_spy;
+  pdxch_processor_notifier_spy    pdxch_proc_notifier_spy;
+  dl_processor->connect(downlink_proc_notifier_spy, pdxch_proc_notifier_spy);
+  downlink_processor_baseband& dl_proc_baseband = dl_processor->get_baseband();
+
+  baseband_gateway_timestamp timestamp = 0;
+  for (unsigned i_slot = 0; i_slot != 10; ++i_slot) {
+    auto r = dl_proc_baseband.process(timestamp);
+    ASSERT_TRUE(r.buffer) << "slot " << i_slot;
+    EXPECT_FALSE(r.metadata.is_empty) << "slot " << i_slot;
+    EXPECT_FALSE(r.metadata.tx_end.has_value()) << "slot " << i_slot;
+    timestamp += r.buffer->get_nof_samples();
+    r.buffer = nullptr;
+  }
+}
