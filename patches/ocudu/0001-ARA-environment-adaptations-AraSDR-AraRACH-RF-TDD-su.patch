diff --git a/lib/radio/uhd/radio_uhd_device.h b/lib/radio/uhd/radio_uhd_device.h
index 551ac44360..c33f7442af 100644
--- a/lib/radio/uhd/radio_uhd_device.h
+++ b/lib/radio/uhd/radio_uhd_device.h
@@ -138,7 +138,25 @@ public:
 
     fmt::print("Making USRP object with args '{}'\n", device_addr.to_string());
 
-    return safe_execution([this, &device_addr]() { usrp = uhd::usrp::multi_usrp::make(device_addr); });
+    return safe_execution([this, &device_addr]() {
+      usrp = uhd::usrp::multi_usrp::make(device_addr);
+      // Configure the FP0 GPIO bank for TDD RF front-end control on USRP types that expose it.
+      // The ATR (Automatic Transmit/Receive) controller drives pins 0..6 according to the radio state, so that an
+      // external RF switch / PA can be gated in sync with the TDD pattern. Pins 7..11 stay under manual control.
+      if (type == radio_uhd_device_type::types::X3x0 || type == radio_uhd_device_type::types::X410 ||
+          type == radio_uhd_device_type::types::N3x0 || type == radio_uhd_device_type::types::N32x) {
+        fmt::print("Setting FP0 GPIO for TDD RF front-end on {}.\n", type.to_string());
+        // Lower 7 bits driven by ATR; upper bits remain manual.
+        usrp->set_gpio_attr("FP0", "CTRL", 0x7f, 0x7f);
+        // DDR = output for the same 7 bits.
+        usrp->set_gpio_attr("FP0", "DDR", 0x7f, 0x7f);
+        // Drive the lower 7 pins high whenever the radio is transmitting, covers both TX-only (ATR_TX, the active
+        // state during a discontinuous DL burst) and full-duplex (ATR_XX, the steady state in continuous TX). Without
+        // ATR_TX the external PA stays disabled across DL bursts in discontinuous mode and nothing radiates.
+        usrp->set_gpio_attr("FP0", "ATR_TX", 0x7f, 0x7f);
+        usrp->set_gpio_attr("FP0", "ATR_XX", 0x7f, 0x7f);
+      }
+    });
   }
 
   bool is_connection_valid()
