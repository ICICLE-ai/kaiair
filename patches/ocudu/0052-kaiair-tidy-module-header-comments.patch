diff --git a/lib/scheduler/kaiair/pktr_signal_map.h b/lib/scheduler/kaiair/pktr_signal_map.h
index f235d68ceb..d4cd80b659 100644
--- a/lib/scheduler/kaiair/pktr_signal_map.h
+++ b/lib/scheduler/kaiair/pktr_signal_map.h
@@ -1,26 +1,14 @@
 // SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
 // SPDX-License-Identifier: BSD-3-Clause-Open-MPI
 //
-// KaiAir / PktR, the signal (gain) map: the "who-hears-whom" table the GRK exclusion-region
-// computation runs on. It stores, per ordered pair (transmitter, receiver), the path gain
-//
-//   G(tx, rx) = (received power of tx's reference signal) - (tx's transmit power)   [dB],
-//
-// smoothed with an EWMA because path gains vary slowly. Crucially, gains come from *reference
-// signals* (each tied to a known transmitter at a known power), never from the aggregate data
-// SINR, that is what makes them per-link and separable:
-//   - in-cell UL  G(UE->gNB): PUSCH/SRS RSRP + UE TX power (from PHR),
-//   - in-cell DL  G(gNB->UE): SSB/CSI-RSRP reported by the UE,
-//   - cross-cell  G(UE_u->gNB_B): neighbour-cell SSB-RSRP via TDD reciprocity.
-//
-// The map exposes candidate interferer lists (grk_interferer rows) for a receiver, which feed
-// pktr_grk::size_exclusion_region directly. Per-node transmit power and activity factor (from
-// scheduling statistics) are held alongside the gains so a candidate row is fully populated.
-//
-// Units note: rx_power and tx_power must be in consistent units per call. A fixed dBFS<->dBm
-// calibration offset on the RX chain cancels in the GRK gain *ratio* K = G(T,R)/G(C,R), so the
-// exclusion region is correct even with uncalibrated (relative) gains; only absolute-dBm claims
-// would need the offset.
+// KaiAir/PktR signal map, the who-hears-whom gain table the GRK computation runs on. It stores
+// the path gain G(tx, rx) per ordered transmitter-receiver pair, smoothed with an EWMA. Gains
+// come from reference signals tied to a known transmitter at a known power, never from the
+// aggregate data SINR. In-cell UL gains come from PUSCH/SRS RSRP plus the UE transmit power
+// (PHR), in-cell DL gains from the UE-reported SSB/CSI RSRP, and cross-cell gains from
+// neighbour-cell SSB RSRP via TDD reciprocity. The map hands fully populated candidate
+// interferer rows to size_exclusion_region. A fixed dBFS to dBm calibration offset on the RX
+// chain cancels in the gain ratio, so relative gains are enough for a correct exclusion region.
 
 #pragma once
 
diff --git a/lib/scheduler/kaiair/pktr_slot_gate.h b/lib/scheduler/kaiair/pktr_slot_gate.h
index 6bfa859c25..90e1852139 100644
--- a/lib/scheduler/kaiair/pktr_slot_gate.h
+++ b/lib/scheduler/kaiair/pktr_slot_gate.h
@@ -1,20 +1,17 @@
 // SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
 // SPDX-License-Identifier: BSD-3-Clause-Open-MPI
 //
-// KaiAir / PktR, ONAMA slot gate (PRKS-TWC §III-D, pktR §V; plan step B5).
+// KaiAir/PktR ONAMA slot gate.
 //
-// Per slot, every link gets a pseudo-random priority from a deterministic hash of (slot, link id)
-// that EVERY cell computes identically (no message needed per slot). A link is ACTIVE in a slot
-// iff it outranks every link in its conflict set for that slot; otherwise it is MUTED. One winner
-// per conflicting pair per slot => no mutual deferral deadlock; randomization per slot => no
-// starvation; expected share ~ 1/(|M_i|+1) for a full clique.
+// Every link gets a pseudo-random priority per slot from a deterministic hash of the slot index
+// and the link id, computed identically on every cell with no per-slot messages. A link is
+// active in a slot when it outranks its whole conflict set, otherwise it is muted. One winner
+// per conflicting pair avoids mutual deferral, the per-slot randomization avoids starvation,
+// and the expected share in a full clique is about one over the clique size.
 //
-// Masks are meant to be precomputed M slots ahead on a background executor (pipelining, as in
-// PktR's OAI prototype) and looked up in the slot path. This header is the pure function core:
-// given the conflict sets, answer "is link L active in slot s?". Gate policy:
-//   off     : never mute (stock scheduling)
-//   observe : compute, count would-be mutings, never mute
-//   enforce : mute losing links (the slice scheduler skips them)
+// Masks are precomputed over a look-ahead window and looked up in the slot path. The gate
+// policy has three modes. Off never mutes, observe computes and counts would-be mutings without
+// muting, enforce actually mutes losing links.
 
 #pragma once
 
