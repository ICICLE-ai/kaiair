+
+// Helpers to build a link state with a known sigma regime.
+namespace {
+
+pktr_settings actuating_settings(float beta = 0.9F, float sigma_transient_db = 6.0F)
+{
+  pktr_settings s;
+  s.actuate            = true;
+  s.ipc.beta           = beta;
+  s.sigma_transient_db = sigma_transient_db;
+  return s;
+}
+
+// A link with a small, steady sigma (jitter +/-1 dB).
+pktr_link_state steady_link()
+{
+  pktr_link_state ls;
+  for (int i = 0; i < 200; ++i) {
+    ls.push_ul_measurement(/*sinr_db=*/0.0F, /*rsrp_db=*/(i % 2 == 0) ? 1.0F : -1.0F); // NI = +/-1
+  }
+  return ls;
+}
+
+} // namespace
+
+// Actuation off => no offset, regardless of the link statistics.
+TEST(pktr_runtime_config_test, offset_zero_when_actuation_disabled)
+{
+  pktr_settings s = actuating_settings();
+  s.actuate       = false;
+  EXPECT_FLOAT_EQ(pktr_ul_sinr_offset_db(steady_link(), s), 0.0F);
+}
+
+// No samples yet => no offset (don't act on an empty estimator).
+TEST(pktr_runtime_config_test, offset_zero_without_samples)
+{
+  pktr_link_state empty;
+  EXPECT_FLOAT_EQ(pktr_ul_sinr_offset_db(empty, actuating_settings()), 0.0F);
+}
+
+// Steady sigma => offset is exactly the Cantelli cushion sigma*k(beta).
+TEST(pktr_runtime_config_test, offset_is_cantelli_cushion_when_steady)
+{
+  const pktr_settings s  = actuating_settings(/*beta=*/0.9F);
+  pktr_link_state     ls = steady_link();
+  ASSERT_LE(ls.std_ni_db(), s.sigma_transient_db);
+  const float expected = ls.std_ni_db() * cantelli_sigma_factor(s.ipc.beta);
+  EXPECT_NEAR(pktr_ul_sinr_offset_db(ls, s), expected, 1e-4F);
+  EXPECT_GT(pktr_ul_sinr_offset_db(ls, s), 0.0F);
+}
+
+// sigma in the regime-transition zone => offset suppressed (the safety guard).
+TEST(pktr_runtime_config_test, offset_suppressed_on_sigma_spike)
+{
+  pktr_link_state ls;
+  ls.push_ul_measurement(0.0F, 0.0F);   // NI = 0
+  ls.push_ul_measurement(0.0F, 100.0F); // NI = 100 -> huge transient sigma
+  ASSERT_GT(ls.std_ni_db(), 6.0F);
+  EXPECT_FLOAT_EQ(pktr_ul_sinr_offset_db(ls, actuating_settings(0.9F, 6.0F)), 0.0F);
+}
