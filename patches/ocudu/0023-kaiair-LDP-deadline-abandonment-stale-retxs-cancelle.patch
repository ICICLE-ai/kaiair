@@ -74,6 +74,9 @@ struct base_harq_process : public intrusive_double_linked_list_element<>,
   uint8_t nof_retxs = 0;
   /// Maximum number of retransmission before Transport Block is reset.
   uint8_t max_nof_harq_retxs = 0;
+  /// KaiAir/PktR LDP: slot of the FIRST transmission of the current TB (slot_tx moves with every
