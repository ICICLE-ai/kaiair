   h.slot_ack           = sl_ack;
+  h.kaiair_slot_first_tx = sl_tx; // KaiAir/PktR LDP: packet age reference (new TB starts here)
   h.nof_retxs          = 0;
   h.ndi                = !h.ndi;
   h.max_nof_harq_retxs = max_nof_harq_retxs;
diff --git a/lib/scheduler/cell/cell_harq_manager.h b/lib/scheduler/cell/cell_harq_manager.h
