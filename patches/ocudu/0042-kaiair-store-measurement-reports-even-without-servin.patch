From a1e8c7345fc82988dedecff20992158f3be324e9 Mon Sep 17 00:00:00 2001
From: Taimoor Ul Islam <tislam@iastate.edu>
Date: Sat, 22 Aug 2026 16:10:24 -0500
Subject: [PATCH 42/52] kaiair: store measurement reports even without serving
 RSRP; rate-limited map log; store counters in JSON

---
 .../consumers/kaiair_pktr_metrics_view.cpp    |  3 +++
 .../cell_meas_manager_impl.cpp                | 23 +++++++++++++++++--
 2 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/apps/units/flexible_o_du/o_du_high/du_high/metrics/consumers/kaiair_pktr_metrics_view.cpp b/apps/units/flexible_o_du/o_du_high/du_high/metrics/consumers/kaiair_pktr_metrics_view.cpp
index d12fca1d17..a2754ea6bd 100644
--- a/apps/units/flexible_o_du/o_du_high/du_high/metrics/consumers/kaiair_pktr_metrics_view.cpp
+++ b/apps/units/flexible_o_du/o_du_high/du_high/metrics/consumers/kaiair_pktr_metrics_view.cpp
@@ -87,6 +87,9 @@ void emit_pktr_metrics_json(const scheduler_cell_metrics& cell)
   constexpr unsigned kaiair_mask_window = 4000; // ~2 s at 30 kHz: > one tick + pipelining margin
   const kaiair::er_tick_result er =
       kaiair::er_controller_tick(static_cast<uint16_t>(cell.pci), er_in, cell.slot.count(), kaiair_mask_window);
+  j += fmt::format(R"(,"store_reports":{},"store_ues":{})",
+                   kaiair::neighbor_store().nof_reports(),
+                   kaiair::neighbor_store().known_ues().size());
   j += fmt::format(R"(,"ssb_dbm":{:.1f},"er_gate":"{}","peer_cells":{},"peer_links":{},"gate_muted":{},"gate_allowed":{})",
                    s.ssb_pwr_dbm,
                    er.mode == kaiair::er_gate_mode::enforce ? "enforce"
diff --git a/lib/cu_cp/cell_meas_manager/cell_meas_manager_impl.cpp b/lib/cu_cp/cell_meas_manager/cell_meas_manager_impl.cpp
index 56e097d766..80ccaaf778 100644
--- a/lib/cu_cp/cell_meas_manager/cell_meas_manager_impl.cpp
+++ b/lib/cu_cp/cell_meas_manager/cell_meas_manager_impl.cpp
@@ -3,6 +3,7 @@
 // Portions of this file may implement 3GPP specifications, which may be subject to additional licensing requirements.
 
 #include "cell_meas_manager_impl.h"
+#include <cmath>
 #include <algorithm>
 #include "ocudu/kaiair/pktr_neighbor_store.h" // KaiAir/PktR: multi-cell signal-map feed
 #include "cell_meas_manager_helpers.h"
@@ -359,14 +360,32 @@ void cell_meas_manager::report_measurement(cu_cp_ue_index_t ue_index, const rrc_
         }
       }
     }
-    if (kaiair_serv.has_value()) {
+    {
       const auto&    kaiair_cell = cfg.cells.at(meas_ctxt.nci).serving_cell_cfg;
       const uint16_t kaiair_pci  = kaiair_cell.pci.has_value() ? static_cast<uint16_t>(kaiair_cell.pci.value()) : 0xffff;
+      // Serving RSRP may be absent in an event-triggered report (OAI nrUE); store NaN and let the
+      // consumer fall back (the DU knows the serving signal from its own feedback chain).
+      const float kaiair_serv_dbm =
+          kaiair_serv.has_value() ? kaiair::pktr_neighbor_store::rsrp_index_to_dbm(kaiair_serv.value()) : NAN;
       kaiair::neighbor_store().report_ue_measurement(static_cast<uint16_t>(kaiair_ue->get_c_rnti()),
                                                      kaiair_pci,
-                                                     kaiair::pktr_neighbor_store::rsrp_index_to_dbm(kaiair_serv.value()),
+                                                     kaiair_serv_dbm,
                                                      kaiair_nbrs,
                                                      kaiair::wall_now_s());
+      static unsigned kaiair_report_count = 0;
+      if ((kaiair_report_count++ % 20) == 0) {
+        std::string nb;
+        for (const auto& [pci, v] : kaiair_nbrs) {
+          nb += fmt::format(" pci{}={:.0f}dBm", pci, v);
+        }
+        logger.info("[KaiAir map] ue={} rnti={:#x} serving pci{} RSRP={} neighbors:{} (report #{})",
+                    ue_index,
+                    kaiair_ue->get_c_rnti(),
+                    kaiair_pci,
+                    kaiair_serv.has_value() ? fmt::format("{:.0f}dBm", kaiair_serv_dbm) : std::string("n/a"),
+                    nb.empty() ? std::string(" none") : nb,
+                    kaiair_report_count);
+      }
     }
   }
 
