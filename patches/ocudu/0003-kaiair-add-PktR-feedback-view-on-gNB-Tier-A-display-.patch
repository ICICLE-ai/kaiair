@@ -0,0 +1,25 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+//
+// KaiAir / PktR, gNB-side view of the per-UE feedback the scheduler already collects, annotated
+// with how PktR consumes each quantity. Tier-A (gNB-only, no UE/PHY changes): it derives the
+// PktR inputs from standard metrics, UE-reported CQI (-> DL SINR working point) and DL HARQ
+// (-> reliability/BLER), and gNB-measured UL PUSCH SINR & RSRP (-> receiver interference+noise
+// NI = RSRP - SINR, the Cantelli power-control input). Display only; computes nothing the
+// scheduler acts on yet.
+
+#pragma once
+
+#include "ocudu/scheduler/scheduler_metrics.h"
+
+namespace ocudu {
+namespace kaiair {
+
+/// Whether the KaiAir PktR feedback view is enabled (env var KAIAIR_PKTR_METRICS=1).
+bool pktr_metrics_enabled();
+
+/// Print, for each UE in the cell, the PktR-relevant feedback and its PktR usage.
+void print_pktr_feedback(const scheduler_cell_metrics& cell);
+
+} // namespace kaiair
+} // namespace ocudu
diff --git a/apps/units/flexible_o_du/o_du_high/du_high/metrics/consumers/scheduler_metrics_consumers.cpp b/apps/units/flexible_o_du/o_du_high/du_high/metrics/consumers/scheduler_metrics_consumers.cpp
index f20b2f0630..a4bde22fb7 100644
--- a/apps/units/flexible_o_du/o_du_high/du_high/metrics/consumers/scheduler_metrics_consumers.cpp
+++ b/apps/units/flexible_o_du/o_du_high/du_high/metrics/consumers/scheduler_metrics_consumers.cpp
@@ -3,6 +3,7 @@
 // Portions of this file may implement 3GPP specifications, which may be subject to additional licensing requirements.
 
 #include "scheduler_metrics_consumers.h"
+#include "kaiair_pktr_metrics_view.h" // KaiAir/PktR feedback view
 #include "ocudu/support/engineering_notation.h"
 #include "ocudu/support/format/custom_formattable.h"
 #include "ocudu/support/format/fmt_to_c_str.h"
@@ -141,6 +142,11 @@ void scheduler_cell_metrics_consumer_stdout::handle_metric(const std::optional<s
 
       fmt::print("\n");
     }
+
+    // KaiAir/PktR: append the per-UE PktR feedback view for this cell (env-gated, display only).
+    if (kaiair::pktr_metrics_enabled()) {
+      kaiair::print_pktr_feedback(cell);
+    }
   }
 }
 
