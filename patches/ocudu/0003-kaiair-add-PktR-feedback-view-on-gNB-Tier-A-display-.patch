--- /dev/null
+++ b/apps/units/flexible_o_du/o_du_high/du_high/metrics/consumers/kaiair_pktr_metrics_view.cpp
@@ -0,0 +1,85 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#include "kaiair_pktr_metrics_view.h"
+#include "ocudu/ran/rnti.h"
+#include "fmt/format.h"
+#include <cmath>
+#include <cstdlib>
+#include <string_view>
+
+using namespace ocudu;
+
+bool kaiair::pktr_metrics_enabled()
+{
+  // Evaluated once; enable with KAIAIR_PKTR_METRICS=1 in the gNB environment.
+  static const bool enabled = []() {
+    const char* e = std::getenv("KAIAIR_PKTR_METRICS");
+    return e != nullptr && std::string_view(e) == "1";
+  }();
+  return enabled;
+}
+
+namespace {
+
+/// Coarse Tier-A estimate of the DL SINR working point from the UE-reported CQI (CQI table 1).
+/// This is for the feedback view only; the precise CQI<->SINR/MCS/BLER mapping is future work.
+float cqi_to_sinr_db_estimate(float cqi)
+{
+  return 1.9F * cqi - 5.0F;
+}
+
+} // namespace
+
+void kaiair::print_pktr_feedback(const scheduler_cell_metrics& cell)
+{
+  bool printed_header = false;
+
+  for (const scheduler_ue_metrics& ue : cell.ue_metrics) {
+    const bool     has_cqi  = ue.cqi_stats.get_nof_observations() > 0;
+    const bool     has_snr  = std::isfinite(ue.pusch_snr_db) && ue.pusch_snr_db != 0.0F;
+    const bool     has_rsrp = std::isfinite(ue.pusch_rsrp_db);
+    const unsigned dl_tot   = ue.dl_nof_ok + ue.dl_nof_nok;
+
+    // Only report UEs that have produced some feedback this interval.
+    if (!has_cqi && !has_snr && dl_tot == 0) {
+      continue;
+    }
+
+    if (!printed_header) {
+      fmt::print("\n[KaiAir/PktR] per-UE feedback (pci={}), what the UE reports to the gNB, and how PktR uses it:\n",
+                 cell.pci);
+      printed_header = true;
+    }
+
+    fmt::print("  rnti={:#06x}\n", to_value(ue.rnti));
+
+    // ---- UE-reported, downlink ----
+    if (has_cqi) {
+      const float cqi = ue.cqi_stats.get_mean();
+      fmt::print("    UE-reported DL : CQI={:.1f}  ->  est DL SINR ~ {:.1f} dB   (Tier-A working point)\n",
+                 cqi,
+                 cqi_to_sinr_db_estimate(cqi));
+    }
+    if (dl_tot > 0) {
+      fmt::print("    DL reliability : HARQ ok/nok = {}/{}  ->  {:.2f}% delivered (1-BLER)   [PktR target beta]\n",
+                 ue.dl_nof_ok,
+                 ue.dl_nof_nok,
+                 100.0 * static_cast<double>(ue.dl_nof_ok) / static_cast<double>(dl_tot));
+    }
+
+    // ---- gNB-measured, uplink -> receiver interference (the Cantelli input) ----
+    if (has_snr && has_rsrp) {
+      const float ni = ue.pusch_rsrp_db - ue.pusch_snr_db; // RSRP - SINR = interference + noise (dB)
+      fmt::print("    gNB-measured UL: PUSCH SINR={:.1f} dB, RSRP={:.1f} dBFS  ->  interference+noise  NI = RSRP-SINR = "
+                 "{:.1f} dB\n",
+                 ue.pusch_snr_db,
+                 ue.pusch_rsrp_db,
+                 ni);
+      fmt::print("    => PktR        : NI feeds the Cantelli power target  P_T = G + NI + gamma + sigma*sqrt(beta/(1-"
+                 "beta));  NI error drives K-adaptation\n");
+    } else if (has_snr) {
+      fmt::print("    gNB-measured UL: PUSCH SINR={:.1f} dB  (RSRP n/a this interval)\n", ue.pusch_snr_db);
+    }
+  }
+}
