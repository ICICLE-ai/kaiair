+/// KaiAir LDP: live-effective LDP config, the ctrl-file ldp_deadline_ms key (GUI LDP toggle,
+/// 0 = off, NO restart needed) overrides the env deadline when present; timing/beta fields from env.
+inline ldp_config pktr_ldp_now()
+{
+  ldp_config cfg = pktr_runtime().ldp;
+  detail::refresh_live_controls();
+  detail::live_controls_t& L = detail::live_controls();
+  if (L.active.load(std::memory_order_relaxed)) {
+    const float v = L.ldp_deadline_ms.load(std::memory_order_relaxed);
+    if (not std::isnan(v)) {
+      cfg.deadline_ms = v;
+    }
+  }
+  return cfg;
+}
+
 /// KaiAir/PktR DL-SINR: effective DL SINR-target margin gamma_DL (dB), the live GUI value when the overlay
 /// carries a dl_sinr_target_db key, else the env value (KAIAIR_PKTR_DL_GAMMA_DB).
