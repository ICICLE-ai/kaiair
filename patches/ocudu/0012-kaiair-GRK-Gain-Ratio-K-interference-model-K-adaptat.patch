diff --git a/tests/unittests/scheduler/kaiair/pktr_grk_test.cpp b/tests/unittests/scheduler/kaiair/pktr_grk_test.cpp
new file mode 100644
index 0000000000..5cedcb73bf
--- /dev/null
+++ b/tests/unittests/scheduler/kaiair/pktr_grk_test.cpp
@@ -0,0 +1,111 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#include "lib/scheduler/kaiair/pktr_grk.h"
+#include <gtest/gtest.h>
+
+using namespace ocudu;
+using namespace ocudu::kaiair;
+
+// dB <-> linear round-trips and the known anchor points.
+TEST(pktr_grk_test, db_lin_helpers)
+{
+  EXPECT_NEAR(db_to_lin(0.0F), 1.0F, 1e-6F);
+  EXPECT_NEAR(db_to_lin(10.0F), 10.0F, 1e-4F);
+  EXPECT_NEAR(db_to_lin(-10.0F), 0.1F, 1e-6F);
+  EXPECT_NEAR(lin_to_db(1.0F), 0.0F, 1e-4F);
+  EXPECT_NEAR(lin_to_db(100.0F), 20.0F, 1e-3F);
+  EXPECT_NEAR(lin_to_db(db_to_lin(-73.5F)), -73.5F, 1e-2F); // round-trip
+}
+
+// PRK membership: C is in the ER iff G(C,R) >= G(T,R) - K (dB).
+TEST(pktr_grk_test, membership_threshold)
+{
+  const float g_tr = -60.0F, k = 10.0F; // threshold gain = -70 dB
+  EXPECT_TRUE(in_exclusion_region(-65.0F, g_tr, k));  // stronger than threshold -> in ER
+  EXPECT_TRUE(in_exclusion_region(-70.0F, g_tr, k));  // exactly at threshold -> in ER
+  EXPECT_FALSE(in_exclusion_region(-71.0F, g_tr, k)); // weaker than threshold -> out
+  // Larger K lowers the threshold -> more nodes fall inside.
+  EXPECT_TRUE(in_exclusion_region(-71.0F, g_tr, /*k=*/20.0F));
+}
+
+// Delta_I_R sign convention.
+TEST(pktr_grk_test, interference_error_sign)
+{
+  EXPECT_LT(interference_error_db(/*e_max=*/-80.0F, /*i_cur=*/-75.0F), 0.0F); // over budget
+  EXPECT_GT(interference_error_db(/*e_max=*/-70.0F, /*i_cur=*/-75.0F), 0.0F); // headroom
+  EXPECT_FLOAT_EQ(interference_error_db(-75.0F, -75.0F), 0.0F);
+}
+
+// A deterministic three-node topology used across the sizing tests.
+// All nodes: activity 1.0, tx power 0 dBm, so each node's interference == its gain (linear).
+//   C1: gain -70 dB (1e-7), C2: gain -80 dB (1e-8), C3: gain -90 dB (1e-9). Sum = 1.11e-7 (~ -69.6 dB).
+static std::vector<grk_interferer> three_node_topology()
+{
+  return {{1, -70.0F, 0.0F, 1.0F}, {2, -80.0F, 0.0F, 1.0F}, {3, -90.0F, 0.0F, 1.0F}};
+}
+
+// Budget above the total interference -> empty ER, K = 0 (everyone may transmit).
+TEST(pktr_grk_test, size_er_within_budget_empty)
+{
+  const grk_state st = size_exclusion_region(/*G_TR=*/-60.0F, /*e_max=*/-60.0F, three_node_topology());
+  EXPECT_TRUE(st.exclusion_region.empty());
+  EXPECT_FLOAT_EQ(st.k_db, 0.0F);
+  EXPECT_NEAR(st.residual_interference_db, -69.56F, 0.1F); // = 10log10(1.11e-7)
+}
+
+// Budget that requires excluding only the strongest node (C1).
+// After removing C1: residual = 1.1e-8 (~ -79.6 dB) <= e_max = -75 dB.
+TEST(pktr_grk_test, size_er_excludes_strongest_only)
+{
+  const grk_state st = size_exclusion_region(-60.0F, /*e_max=*/-75.0F, three_node_topology());
+  ASSERT_EQ(st.exclusion_region.size(), 1u);
+  EXPECT_EQ(st.exclusion_region[0], 1u);              // strongest interferer
+  EXPECT_FLOAT_EQ(st.k_db, 10.0F);                    // K = G_TR - G_C1 = -60 - (-70)
+  EXPECT_LE(db_to_lin(st.residual_interference_db), db_to_lin(-75.0F) + 1e-12); // residual within budget
+}
+
+// A tighter budget forces excluding the two strongest (C1, C2), in gain order.
+// After removing C1,C2: residual = 1e-9 (-90 dB) <= e_max = -85 dB.
+TEST(pktr_grk_test, size_er_excludes_two_in_gain_order)
+{
+  const grk_state st = size_exclusion_region(-60.0F, /*e_max=*/-85.0F, three_node_topology());
+  ASSERT_EQ(st.exclusion_region.size(), 2u);
+  EXPECT_EQ(st.exclusion_region[0], 1u); // strongest first
+  EXPECT_EQ(st.exclusion_region[1], 2u); // then next-strongest
+  EXPECT_FLOAT_EQ(st.k_db, 20.0F);       // K = G_TR - G_C2 = -60 - (-80)
+}
+
+// Larger K (from a tighter budget) never yields a smaller exclusion region, monotonicity.
+TEST(pktr_grk_test, tighter_budget_grows_er_and_k)
+{
+  const grk_state loose  = size_exclusion_region(-60.0F, -70.0F, three_node_topology());
+  const grk_state tight  = size_exclusion_region(-60.0F, -85.0F, three_node_topology());
+  EXPECT_GE(tight.exclusion_region.size(), loose.exclusion_region.size());
+  EXPECT_GE(tight.k_db, loose.k_db);
+}
+
+// The residual reported after sizing always meets the budget when feasible.
+TEST(pktr_grk_test, residual_meets_budget)
+{
+  for (float e_max : {-72.0F, -78.0F, -83.0F, -88.0F}) {
+    const grk_state st = size_exclusion_region(-60.0F, e_max, three_node_topology());
+    EXPECT_LE(db_to_lin(st.residual_interference_db), db_to_lin(e_max) + 1e-12) << "e_max=" << e_max;
+  }
+}
+
+// The IPC budget feeds GRK directly: E_max[I_R] from pktr_ipc is a valid e_max for sizing.
+TEST(pktr_grk_test, ipc_budget_drives_sizing)
+{
+  pktr_config cfg;
+  cfg.gamma_db = 3.0F;
+  cfg.beta     = 0.9F; // k = 3
+  // Received signal S = -40 dBm, sigma = 2 dB -> E_max = -40 - 3 - 2*3 = -49 dBm.
+  const float e_max = max_tolerable_interference_db(/*S=*/-40.0F, /*sigma=*/2.0F, cfg);
+  EXPECT_NEAR(e_max, -49.0F, 1e-3F);
+  // With interferers well above that budget, the ER must be non-empty.
+  std::vector<grk_interferer> cands = {{1, -30.0F, 0.0F, 1.0F}, {2, -45.0F, 0.0F, 1.0F}};
+  const grk_state st = size_exclusion_region(/*G_TR=*/-20.0F, e_max, cands);
+  EXPECT_FALSE(st.exclusion_region.empty());
+  EXPECT_TRUE(st.in_er(1)); // the -30 dB interferer is way over budget -> excluded
+}
