diff --git a/lib/scheduler/kaiair/pktr_grk.h b/lib/scheduler/kaiair/pktr_grk.h
new file mode 100644
index 0000000000..d23c36e25c
--- /dev/null
+++ b/lib/scheduler/kaiair/pktr_grk.h
@@ -0,0 +1,153 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+//
+// KaiAir / PktR, GRK (Gain-Ratio-K) interference model and K-adaptation, the slow (network) loop.
+//
+// The Physical-Ratio-K (PRK) model turns "which nodes interfere with link (T->R)?", impractical to
+// answer by measuring every interferer's contribution, into a single, adaptable gain threshold.
+// A node C is a *significant* interferer for the link (T->R) iff its gain to the receiver is within
+// a factor K of the intended-signal gain:
+//
+//   C in ExclusionRegion(T->R)   <=>   G(C,R) >= G(T,R) / K.
+//
+// Nodes inside the exclusion region (ER) are prevented from transmitting concurrently (by the ONAMA
+// TDMA gate, Phase 5); the residual interference then comes only from the weaker, out-of-ER nodes.
+// K trades reliability against spatial reuse: larger K => larger ER => fewer concurrent transmitters
+// => less interference but lower reuse.
+//
+// K-adaptation sizes the ER so that the expected *residual* interference (from out-of-ER nodes) stays
+// within the budget the power-control loop can tolerate, i.e. E_max[I_R] = S - gamma - sigma*k(beta)
+// from pktr_ipc.h (the dual of the Cantelli transmit-power target). The interference-control error
+//
+//   Delta_I_R = E_max[I_R] - I_current
+//
+// drives it: Delta_I_R < 0 (interference exceeds budget) grows the ER (raises K); Delta_I_R > 0
+// (headroom) lets it shrink (lowers K), reclaiming reuse.
+//
+// This header consumes a *gain map* only as an abstraction: the caller supplies, per candidate
+// interferer C, the gain G(C,R), C's expected transmit power E[P_C], and its activity factor
+// E[alpha_C] (from scheduling statistics). Where those come from, PUSCH/SRS RSRP + PHR for in-cell
+// gains, neighbour-cell SSB-RSRP via TDD reciprocity for cross-cell gains, is the signal-map's job
+// (Phase 1, T1.3/T1.4), not this module's.
+//
+// Units: gains, powers, E_max and I_R are in dB / dBm; interference powers are summed in the linear
+// domain (they add as powers, not in dB). The module is otherwise pure math: no scheduler state.
+
+#pragma once
+
+#include "pktr_ipc.h" // E_max[I_R] budget shares the (gamma, beta, sigma) machinery
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+namespace ocudu {
+namespace kaiair {
+
+/// dB -> linear power ratio.
+inline float db_to_lin(float db)
+{
+  return std::pow(10.0F, db * 0.1F);
+}
+
+/// linear power ratio -> dB (floored to avoid log(0)).
+inline float lin_to_db(float lin)
+{
+  return 10.0F * std::log10(std::max(lin, 1e-30F));
+}
+
+/// One candidate interferer C as seen by receiver R (a gain-map row).
+struct grk_interferer {
+  /// Node / link identifier (opaque to this module).
+  uint32_t id = 0;
+  /// Gain G(C,R) from interferer C to receiver R (dB).
+  float gain_db = 0.0F;
+  /// Expected transmit power E[P_C] of C (dBm).
+  float tx_power_db = 0.0F;
+  /// Expected activity factor E[alpha_C] in [0, 1] (fraction of time C transmits).
+  float activity = 1.0F;
+
+  /// Expected received interference power this node contributes at R, in the linear domain:
+  /// E[alpha_C] * P_C * G(C,R).
+  float expected_interference_lin() const
+  {
+    return std::clamp(activity, 0.0F, 1.0F) * db_to_lin(tx_power_db + gain_db);
+  }
+  /// Same, in dB.
+  float expected_interference_db() const { return lin_to_db(expected_interference_lin()); }
+};
+
+/// Result of GRK exclusion-region sizing for one link.
+struct grk_state {
+  /// K in dB (i.e. 10*log10(K)); the ER gain threshold is signal_gain_db - k_db.
+  float k_db = 0.0F;
+  /// Identifiers of the nodes inside the ER (must not transmit concurrently with this link).
+  std::vector<uint32_t> exclusion_region;
+  /// Expected residual interference from the out-of-ER nodes (dB); this is what the link still sees.
+  float residual_interference_db = lin_to_db(0.0F);
+
+  /// Whether node \c id is in the exclusion region.
+  bool in_er(uint32_t id) const
+  {
+    return std::find(exclusion_region.begin(), exclusion_region.end(), id) != exclusion_region.end();
+  }
+};
+
+/// PRK membership test: node with gain \c gain_cr_db to R is in the ER of a link whose intended-signal
+/// gain is \c signal_gain_db, for the given \c k_db, iff G(C,R) >= G(T,R)/K.
+inline bool in_exclusion_region(float gain_cr_db, float signal_gain_db, float k_db)
+{
+  return gain_cr_db >= signal_gain_db - k_db;
+}
+
+/// Interference-control error Delta_I_R = E_max[I_R] - I_current (dB). Negative => over budget
+/// (grow the ER); positive => headroom (the ER may shrink).
+inline float interference_error_db(float e_max_db, float current_i_r_db)
+{
+  return e_max_db - current_i_r_db;
+}
+
+/// Size the exclusion region so the expected residual interference from out-of-ER nodes is at most
+/// the tolerable budget \c e_max_db, and derive K from the boundary node.
+///
+/// Sorts the candidates by gain (descending, PRK order) and admits the strongest into the ER, one
+/// at a time, until the running residual (sum of the remaining, weaker nodes' expected interference)
+/// drops to \c e_max_db. K is then set from the weakest node inside the ER (the boundary B):
+/// K = G(T,R)/G(B,R), i.e. k_db = signal_gain_db - gain_db(B).
+///
+/// If the candidates are already within budget the ER is empty (k_db = 0). If excluding every
+/// candidate still cannot meet the budget (an infeasible target), all are admitted (best effort).
+///
+/// \param signal_gain_db  Intended-link gain G(T,R) to the receiver (dB).
+/// \param e_max_db        Tolerable residual interference budget (dB), typically E_max[I_R] from
+///                        pktr_ipc, net of any noise floor the caller folds in.
+/// \param candidates      Gain-map rows for the candidate interferers (taken by value; reordered).
+inline grk_state size_exclusion_region(float signal_gain_db, float e_max_db, std::vector<grk_interferer> candidates)
+{
+  std::sort(candidates.begin(), candidates.end(), [](const grk_interferer& a, const grk_interferer& b) {
+    return a.gain_db > b.gain_db;
+  });
+
+  // Residual starts as the interference from *all* candidates (nothing excluded yet).
+  double residual_lin = 0.0;
+  for (const grk_interferer& c : candidates) {
+    residual_lin += c.expected_interference_lin();
+  }
+  const double e_max_lin = db_to_lin(e_max_db);
+
+  grk_state st;
+  for (const grk_interferer& c : candidates) {
+    if (residual_lin <= e_max_lin) {
+      break; // budget met, stop admitting nodes to the ER
+    }
+    // Admit the strongest remaining node: it will be silenced, so remove it from the residual.
+    residual_lin -= c.expected_interference_lin();
+    st.exclusion_region.push_back(c.id);
+    st.k_db = signal_gain_db - c.gain_db; // boundary node (weakest in ER so far) sets K
+  }
+  st.residual_interference_db = lin_to_db(std::max(residual_lin, 0.0));
+  return st;
+}
+
+} // namespace kaiair
+} // namespace ocudu
