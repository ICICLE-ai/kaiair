diff --git a/tests/unittests/scheduler/kaiair/pktr_ipc_test.cpp b/tests/unittests/scheduler/kaiair/pktr_ipc_test.cpp
new file mode 100644
index 0000000000..e81e874bb4
--- /dev/null
+++ b/tests/unittests/scheduler/kaiair/pktr_ipc_test.cpp
@@ -0,0 +1,94 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#include "lib/scheduler/kaiair/pktr_ipc.h"
+#include <gtest/gtest.h>
+
+using namespace ocudu;
+using namespace ocudu::kaiair;
+
+// The Cantelli factor k(beta) = sqrt(beta/(1-beta)) at the textbook reliability points.
+TEST(pktr_ipc_test, cantelli_factor_known_points)
+{
+  EXPECT_NEAR(cantelli_sigma_factor(0.5F), 1.0F, 1e-4F);   // 0.5/0.5 = 1
+  EXPECT_NEAR(cantelli_sigma_factor(0.8F), 2.0F, 1e-4F);   // 0.8/0.2 = 4 -> 2
+  EXPECT_NEAR(cantelli_sigma_factor(0.9F), 3.0F, 1e-4F);   // 0.9/0.1 = 9 -> 3
+  EXPECT_NEAR(cantelli_sigma_factor(0.99F), 9.9499F, 1e-3F); // 0.99/0.01 = 99 -> 9.9499
+}
+
+// k(beta) increases with beta: a stricter reliability target needs a bigger cushion.
+TEST(pktr_ipc_test, cantelli_factor_monotonic_in_beta)
+{
+  EXPECT_LT(cantelli_sigma_factor(0.5F), cantelli_sigma_factor(0.9F));
+  EXPECT_LT(cantelli_sigma_factor(0.9F), cantelli_sigma_factor(0.99F));
+  EXPECT_LT(cantelli_sigma_factor(0.99F), cantelli_sigma_factor(0.999F));
+}
+
+// beta is clamped to a finite range; values at/above 1 do not produce inf/nan.
+TEST(pktr_ipc_test, cantelli_factor_clamps_extreme_beta)
+{
+  EXPECT_FLOAT_EQ(cantelli_sigma_factor(0.0F), 0.0F);
+  EXPECT_TRUE(std::isfinite(cantelli_sigma_factor(1.0F)));
+  EXPECT_TRUE(std::isfinite(cantelli_sigma_factor(2.0F)));
+}
+
+// Worked example: P_T = G + I_R + gamma + sigma*k(beta).
+TEST(pktr_ipc_test, power_target_worked_example)
+{
+  pktr_config cfg;
+  cfg.gamma_db = 3.0F;
+  cfg.beta     = 0.99F; // k = 9.9499
+  // 100 + (-90) + 3 + 2*9.9499 = 13 + 19.8997 = 32.8997
+  EXPECT_NEAR(power_target_db(/*G=*/100.0F, /*I_R=*/-90.0F, /*sigma=*/2.0F, cfg), 32.8997F, 1e-2F);
+}
+
+// With zero variability the cushion vanishes: P_T = G + I_R + gamma.
+TEST(pktr_ipc_test, power_target_zero_sigma_is_deterministic_floor)
+{
+  pktr_config cfg;
+  cfg.gamma_db = 5.0F;
+  cfg.beta     = 0.9F;
+  EXPECT_NEAR(power_target_db(/*G=*/110.0F, /*I_R=*/-100.0F, /*sigma=*/0.0F, cfg), 15.0F, 1e-4F);
+}
+
+// More interference, more required margin, or more variability all raise the power target.
+TEST(pktr_ipc_test, power_target_monotonic_in_each_term)
+{
+  pktr_config cfg;
+  cfg.gamma_db = 3.0F;
+  cfg.beta     = 0.9F; // k = 3
+  const float base = power_target_db(100.0F, -90.0F, 2.0F, cfg);
+
+  EXPECT_GT(power_target_db(100.0F, -85.0F, 2.0F, cfg), base); // higher I_R
+  EXPECT_GT(power_target_db(100.0F, -90.0F, 4.0F, cfg), base); // higher sigma
+
+  pktr_config cfg_hi = cfg;
+  cfg_hi.gamma_db    = 6.0F;
+  EXPECT_GT(power_target_db(100.0F, -90.0F, 2.0F, cfg_hi), base); // higher gamma
+
+  pktr_config cfg_rel = cfg;
+  cfg_rel.beta       = 0.99F;
+  EXPECT_GT(power_target_db(100.0F, -90.0F, 2.0F, cfg_rel), base); // stricter beta
+}
+
+// E_max[I_R] = S - gamma - sigma*k(beta): the interference headroom below the signal level.
+TEST(pktr_ipc_test, max_tolerable_interference_worked_example)
+{
+  pktr_config cfg;
+  cfg.gamma_db = 3.0F;
+  cfg.beta     = 0.9F; // k = 3
+  // -50 - 3 - 2*3 = -59
+  EXPECT_NEAR(max_tolerable_interference_db(/*S=*/-50.0F, /*sigma=*/2.0F, cfg), -59.0F, 1e-3F);
+}
+
+// The power target and the interference bound are consistent: at P_T the received signal is
+// G+P_T... (kept simple), a stricter beta lowers the tolerable interference.
+TEST(pktr_ipc_test, max_tolerable_interference_monotonic_in_beta)
+{
+  pktr_config lax;
+  lax.beta = 0.8F; // k = 2
+  pktr_config strict;
+  strict.beta = 0.99F; // k = 9.95
+  EXPECT_GT(max_tolerable_interference_db(-50.0F, 2.0F, lax),
+            max_tolerable_interference_db(-50.0F, 2.0F, strict));
+}
