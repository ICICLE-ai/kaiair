+// ------------------------------------------------------------------------------------------------
+// KaiAir co-design: live control-file overlay (AgSlicing GUI).
+//
+// When KAIAIR_PKTR_CTRL_FILE points at the agent's JSON control file, the demo-critical toggles
+// (power actuation on/off, SINR-target margin) are re-read at runtime, rate-limited to ~2 Hz, so
+// the GUI can flip PktR WITHOUT restarting the gNB. When the env var is unset (all non-GUI runs and
+// the unit tests), the overlay never activates and behaviour is exactly the env-only path above
+// (backward compatible). The read path is a cheap null-check when the overlay is off.
+// ------------------------------------------------------------------------------------------------
+namespace detail {
+
+/// Control-file path, read once (it does not change within a run). nullptr => overlay off.
+inline const char* ctrl_file_path()
+{
+  static const char* p = std::getenv("KAIAIR_PKTR_CTRL_FILE");
+  return (p != nullptr and *p != '\0') ? p : nullptr;
+}
+
+struct live_controls_t {
+  std::atomic<bool>      active{false};   // has the control file been read at least once?
+  std::atomic<bool>      power{false};    // codesign AND power_control
+  std::atomic<float>     gamma_db{3.0F};  // sinr_target_db
+  std::atomic<long long> last_ms{0};      // last refresh (steady ms)
+};
+
+inline live_controls_t& live_controls()
+{
+  static live_controls_t s;
+  return s;
+}
+
+inline long long steady_now_ms()
+{
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+/// Minimal field extractors for our own small, agent-written control file (no JSON dependency).
+inline bool json_bool(const std::string& s, const char* key, bool fallback)
+{
+  const std::string k = std::string("\"") + key + "\"";
+  auto              p = s.find(k);
+  if (p == std::string::npos) {
+    return fallback;
+  }
+  p = s.find(':', p + k.size());
+  if (p == std::string::npos) {
+    return fallback;
+  }
+  const auto end = s.find_first_of(",}", p);
+  const auto t   = s.find("true", p);
+  const auto f   = s.find("false", p);
+  if (t != std::string::npos and (end == std::string::npos or t < end)) {
+    return true;
+  }
+  if (f != std::string::npos and (end == std::string::npos or f < end)) {
+    return false;
+  }
+  return fallback;
+}
+
+inline float json_float(const std::string& s, const char* key, float fallback)
+{
+  const std::string k = std::string("\"") + key + "\"";
+  auto              p = s.find(k);
+  if (p == std::string::npos) {
+    return fallback;
+  }
+  p = s.find(':', p + k.size());
+  if (p == std::string::npos) {
+    return fallback;
+  }
+  const char* base = s.c_str() + p + 1;
+  char*       endp = nullptr;
+  const float v    = std::strtof(base, &endp);
+  return (endp == base) ? fallback : v;
+}
+
+/// Re-read the control file at most ~2 Hz; update the atomics. Cheap no-op when the overlay is off.
+inline void refresh_live_controls()
+{
+  const char* path = ctrl_file_path();
+  if (path == nullptr) {
+    return;
+  }
+  live_controls_t& L    = live_controls();
+  const long long  now  = steady_now_ms();
+  long long        last = L.last_ms.load(std::memory_order_relaxed);
+  if (now - last < 500) {
+    return;
+  }
+  if (not L.last_ms.compare_exchange_strong(last, now, std::memory_order_relaxed)) {
+    return; // another thread already claimed this refresh tick
+  }
+  std::ifstream f(path);
+  if (not f) {
+    return;
+  }
+  const std::string s((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+  const bool        codesign = json_bool(s, "codesign", false);
+  const bool        power    = json_bool(s, "power_control", false);
+  const float       gamma    = json_float(s, "sinr_target_db", 3.0F);
+  L.power.store(codesign and power, std::memory_order_relaxed);
+  L.gamma_db.store(gamma, std::memory_order_relaxed);
+  L.active.store(true, std::memory_order_relaxed);
+}
+
+} // namespace detail
+
+/// Effective actuation gate: the live GUI toggle when the co-design overlay is active, else the
+/// env/compile-time gate \p env_fallback (s.actuate for UL, s.dl_loop for the DL loop, ...).
+inline bool pktr_actuate_now(bool env_fallback)
+{
+  detail::refresh_live_controls();
+  detail::live_controls_t& L = detail::live_controls();
+  return L.active.load(std::memory_order_relaxed) ? L.power.load(std::memory_order_relaxed)
+                                                  : env_fallback;
+}
+
+/// Effective SINR-target margin gamma (dB): the live GUI value when the overlay is active, else env.
+inline float pktr_gamma_now(float env_fallback)
+{
+  detail::refresh_live_controls();
+  detail::live_controls_t& L = detail::live_controls();
+  return L.active.load(std::memory_order_relaxed) ? L.gamma_db.load(std::memory_order_relaxed)
+                                                  : env_fallback;
+}
+
 /// Adaptive UL SINR-target offset (dB) that PktR adds on top of the stock power-control target: the
 /// Cantelli reliability cushion sigma*k(beta). This raises the closed-loop SINR target so the
 /// beta-quantile of the SINR distribution (not just its mean) clears the operator's base target.
@@ -134,7 +268,7 @@ inline const pktr_settings& pktr_runtime()
 /// IPC-UL actuation policy.
 inline float pktr_ul_sinr_offset_db(const pktr_link_state& ls, const pktr_settings& s)
 {
-  if (not s.actuate or not ls.has_samples() or ls.std_ni_db() > s.sigma_transient_db) {
+  if (not pktr_actuate_now(s.actuate) or not ls.has_samples() or ls.std_ni_db() > s.sigma_transient_db) {
     return 0.0F;
   }
   return ls.std_ni_db() * cantelli_sigma_factor(s.ipc.beta);
