 {
+  kaiair_signal_timer.stop(); // KaiAir/PktR
   // Stop XN setup procedure if in progress.
   xn_setup_outcome.stop();
   return launch_no_op_task();
@@ -100,6 +138,9 @@ void xnap_impl::handle_initiating_message(const init_msg_s& msg)
     case xnap_elem_procs_o::init_msg_c::types_opts::ue_context_release:
       handle_ue_context_release(msg.value.ue_context_release());
       break;
+    case xnap_elem_procs_o::init_msg_c::types_opts::private_msg:
+      handle_kaiair_private_message(msg.value.private_msg()); // KaiAir/PktR inter-gNB signal
+      break;
     default:
       logger.error("Initiating message of type {} is not supported", msg.value.type().to_string());
   }
