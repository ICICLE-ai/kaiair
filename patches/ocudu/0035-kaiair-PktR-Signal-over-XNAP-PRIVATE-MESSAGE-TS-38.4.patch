+      }
+      char buf[160];
+      std::snprintf(buf, sizeof(buf), "link %u %04x %.2f %.2f %.3f %u %.2f\n", my_pci, r.rnti, r.k_db,
+                    s.ssb_pwr_dbm - ues[i].dl_shed_db, ues[i].beta, r.er_size, r.serv_rsrp_dbm);
+      rec += buf;
+      for (const auto& [pci, v] : r.nbr_rsrp_dbm) {
+        std::snprintf(buf, sizeof(buf), "rxpwr %u %04x %u %.2f\n", my_pci, r.rnti, pci, v);
+        rec += buf;
+      }
+    }
+    store.set_own_record(std::move(rec));
+  }
   return out;
 }
 
