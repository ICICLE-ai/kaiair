--- /dev/null
+++ b/include/ocudu/asn1/xnap/kaiair_private_ies.h
@@ -0,0 +1,72 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+//
+// KaiAir / PktR, XNAP PRIVATE MESSAGE payload (TS 38.423 §9.1.3.x PRIVATE MESSAGE).
+//
+// 38.423 defines the PRIVATE MESSAGE procedure precisely for vendor-specific information exchange
+// between NG-RAN nodes, but declares no private IEs itself, so the ASN.1 generator emitted an EMPTY
+// PrivateIE container. This header supplies a concrete, spec-conformant container:
+//   PrivateIE-Container ::= SEQUENCE (SIZE(1..65535)) OF PrivateIE-Field
+//   PrivateIE-Field     ::= { id PrivateIE-ID (local INTEGER 0..65535), criticality, value OPEN TYPE }
+// with ONE private IE: id local = KAIAIR_PKTR_SIGNAL_IE_ID, value = OCTET STRING carrying the
+// PktR-Signal record (per-link K, TX power, beta, ER, receiver-side RSRPs, the PktR paper §V).
+// Encoding follows the generator's own idioms exactly (private_ie_id_c / crit_e packers, open-type
+// length guard, unbounded_octstring), so peers running this build interoperate and any standard
+// XNAP decoder parses the envelope (and skips the private IE it does not know).
+
+#pragma once
+
+#include "ocudu/asn1/xnap/common.h"
+
+namespace asn1 {
+namespace xnap {
+
+/// Local PrivateIE-ID for the KaiAir PktR-Signal record (private numbering space, 0..65535).
+constexpr uint32_t KAIAIR_PKTR_SIGNAL_IE_ID = 0x4B41; // 'K''A'
+
+/// PrivateIE-Field carrying one OCTET STRING value.
+struct kaiair_private_ie_field_s {
+  private_ie_id_c           id;
+  crit_e                    crit;
+  unbounded_octstring<true> value;
+
+  OCUDUASN_CODE pack(bit_ref& bref) const
+  {
+    HANDLE_CODE(id.pack(bref));
+    HANDLE_CODE(crit.pack(bref));
+    {
+      varlength_field_pack_guard varlen_scope(bref, true); // OPEN TYPE: length-prefixed, aligned
+      HANDLE_CODE(value.pack(bref));
+    }
+    return OCUDUASN_SUCCESS;
+  }
+  OCUDUASN_CODE unpack(cbit_ref& bref)
+  {
+    HANDLE_CODE(id.unpack(bref));
+    HANDLE_CODE(crit.unpack(bref));
+    {
+      varlength_field_unpack_guard varlen_scope(bref, true);
+      HANDLE_CODE(value.unpack(bref));
+    }
+    return OCUDUASN_SUCCESS;
+  }
+  void to_json(json_writer& j) const
+  {
+    j.start_obj();
+    j.write_fieldname("id");
+    id.to_json(j);
+    j.write_str("criticality", crit.to_string());
+    j.write_str("value", value.to_string());
+    j.end_obj();
+  }
+};
+
+/// PrivateIE-Container used by PrivateMessage (replaces the generator's empty placeholder).
+struct kaiair_private_ie_container_l : public dyn_seq_of<kaiair_private_ie_field_s, 1, 65535, true> {
+  using base_t = dyn_seq_of<kaiair_private_ie_field_s, 1, 65535, true>;
+  using base_t::base_t;
+  void to_json(json_writer& j) const { asn1::to_json(j, static_cast<const dyn_array<kaiair_private_ie_field_s>&>(*this)); }
+};
+
+} // namespace xnap
+} // namespace asn1
