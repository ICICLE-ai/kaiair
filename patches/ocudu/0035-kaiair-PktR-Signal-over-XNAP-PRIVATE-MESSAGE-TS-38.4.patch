+  {
+    std::string rec = "cell " + std::to_string(my_pci) + " " + std::to_string(s.ssb_pwr_dbm) + " " +
+                      std::to_string(now) + "\n";
+    for (size_t i = 0; i < out.ues.size(); ++i) {
+      const er_ue_result& r = out.ues[i];
+      if (!r.live) {
