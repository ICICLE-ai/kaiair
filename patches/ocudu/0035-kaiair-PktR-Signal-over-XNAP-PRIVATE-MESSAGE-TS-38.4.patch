diff --git a/tests/unittests/scheduler/kaiair/pktr_xn_signal_test.cpp b/tests/unittests/scheduler/kaiair/pktr_xn_signal_test.cpp
new file mode 100644
index 0000000000..e086f79de8
--- /dev/null
+++ b/tests/unittests/scheduler/kaiair/pktr_xn_signal_test.cpp
@@ -0,0 +1,65 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#include "ocudu/kaiair/pktr_neighbor_store.h"
+#include "ocudu/kaiair/pktr_xn_signal.h"
+#include "ocudu/asn1/xnap/xnap.h"
+#include <gtest/gtest.h>
+
+using namespace ocudu;
+using namespace ocudu::kaiair;
+
+static const std::string kRecord = "cell 7 16.00 123.000\n"
+                                   "link 7 4601 8.50 20.00 0.350 1 -78.00\n"
+                                   "rxpwr 7 4601 2 -84.00\n"
+                                   "rxpwr 7 4601 3 -95.00\n";
+
+// PRIVATE MESSAGE with the KaiAir private IE packs and unpacks to the same bytes/record (PER).
+TEST(pktr_xn_signal_test, private_message_round_trip)
+{
+  ocucp::xnap_message tx = build_pktr_signal_private_message(kRecord);
+  ASSERT_EQ(tx.pdu.type().value, asn1::xnap::xn_ap_pdu_c::types_opts::init_msg);
+  ASSERT_EQ(tx.pdu.init_msg().proc_code, ASN1_XNAP_ID_PRIVATE_MSG);
+
+  byte_buffer     buf;
+  asn1::bit_ref   bref(buf);
+  ASSERT_EQ(tx.pdu.pack(bref), asn1::OCUDUASN_SUCCESS);
+  ASSERT_GT(buf.length(), kRecord.size());
+
+  asn1::xnap::xn_ap_pdu_c rx;
+  asn1::cbit_ref          cbref(buf);
+  ASSERT_EQ(rx.unpack(cbref), asn1::OCUDUASN_SUCCESS);
+  ASSERT_EQ(rx.type().value, asn1::xnap::xn_ap_pdu_c::types_opts::init_msg);
+  ASSERT_EQ(rx.init_msg().value.type().value, asn1::xnap::xnap_elem_procs_o::init_msg_c::types_opts::private_msg);
+  EXPECT_EQ(parse_pktr_signal_private_message(rx.init_msg().value.private_msg()), kRecord);
+}
+
+// A PRIVATE MESSAGE carrying an unknown private IE yields an empty record (ignored, not an error).
+TEST(pktr_xn_signal_test, foreign_private_ie_ignored)
+{
+  ocucp::xnap_message tx = build_pktr_signal_private_message(kRecord);
+  auto&               pm = tx.pdu.init_msg().value.private_msg();
+  pm.private_ies[0].id.set_local() = 0x1234;
+  EXPECT_TRUE(parse_pktr_signal_private_message(pm).empty());
+}
+
+// The received record lands in the neighbor store as that peer's entry only.
+TEST(pktr_xn_signal_test, ingest_into_store)
+{
+  pktr_neighbor_store st;
+  EXPECT_EQ(st.ingest_peer_record(kRecord), 1U);
+  auto peers = st.peers();
+  ASSERT_EQ(peers.count(7), 1U);
+  ASSERT_EQ(peers[7].links.size(), 1U);
+  EXPECT_FLOAT_EQ(peers[7].links[0].k_db, 8.5F);
+  EXPECT_FLOAT_EQ(peers[7].links[0].rx_pwr_from_pci_dbm.at(3), -95.0F);
+  // A second peer's record does not disturb the first.
+  EXPECT_EQ(st.ingest_peer_record("cell 2 16.00 124.000\nlink 2 4602 3.00 20.00 0.100 0 -80.00\n"), 1U);
+  peers = st.peers();
+  EXPECT_EQ(peers.size(), 2U);
+  EXPECT_EQ(peers[7].links.size(), 1U);
+  EXPECT_EQ(st.nof_xn_records(), 2U);
+  // Own-record outbox.
+  st.set_own_record("cell 9 16.00 1.000\n");
+  EXPECT_EQ(st.own_record(), "cell 9 16.00 1.000\n");
+}
