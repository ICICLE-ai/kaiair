+#include "ocudu/kaiair/pktr_xn_signal.h"      // KaiAir/PktR: PktR-Signal <-> PRIVATE MESSAGE
 #include "log_helpers.h"
 #include "procedures/sn_status_transfer_asn1_helpers.h"
 #include "procedures/xn_handover_asn1_helpers.h"
@@ -39,10 +41,46 @@ xnap_impl::xnap_impl(xnc_peer_index_t          xnc_index_,
   ctrl_exec(ctrl_exec_),
   xn_setup_outcome(timer_factory{timers, ctrl_exec})
 {
+  // KaiAir/PktR: arm the periodic PktR-Signal publisher (500 ms, PRKS slow-timescale plane).
+  // Sends only once the Xn association is up (peer context known) and a record exists.
+  kaiair_signal_timer = timer_factory{timers, ctrl_exec}.create_timer();
+  kaiair_signal_timer.set(std::chrono::milliseconds{500}, [this](timer_id_t /*tid*/) {
+    kaiair_send_pktr_signal();
+    kaiair_signal_timer.run(); // re-arm (periodic)
+  });
+  kaiair_signal_timer.run();
+}
+
+void xnap_impl::kaiair_send_pktr_signal()
+{
+  if (!peer_ctxt.has_value()) {
+    return;
+  }
+  const std::string rec = kaiair::neighbor_store().own_record();
+  if (rec.empty()) {
+    return;
+  }
+  if (!tx_notifier.on_new_message(kaiair::build_pktr_signal_private_message(rec))) {
+    logger.debug("KaiAir: cannot send PktR-Signal PRIVATE MESSAGE (association down?)");
+    return;
+  }
+  ++kaiair_signals_sent;
+}
+
+void xnap_impl::handle_kaiair_private_message(const asn1::xnap::private_msg_s& msg)
+{
+  const std::string rec = kaiair::parse_pktr_signal_private_message(msg);
+  if (rec.empty()) {
+    logger.debug("PRIVATE MESSAGE without a KaiAir IE ignored");
+    return;
+  }
+  const size_t cells = kaiair::neighbor_store().ingest_peer_record(rec);
+  logger.debug("KaiAir: PktR-Signal received over Xn ({} cell record(s), {} bytes)", cells, rec.size());
 }
 
