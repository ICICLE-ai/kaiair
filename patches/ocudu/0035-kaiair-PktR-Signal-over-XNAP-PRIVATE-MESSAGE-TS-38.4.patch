diff --git a/include/ocudu/kaiair/pktr_xn_signal.h b/include/ocudu/kaiair/pktr_xn_signal.h
new file mode 100644
index 0000000000..518a73c555
--- /dev/null
+++ b/include/ocudu/kaiair/pktr_xn_signal.h
@@ -0,0 +1,47 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+//
+// KaiAir / PktR, PktR-Signal over XNAP PRIVATE MESSAGE (3GPP-carried inter-gNB exchange).
+// Builds/parses the XNAP PDU that carries one cell's PktR record (the same flat text format the
+// neighbor store parses). Used by xnap_impl: a periodic sender publishes our own record on every
+// Xn association; the receiver ingests peers' records into the neighbor store.
+
+#pragma once
+
+#include "ocudu/asn1/xnap/kaiair_private_ies.h"
+#include "ocudu/asn1/xnap/xnap.h"
+#include "ocudu/xnap/xnap_message.h"
+#include <string>
+
+namespace ocudu {
+namespace kaiair {
+
+/// PRIVATE MESSAGE (initiating message, procedure code 22, criticality ignore) with one KaiAir IE.
+inline ocucp::xnap_message build_pktr_signal_private_message(const std::string& record)
+{
+  ocucp::xnap_message msg;
+  msg.pdu.set_init_msg();
+  msg.pdu.init_msg().load_info_obj(ASN1_XNAP_ID_PRIVATE_MSG);
+  auto& pm = msg.pdu.init_msg().value.private_msg();
+  asn1::xnap::kaiair_private_ie_field_s f;
+  f.id.set_local() = asn1::xnap::KAIAIR_PKTR_SIGNAL_IE_ID;
+  f.crit           = asn1::crit_e::ignore;
+  f.value          = byte_buffer::create(record.begin(), record.end()).value();
+  pm.private_ies.push_back(f);
+  return msg;
+}
+
+/// Extract the KaiAir record from a received PRIVATE MESSAGE; empty string if none present.
+inline std::string parse_pktr_signal_private_message(const asn1::xnap::private_msg_s& pm)
+{
+  for (const auto& f : pm.private_ies) {
+    if (f.id.type().value == asn1::xnap::private_ie_id_c::types_opts::local &&
+        f.id.local() == asn1::xnap::KAIAIR_PKTR_SIGNAL_IE_ID) {
+      return std::string(f.value.begin(), f.value.end());
+    }
+  }
+  return {};
+}
+
+} // namespace kaiair
+} // namespace ocudu
