 {
   static const float v = [] {
-    const char* e = std::getenv("KAIAIR_CH4_CSI_STEP_DB");
+    const char* e = std::getenv("KAIAIR_DL_SINR_CSI_STEP_DB");
     const float f = (e != nullptr) ? std::strtof(e, nullptr) : 0.0F;
     return (f >= 0.25F && f <= 6.0F) ? f : 2.0F;
   }();
@@ -86,12 +86,12 @@ static float kaiair_ch4_step_db()
 }
 
