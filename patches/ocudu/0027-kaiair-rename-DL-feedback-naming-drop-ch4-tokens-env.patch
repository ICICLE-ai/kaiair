+kaiair_decode_dl_sinr_csi(const bounded_bitset<uci_constants::MAX_NOF_CSI_PART1_OR_PART2_BITS>& payload,
                       std::optional<float>&                                                  dl_sinr_db_out)
 {
   csi_report_data data{.valid = false};
   if (payload.size() != 10) {
-    return data; // wrong size: not the ch.4 payload (or UE toggle off), treat as invalid CSI
+    return data; // wrong size: not the DL-SINR payload (or UE toggle off), treat as invalid CSI
   }
   uint16_t v = 0;
   for (unsigned k = 0; k != 10; ++k) {
@@ -101,7 +101,7 @@ kaiair_decode_ch4_csi(const bounded_bitset<uci_constants::MAX_NOF_CSI_PART1_OR_P
   }
