-  const float    step   = kaiair_ch4_step_db();
+  const float    step   = kaiair_dl_sinr_csi_step_db();
   // Same step/offset on both fields, so the (unknown) digital-scale reference cancels in the SINR.
   const float dl_sinr_db = (static_cast<float>(q_rssi) - static_cast<float>(q_intf)) * step;
   dl_sinr_db_out         = dl_sinr_db;
@@ -288,9 +288,9 @@ uci_indication uci_cell_decoder::decode_uci(const mac_uci_indication_message& ms
           // Search for CSI report config with matching RNTI.
