   static const bool en = [] {
-    const char* e = std::getenv("KAIAIR_CH4_CSI");
+    const char* e = std::getenv("KAIAIR_DL_SINR_CSI");
     return e != nullptr && e[0] == '1';
   }();
   return en;
 }
 
-static float kaiair_ch4_step_db()
