+              // KaiAir/PktR DL-SINR: the payload is the custom 10-bit (qRSSI, qI) report, not standard CSI.
+              if (kaiair_dl_sinr_csi_enabled()) {
+                pdu.csi = kaiair_decode_dl_sinr_csi(pucch_f2f3f4->csi_part1_info->payload, pdu.kaiair_dl_sinr_db);
