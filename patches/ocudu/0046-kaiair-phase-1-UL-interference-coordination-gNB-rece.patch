+      }
+      const float pl_db = s.ssb_pwr_dbm - pic.serving.rsrp_dbm; // gNB<->UE path loss
+      r.ul_s_dbm        = in.ue_tx_pwr_dbm - pl_db;             // UL signal at my receiver
+      r.ul_e_max_dbm    = max_tolerable_interference_db(r.ul_s_dbm, in.ul_sigma_db, ul_cfg);
+      r.ul_live         = true;
+
+      cg_link l;
+      l.id            = make_link_id(my_pci, in.rnti, link_dir::ul);
+      l.tx            = {my_pci, in.rnti}; // the UE transmits
+      l.rx            = {my_pci, 0};       // my gNB receives
+      l.dir           = link_dir::ul;
+      l.k_db          = r.ul_s_dbm - r.ul_e_max_dbm; // = gamma_UL + sigma*k(beta) by construction
+      l.signal_rx_dbm = r.ul_s_dbm;
+      for (const auto& [pci, cell] : store.peers()) {
+        for (const peer_ul_link& uj : cell.ul_links) {
+          const peer_link* dlj = nullptr;
+          for (const peer_link& plnk : cell.links) {
+            if (plnk.rnti == uj.rnti) {
+              dlj = &plnk;
+              break;
+            }
+          }
+          if (dlj == nullptr) {
+            continue;
+          }
+          auto rx_it = dlj->rx_pwr_from_pci_dbm.find(my_pci);
+          if (rx_it == dlj->rx_pwr_from_pci_dbm.end()) {
+            continue; // UE_j never measured my cell -> unknown gain -> fail-open (PRK: no claim)
+          }
+          const float g_db  = s.ssb_pwr_dbm - rx_it->second;
+          const float act   = uj.ul_beta > 0.0F ? uj.ul_beta : 1.0F; // unknown activity -> worst case
+          const float i_dbm = uj.ue_tx_dbm - g_db + 10.0F * std::log10(act);
+          l.rx_pwr_from_dbm[{pci, uj.rnti}] = i_dbm;
+          if (i_dbm >= r.ul_e_max_dbm) {
+            ++r.ul_er_size;
+          }
+        }
+      }
+      graph.add_link(l);
+    }
+    // Peers' UL links: their gNB is the receiver; the gains INTO it from MY UEs come from my own
+    // UEs' neighbor-RSRP of that cell (reciprocity again), so both sides reach identical verdicts.
+    for (const auto& [pci, cell] : store.peers()) {
+      for (const peer_ul_link& uj : cell.ul_links) {
+        cg_link l;
+        l.id            = make_link_id(pci, uj.rnti, link_dir::ul);
+        l.tx            = {pci, uj.rnti};
+        l.rx            = {pci, 0};
+        l.dir           = link_dir::ul;
+        l.k_db          = uj.s_ul_dbm - uj.e_max_ul_dbm;
+        l.signal_rx_dbm = uj.s_ul_dbm;
+        for (size_t i = 0; i < ues.size(); ++i) {
+          const auto pic = store.ue_picture(ues[i].rnti);
+          auto       nit = pic.neighbors.find(pci);
+          if (pic.serving_pci == 0xffff || nit == pic.neighbors.end()) {
+            continue;
+          }
+          const float g_db = cell.ssb_pwr_dbm - nit->second.rsrp_dbm;
+          const float act  = ues[i].ul_beta > 0.0F ? ues[i].ul_beta : 1.0F;
+          l.rx_pwr_from_dbm[{my_pci, ues[i].rnti}] =
+              ues[i].ue_tx_pwr_dbm - g_db + 10.0F * std::log10(act);
+        }
+        graph.add_link(l);
+      }
+    }
+  }
