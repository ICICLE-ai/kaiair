+  // 2b. KaiAir phase-1 UL: gNB-receiver victim links (ours + peers'). Same PRK machinery, other
+  // direction. K_UL := S_ul - E_max_UL so the generic in_exclusion_region() threshold
+  // (rx_pwr >= signal - K) lands exactly on the interference budget.
+  {
+    pktr_config ul_cfg = s.ipc;
