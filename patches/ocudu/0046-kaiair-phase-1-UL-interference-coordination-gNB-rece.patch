@@ -192,6 +298,11 @@ inline er_tick_result er_controller_tick(uint16_t                        my_pci,
         std::snprintf(buf, sizeof(buf), "rxpwr %u %04x %u %.2f\n", my_pci, r.rnti, pci, v);
