+  // G(UE_j -> gNB_me) ~= G(gNB_me -> UE_j) = my SSB power - UE_j's neighbor-RSRP report of my cell
+  // (already exchanged over Xn as rxpwr rows); UE_j's TX power arrives in its ulink row (PHR-based).
+  bool                      ul_live            = false;
+  float                     ul_s_dbm           = 0.0F; // my UE's UL signal at my gNB (reciprocity dBm)
