   /// ldp.deadline_ms > 0 the per-transmission Cantelli beta becomes the LDP-derived p_req
   /// instead of ipc.beta, the deadline-aware composition (see pktr_ldp.h).
   ldp_config ldp{};
+  /// KaiAir DL-SINR true-SINR DL feedback (KAIAIR_DL_SINR_CSI): interpret the periodic PUCCH CSI payload as
+  /// the custom 10-bit (qRSSI, qI) report instead of the standard CQI report, and drive the DL
+  /// power loop from the reported DL SINR. Both ends (patched OAI UE with KAIAIR_CH4_CSI=1 and
