+// KaiAir/PktR LDP: classify the final outcome of a DL data TB for the delivery view. Delivered TBs
+// split into on-time vs late by comparing the first-tx age against the LDP deadline (when LDP is
+// off, the same default deadline is used so the with/without-LDP comparison shares one yardstick).
+void cell_metrics_handler::kaiair_handle_dl_tb_outcome(du_ue_index_t ue_index,
+                                                       bool          delivered,
+                                                       unsigned      age_slots,
+                                                       unsigned      nof_tx)
+{
+  if (not ues.contains(ue_index)) {
+    return;
+  }
+  auto& u = ues[ue_index];
+  if (not delivered) {
+    ++u.data.kaiair_ldp_dl_failed;
+    return;
+  }
+  const kaiair::ldp_config& ldp = kaiair::pktr_runtime().ldp;
+  kaiair::ldp_config        view_cfg = ldp;
+  if (view_cfg.deadline_ms <= 0.0F) {
+    view_cfg.deadline_ms = 10.0F; // LDP off: classify against the default 10 ms display deadline
+  }
+  const unsigned deadline_slots = kaiair::ldp_deadline_slots(view_cfg, nof_slots_per_sf);
+  if (age_slots < deadline_slots) {
+    ++u.data.kaiair_ldp_dl_ontime;
+  } else {
+    ++u.data.kaiair_ldp_dl_late;
+  }
+  u.data.kaiair_ldp_dl_tx_sum += nof_tx;
+}
