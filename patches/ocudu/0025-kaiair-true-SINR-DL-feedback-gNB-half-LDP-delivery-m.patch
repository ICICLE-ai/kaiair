+// KaiAir DL-SINR true-SINR DL feedback: when KAIAIR_CH4_CSI=1 the periodic PUCCH CSI report carries
+// the custom 10-bit (qRSSI, qI) payload instead of the standard CQI report, so EVERY consumer of
+// the expected part-1 size (PUCCH PRB sizing, FAPI csi_part1_bit_length, the PHY F2 decoder and
+// the MAC-side decode) must agree on 10 bits. This single override point keeps them consistent.
+// Self-contained getenv (cached) to avoid a lib/ran -> lib/scheduler dependency.
+static bool kaiair_ch4_csi_enabled()
+{
+  static const bool en = [] {
+    const char* e = std::getenv("KAIAIR_CH4_CSI");
+    return e != nullptr && e[0] == '1';
+  }();
+  return en;
+}
+
 csi_report_size ocudu::get_csi_report_pucch_size(const csi_report_configuration& config)
 {
   ocudu_assert(!config.subband.has_value(), "Subbands CSI reports are not supported on PUCCH.");
   using namespace units::literals;
 
+  // KaiAir DL-SINR: fixed 10-bit custom payload (5-bit RSSI + 5-bit interference).
+  if (kaiair_ch4_csi_enabled()) {
+    return {.part1_size = 10_bits, .part2_correspondence = {}, .part2_min_size = 0_bits, .part2_max_size = 0_bits};
+  }
+
   unsigned nof_csi_antenna_ports = csi_report_get_nof_csi_rs_antenna_ports(config.pmi_codebook);
 
   // Case for wideband PMI and CQI, TS38.214 Table 6.3.1.1.2-7.
diff --git a/lib/scheduler/kaiair/pktr_dl_power_controller.h b/lib/scheduler/kaiair/pktr_dl_power_controller.h
index 834a071821..a17aa99b34 100644
--- a/lib/scheduler/kaiair/pktr_dl_power_controller.h
+++ b/lib/scheduler/kaiair/pktr_dl_power_controller.h
@@ -58,11 +58,40 @@ public:
     if (not enabled_now()) {
       return;
     }
+    // KaiAir DL-SINR: while true-SINR feedback is flowing (SINR mode), the HARQ-BLER integrator is
+    // parked, the SINR error drives the offset instead. BLER keeps updating for display.
+    if (sinr_mode_) {
+      return;
+    }
     // OLLA-style asymmetric step toward BLER = target. ack -> shed (offset up); nack -> add power (down).
     offset_db_ += ack ? (eta_ * target_) : -(eta_ * (1.0F - target_));
     offset_db_ = std::clamp(offset_db_, 0.0F, 15.0F);
   }
 
+  /// KaiAir DL-SINR true-SINR DL feedback: feed one UE-reported DL SINR sample (dB, relative digital
+  /// scale, the same scale the target is expressed in) with the live DL SINR target (gamma_DL +
+  /// Cantelli cushion). Drives pwr_ctrl_offset by the SINR error directly (IPC set-point form):
+  /// SINR above target -> shed more power (offset up), below -> restore power (offset down). The
+  /// per-report step is clamped so one noisy report cannot slam the offset across its range.
+  void update_sinr(float sinr_db, float target_db)
+  {
+    sinr_mode_          = true; // latches: reports are periodic while the UE is attached
+    latest_dl_sinr_db_  = sinr_db;
+    latest_dl_target_db_ = target_db;
+    ++nof_sinr_reports_;
+    if (not enabled_now()) {
+      return;
+    }
+    const float err = sinr_db - target_db; // >0: headroom to shed
+    offset_db_ += std::clamp(sinr_gain_ * err, -sinr_step_max_db_, sinr_step_max_db_);
+    offset_db_ = std::clamp(offset_db_, 0.0F, 15.0F);
+  }
+
+  bool     sinr_mode() const { return sinr_mode_; }
+  float    latest_dl_sinr_db() const { return latest_dl_sinr_db_; }
+  float    latest_dl_target_db() const { return latest_dl_target_db_; }
+  uint64_t nof_sinr_reports() const { return nof_sinr_reports_; }
+
   /// Per-grant DL power offset to write into pwr_ctrl_offset, or nullopt when the loop is disabled
   /// (in which case the stock / static path applies). Quantized to the int8 1-dB field.
   std::optional<int8_t> pwr_ctrl_offset() const
@@ -90,6 +119,13 @@ private:
   float    offset_db_;         // integrator state, shed-from-ceiling, [0,15]
   float    bler_ewma_ = 0.0F;  // display/debug only
   uint64_t nof_acks_  = 0;
+  // KaiAir DL-SINR SINR mode (true-SINR feedback loop) state.
+  bool     sinr_mode_           = false;
+  float    sinr_gain_           = 0.25F; // dB of offset per dB of SINR error, per report (damped)
+  float    sinr_step_max_db_    = 1.0F;  // per-report slew limit
+  float    latest_dl_sinr_db_   = 0.0F;
+  float    latest_dl_target_db_ = 0.0F;
+  uint64_t nof_sinr_reports_    = 0;
 };
 
 } // namespace kaiair
