-              pdu.csi = decode_csi_bits(*pucch_f2f3f4, expected_slot_uci.csi_rep_cfg);
+              // KaiAir DL-SINR: the payload is the custom 10-bit (qRSSI, qI) report, not standard CSI.
+              if (kaiair_ch4_enabled()) {
+                pdu.csi = kaiair_decode_ch4_csi(pucch_f2f3f4->csi_part1_info->payload, pdu.kaiair_dl_sinr_db);
+              } else {
+                pdu.csi = decode_csi_bits(*pucch_f2f3f4, expected_slot_uci.csi_rep_cfg);
+              }
