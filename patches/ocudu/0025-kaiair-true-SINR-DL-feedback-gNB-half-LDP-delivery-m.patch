+// ------------------------------------------------------------------------------------------------
+// KaiAir DL-SINR true-SINR DL feedback (whole-payload bit-reversed decode): when
+// KAIAIR_CH4_CSI=1 the patched OAI UE sends a custom 10-bit payload in place of the standard CSI, 
+// LSB-first packed (bits 0-4 = quantized PDSCH-data RSSI, bits 5-9 = quantized interference) and
+// then bit-reversed before the PUCCH encoding chain. Reading the received spec-order bits MSB-first
+// therefore recovers the original LSB-first word directly (the "whole reverse").
+static bool kaiair_ch4_enabled()
+{
+  static const bool en = [] {
+    const char* e = std::getenv("KAIAIR_CH4_CSI");
+    return e != nullptr && e[0] == '1';
+  }();
+  return en;
+}
+
+static float kaiair_ch4_step_db()
+{
+  static const float v = [] {
+    const char* e = std::getenv("KAIAIR_CH4_CSI_STEP_DB");
+    const float f = (e != nullptr) ? std::strtof(e, nullptr) : 0.0F;
+    return (f >= 0.25F && f <= 6.0F) ? f : 2.0F;
+  }();
+  return v;
+}
+
+static csi_report_data
+kaiair_decode_ch4_csi(const bounded_bitset<uci_constants::MAX_NOF_CSI_PART1_OR_PART2_BITS>& payload,
+                      std::optional<float>&                                                  dl_sinr_db_out)
+{
+  csi_report_data data{.valid = false};
+  if (payload.size() != 10) {
+    return data; // wrong size: not the DL-SINR payload (or UE toggle off), treat as invalid CSI
+  }
+  uint16_t v = 0;
+  for (unsigned k = 0; k != 10; ++k) {
+    if (payload.test(k)) {
+      v |= 1U << (9U - k);
+    }
+  }
+  const unsigned q_rssi = v & 0x1F;
+  const unsigned q_intf = (v >> 5) & 0x1F;
+  const float    step   = kaiair_ch4_step_db();
+  // Same step/offset on both fields, so the (unknown) digital-scale reference cancels in the SINR.
+  const float dl_sinr_db = (static_cast<float>(q_rssi) - static_cast<float>(q_intf)) * step;
+  dl_sinr_db_out         = dl_sinr_db;
+
+  // Synthesize the report the stock DL link adaptation expects: wideband CQI estimated from the
+  // true SINR (inverse of the parked CQI->SINR Tier-A map, SINR ~ 1.9*CQI - 5), so MCS selection
+  // keeps working even though the UE no longer reports a real CQI.
+  data.valid = true;
+  data.ri.emplace(1);
+  const float cqi_est = (dl_sinr_db + 5.0F) / 1.9F;
+  data.first_tb_wideband_cqi.emplace(
+      static_cast<uint8_t>(std::clamp<long>(std::lround(cqi_est), 1L, 15L)));
+  return data;
+}
+// ------------------------------------------------------------------------------------------------
+
 static csi_report_data decode_pucch_csi(const bounded_bitset<uci_constants::MAX_NOF_CSI_PART1_OR_PART2_BITS>& payload,
                                         const csi_report_configuration& csi_rep_cfg)
 {
@@ -226,7 +288,12 @@ uci_indication uci_cell_decoder::decode_uci(const mac_uci_indication_message& ms
           // Search for CSI report config with matching RNTI.
           for (const auto& expected_slot_uci : slot_ucis) {
