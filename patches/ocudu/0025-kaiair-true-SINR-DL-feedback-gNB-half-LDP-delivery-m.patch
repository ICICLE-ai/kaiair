+// KaiAir DL-SINR true-SINR DL feedback: one UE-reported DL SINR sample (dB, relative digital scale).
+// Feeds the DL link statistics (EWMA mean/var -> DL Cantelli sigma) and drives the DL power loop in
+// SINR mode toward the per-direction target gamma_DL + sigma*k(beta), the same IPC form as UL, with
+// the LDP-composed per-tx beta. The transient guard mirrors the UL policy: a mean-lag-dominated
+// sigma must not over-drive the loop, so the cushion is dropped (bare gamma) while sigma is high.
+void ue_cell::kaiair_handle_dl_sinr(float dl_sinr_db)
+{
+  pktr_dl_link_state_.push_ul_measurement(dl_sinr_db, 0.0F); // sample IS S-I: sigma = std(DL SINR)
+
+  const kaiair::pktr_settings& s       = kaiair::pktr_runtime();
+  const float                  gamma   = kaiair::pktr_dl_gamma_now(s.dl_gamma_db);
+  const float                  sigma   = pktr_dl_link_state_.sigma_sinr_db();
+  const float                  k       = kaiair::cantelli_sigma_factor(kaiair::ldp_effective_tx_beta(s.ldp, s.ipc.beta));
+  const float                  cushion = (sigma <= s.sigma_transient_db) ? sigma * k : 0.0F;
+  // Drive the loop with the EWMA-smoothed SINR (once warmed up), not the raw per-report sample:
+  // the 2 dB report quantization otherwise couples into sigma and whipsaws the cushioned target
+  // (observed on the bench: shed -> SINR swing -> sigma spike -> target inflates -> restore -> ...).
+  const float loop_sinr_db =
+      (pktr_dl_link_state_.nof_samples() > 10) ? -pktr_dl_link_state_.mean_ni_db() : dl_sinr_db;
+  pktr_dl_pc_.update_sinr(loop_sinr_db, gamma + cushion);
+
+  if (s.debug_tpc and (pktr_dl_pc_.nof_sinr_reports() % 50 == 1)) {
+    fmt::print("[KaiAir ch4 DL] rnti={:#06x} DL SINR={:.1f} dB target={:.1f} (gamma_DL={:.1f} + cushion={:.2f}) "
+               "offset={:.2f} dB reports={}\n",
+               fmt::underlying(rnti()),
+               dl_sinr_db,
+               gamma + cushion,
+               gamma,
+               cushion,
+               pktr_dl_pc_.offset_db(),
+               pktr_dl_pc_.nof_sinr_reports());
+  }
+}
