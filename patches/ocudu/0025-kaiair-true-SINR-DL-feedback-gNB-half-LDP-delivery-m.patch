+void cell_metrics_handler::kaiair_handle_dl_sinr(du_ue_index_t ue_index, float dl_sinr_db)
+{
+  if (ues.contains(ue_index)) {
+    ues[ue_index].pktr_dl_link_state.push_ul_measurement(dl_sinr_db, 0.0F);
+  }
+}
