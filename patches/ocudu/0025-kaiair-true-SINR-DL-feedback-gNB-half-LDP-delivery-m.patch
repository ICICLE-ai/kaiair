+  float ch4_step_db = 2.0F;
+  /// DL SINR-target margin gamma_DL (dB). gamma is per-link/per-direction in PktR, so the DL
+  /// target is independent of the UL ipc.gamma_db (KAIAIR_PKTR_GAMMA_DB).
+  float dl_gamma_db = 10.0F;
 };
 
