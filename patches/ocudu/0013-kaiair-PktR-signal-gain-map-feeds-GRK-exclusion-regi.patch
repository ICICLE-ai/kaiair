diff --git a/tests/unittests/scheduler/kaiair/pktr_signal_map_test.cpp b/tests/unittests/scheduler/kaiair/pktr_signal_map_test.cpp
new file mode 100644
index 0000000000..ad353601e1
--- /dev/null
+++ b/tests/unittests/scheduler/kaiair/pktr_signal_map_test.cpp
@@ -0,0 +1,94 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#include "lib/scheduler/kaiair/pktr_signal_map.h"
+#include <gtest/gtest.h>
+
+using namespace ocudu;
+using namespace ocudu::kaiair;
+
+// Node id convention for the tests: cell A = {gNB 10, UE 11}, cell B = {gNB 20, UE 21}.
+static constexpr uint32_t GNB_A = 10, UE_A = 11, GNB_B = 20, UE_B = 21;
+
+// A single measurement yields path gain = rx_power - tx_power.
+TEST(pktr_signal_map_test, gain_is_rx_minus_tx)
+{
+  pktr_signal_map m;
+  m.update_gain(UE_A, GNB_A, /*rsrp=*/-26.0F, /*ue_tx=*/22.0F); // G(UE_A -> gNB_A)
+  ASSERT_TRUE(m.gain_db(UE_A, GNB_A).has_value());
+  EXPECT_NEAR(*m.gain_db(UE_A, GNB_A), -48.0F, 1e-4F);
+  EXPECT_FALSE(m.gain_db(GNB_A, UE_A).has_value()); // direction matters; reverse not set
+}
+
+// Repeated measurements are EWMA-smoothed toward the new value.
+TEST(pktr_signal_map_test, ewma_smooths_gain)
+{
+  pktr_signal_map m(/*ewma_c=*/0.5F);
+  m.update_gain(UE_A, GNB_A, -60.0F, 0.0F); // gain -60
+  m.update_gain(UE_A, GNB_A, -40.0F, 0.0F); // gain -40 -> 0.5*-60 + 0.5*-40 = -50
+  EXPECT_NEAR(*m.gain_db(UE_A, GNB_A), -50.0F, 1e-4F);
+}
+
+// candidates_for excludes the intended transmitter and needs node state to include an interferer.
+TEST(pktr_signal_map_test, candidates_exclude_intended_and_require_node_state)
+{
+  pktr_signal_map m;
+  m.update_gain(UE_A, GNB_A, -30.0F, 0.0F); // intended link at gNB_A
+  m.update_gain(UE_B, GNB_A, -50.0F, 0.0F); // cross-cell interferer at gNB_A
+  // No node state yet -> the interferer is dropped (incomplete row).
+  EXPECT_TRUE(m.candidates_for(GNB_A, UE_A).empty());
+  // With node state, UE_B appears; the intended UE_A never does.
+  m.set_node(UE_B, /*tx=*/0.0F, /*activity=*/1.0F);
+  m.set_node(UE_A, 0.0F, 1.0F);
+  const auto cands = m.candidates_for(GNB_A, UE_A);
+  ASSERT_EQ(cands.size(), 1u);
+  EXPECT_EQ(cands[0].id, UE_B);
+  EXPECT_NEAR(cands[0].gain_db, -50.0F, 1e-4F);
+}
+
+// End-to-end: a 2-cell scenario feeds the signal map into the GRK exclusion-region computation.
+// gNB_A serves UE_A; UE_B (cell B) interferes at gNB_A. If the interference exceeds the tolerable
+// budget, GRK must place UE_B in the exclusion region.
+TEST(pktr_signal_map_test, feeds_grk_two_cell)
+{
+  pktr_signal_map m;
+  // Intended link A: UE_A heard at -20 dB gain by gNB_A, TX 0 dBm.
+  m.update_gain(UE_A, GNB_A, /*rsrp=*/-20.0F, /*ue_tx=*/0.0F);
+  m.set_node(UE_A, 0.0F, 1.0F);
+  // Interferer: UE_B heard at -24 dB gain by gNB_A, TX 0 dBm, always active.
+  m.update_gain(UE_B, GNB_A, /*rsrp=*/-24.0F, /*ue_tx=*/0.0F);
+  m.set_node(UE_B, 0.0F, 1.0F);
+
+  const float signal_gain = *m.gain_db(UE_A, GNB_A); // G(T,R) = -20 dB
+  ASSERT_NEAR(signal_gain, -20.0F, 1e-4F);
+
+  // IPC budget: S=-20 dBm, sigma=1 dB, beta=0.9 (k=3), gamma=3 -> E_max = -20 - 3 - 3 = -26 dBm.
+  pktr_config cfg;
+  cfg.gamma_db      = 3.0F;
+  cfg.beta          = 0.9F;
+  const float e_max = max_tolerable_interference_db(/*S=*/-20.0F, /*sigma=*/1.0F, cfg);
+  ASSERT_NEAR(e_max, -26.0F, 1e-3F);
+
+  // UE_B's expected interference is -24 dBm (above the -26 dBm budget) -> must be excluded.
+  const grk_state st = size_exclusion_region(signal_gain, e_max, m.candidates_for(GNB_A, UE_A));
+  ASSERT_EQ(st.exclusion_region.size(), 1u);
+  EXPECT_EQ(st.exclusion_region[0], UE_B);
+  EXPECT_FLOAT_EQ(st.k_db, 4.0F); // K = G_TR - G_CR = -20 - (-24)
+}
+
+// A weak, distant interferer that fits under the budget is NOT excluded.
+TEST(pktr_signal_map_test, weak_interferer_not_excluded)
+{
+  pktr_signal_map m;
+  m.update_gain(UE_A, GNB_A, -20.0F, 0.0F);
+  m.set_node(UE_A, 0.0F, 1.0F);
+  m.update_gain(UE_B, GNB_A, -90.0F, 0.0F); // very weak: -90 dB
+  m.set_node(UE_B, 0.0F, /*activity=*/0.5F);
+
+  pktr_config cfg;
+  cfg.beta          = 0.9F;
+  const float e_max = max_tolerable_interference_db(-20.0F, 1.0F, cfg); // -26 dBm
+  const grk_state st = size_exclusion_region(*m.gain_db(UE_A, GNB_A), e_max, m.candidates_for(GNB_A, UE_A));
+  EXPECT_TRUE(st.exclusion_region.empty());
+  EXPECT_FLOAT_EQ(st.k_db, 0.0F);
+}
