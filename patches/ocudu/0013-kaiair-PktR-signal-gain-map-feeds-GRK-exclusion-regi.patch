diff --git a/lib/scheduler/kaiair/pktr_signal_map.h b/lib/scheduler/kaiair/pktr_signal_map.h
new file mode 100644
index 0000000000..f235d68ceb
--- /dev/null
+++ b/lib/scheduler/kaiair/pktr_signal_map.h
@@ -0,0 +1,120 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+//
+// KaiAir / PktR, the signal (gain) map: the "who-hears-whom" table the GRK exclusion-region
+// computation runs on. It stores, per ordered pair (transmitter, receiver), the path gain
+//
+//   G(tx, rx) = (received power of tx's reference signal) - (tx's transmit power)   [dB],
+//
+// smoothed with an EWMA because path gains vary slowly. Crucially, gains come from *reference
+// signals* (each tied to a known transmitter at a known power), never from the aggregate data
+// SINR, that is what makes them per-link and separable:
+//   - in-cell UL  G(UE->gNB): PUSCH/SRS RSRP + UE TX power (from PHR),
+//   - in-cell DL  G(gNB->UE): SSB/CSI-RSRP reported by the UE,
+//   - cross-cell  G(UE_u->gNB_B): neighbour-cell SSB-RSRP via TDD reciprocity.
+//
+// The map exposes candidate interferer lists (grk_interferer rows) for a receiver, which feed
+// pktr_grk::size_exclusion_region directly. Per-node transmit power and activity factor (from
+// scheduling statistics) are held alongside the gains so a candidate row is fully populated.
+//
+// Units note: rx_power and tx_power must be in consistent units per call. A fixed dBFS<->dBm
+// calibration offset on the RX chain cancels in the GRK gain *ratio* K = G(T,R)/G(C,R), so the
+// exclusion region is correct even with uncalibrated (relative) gains; only absolute-dBm claims
+// would need the offset.
+
+#pragma once
+
+#include "pktr_grk.h"
+#include "pktr_link_state.h" // default_ewma_c
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <utility>
+#include <vector>
+
+namespace ocudu {
+namespace kaiair {
+
+/// Per-transmitter attributes used to populate a candidate interferer row (from scheduling stats).
+struct pktr_node_state {
+  /// Expected / most-recent transmit power (dBm), used as E[P_C].
+  float tx_power_db = 0.0F;
+  /// Activity factor in [0, 1] (fraction of resources on which the node transmits), used as E[alpha_C].
+  float activity = 1.0F;
+};
+
+/// The PktR gain map. One instance per scheduler; keyed by opaque node identifiers.
+class pktr_signal_map
+{
+public:
+  /// EWMA old-sample weight for gain smoothing. Gains are slow, so the default is stable (15/16).
+  explicit pktr_signal_map(float ewma_c = pktr_link_state::default_ewma_c) : c_(ewma_c) {}
+
+  /// Update the gain G(tx -> rx) from one reference measurement: the received reference power and the
+  /// transmitter's power, in consistent dB units. Path gain = rx_power_db - tx_power_db, EWMA-smoothed.
+  void update_gain(uint32_t tx_id, uint32_t rx_id, float rx_power_db, float tx_power_db)
+  {
+    const float gain = rx_power_db - tx_power_db;
+    auto [it, inserted] = gains_.try_emplace({tx_id, rx_id}, gain);
+    if (!inserted) {
+      it->second = c_ * it->second + (1.0F - c_) * gain; // EWMA
+    }
+  }
+
+  /// Set/refresh a node's transmit power (dBm) and activity factor (from scheduling statistics).
+  void set_node(uint32_t id, float tx_power_db, float activity)
+  {
+    nodes_[id] = {tx_power_db, activity};
+  }
+
+  /// Smoothed gain G(tx -> rx) in dB, or nullopt if that pair has never been measured.
+  std::optional<float> gain_db(uint32_t tx_id, uint32_t rx_id) const
+  {
+    auto it = gains_.find({tx_id, rx_id});
+    if (it == gains_.end()) {
+      return std::nullopt;
+    }
+    return it->second;
+  }
+
+  /// Node attributes, or nullopt if unknown.
+  std::optional<pktr_node_state> node(uint32_t id) const
+  {
+    auto it = nodes_.find(id);
+    if (it == nodes_.end()) {
+      return std::nullopt;
+    }
+    return it->second;
+  }
+
+  /// Build the candidate-interferer list for receiver \c rx_id: every known transmitter other than
+  /// \c intended_tx_id that has a gain to \c rx_id and a known node state, as a grk_interferer row
+  /// {G(tx,rx), E[P_tx], E[alpha_tx]}. Ready to pass to pktr_grk::size_exclusion_region.
+  std::vector<grk_interferer> candidates_for(uint32_t rx_id, uint32_t intended_tx_id) const
+  {
+    std::vector<grk_interferer> out;
+    for (const auto& [key, gain] : gains_) {
+      const uint32_t tx = key.first, rx = key.second;
+      if (rx != rx_id || tx == intended_tx_id) {
+        continue;
+      }
+      auto ns = node(tx);
+      if (!ns.has_value()) {
+        continue; // no TX-power/activity known for this interferer yet
+      }
+      out.push_back(grk_interferer{tx, gain, ns->tx_power_db, ns->activity});
+    }
+    return out;
+  }
+
+  /// Number of gain entries held (for diagnostics/tests).
+  std::size_t nof_gains() const { return gains_.size(); }
+
+private:
+  float c_; // EWMA old-sample weight
+  std::map<std::pair<uint32_t, uint32_t>, float> gains_; // (tx, rx) -> smoothed gain (dB)
+  std::map<uint32_t, pktr_node_state>            nodes_; // node id -> {tx power, activity}
+};
+
+} // namespace kaiair
+} // namespace ocudu
