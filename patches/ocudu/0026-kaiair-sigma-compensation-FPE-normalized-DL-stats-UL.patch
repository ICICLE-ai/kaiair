+  /// KaiAir ch.4 sigma compensation: the offset (dB) that was in force during the slot the CURRENT
+  /// report measured, one feedback delay (~1 report period) behind the live offset. Adding it back
+  /// to the reported SINR yields the full-power-equivalent SINR, removing the loop's own actuation
+  /// from the channel statistics EXACTLY (the actuator is dB-linear, HW-confirmed).
+  float offset_at_measurement() const { return offset_prev2_report_db_; }
+
+  /// Whether the offset was stable across the current report's measurement window. When the loop
+  /// stepped mid-window the delayed-offset alignment is ambiguous, skip the sigma update then.
+  bool offset_stable_at_measurement() const
+  {
+    return std::abs(offset_prev_report_db_ - offset_prev2_report_db_) < 0.5F;
+  }
+
   bool     sinr_mode() const { return sinr_mode_; }
