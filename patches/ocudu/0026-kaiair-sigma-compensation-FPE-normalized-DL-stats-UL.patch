   float dl_gamma_db = 10.0F;
+  /// Minimum UL Cantelli cushion (dB) while actuation is on (KAIAIR_PKTR_MIN_CUSHION_DB).
+  /// Bench-derived safety floor: the LDP-composed per-tx beta can shrink k(beta) so far that the
+  /// loop rides ~1 dB above bare gamma, thin enough that ordinary fades trigger CRC losses,
+  /// sigma inflation and the bistable link collapse (measured: LDP D=20 + power ON = 9 drops in
+  /// 10 min; power OFF = 0). The Cantelli bound assumes sigma captures all uncertainty; this
+  /// platform has a hard nonlinearity below a small margin, so the cushion is floored above it.
+  float min_cushion_db = 3.0F;
 };
 
