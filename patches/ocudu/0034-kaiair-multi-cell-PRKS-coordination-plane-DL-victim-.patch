diff --git a/tests/unittests/scheduler/kaiair/pktr_conflict_graph_test.cpp b/tests/unittests/scheduler/kaiair/pktr_conflict_graph_test.cpp
new file mode 100644
index 0000000000..4635811439
--- /dev/null
+++ b/tests/unittests/scheduler/kaiair/pktr_conflict_graph_test.cpp
@@ -0,0 +1,78 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#include "lib/scheduler/kaiair/pktr_conflict_graph.h"
+#include <gtest/gtest.h>
+
+using namespace ocudu;
+using namespace ocudu::kaiair;
+
+static cg_link dl_link(uint16_t pci, uint16_t rnti, float k_db, float signal_dbm)
+{
+  cg_link l;
+  l.id            = make_link_id(pci, rnti, link_dir::dl);
+  l.tx            = {pci, 0};
+  l.rx            = {pci, rnti};
+  l.dir           = link_dir::dl;
+  l.k_db          = k_db;
+  l.signal_rx_dbm = signal_dbm;
+  return l;
+}
+
+// Equal-power form: C is in ER iff rx_pwr(C) >= signal - K.
+TEST(pktr_conflict_graph_test, exclusion_region_membership)
+{
+  cg_link l = dl_link(7, 0x4601, 10.0F, -80.0F);
+  l.rx_pwr_from_dbm[{2, 0}] = -85.0F; // 5 dB below signal: inside a 10 dB ER
+  l.rx_pwr_from_dbm[{3, 0}] = -95.0F; // 15 dB below: outside
+  EXPECT_TRUE(in_exclusion_region(l, {2, 0}));
+  EXPECT_FALSE(in_exclusion_region(l, {3, 0}));
+  EXPECT_FALSE(in_exclusion_region(l, {9, 0})); // unmeasured => not claimed
+  l.k_db = 0.0F;                                 // K <= 0 => tolerate everything
+  EXPECT_FALSE(in_exclusion_region(l, {2, 0}));
+}
+
+// Conflict is the UNION of the two ER memberships (mutual by construction).
+TEST(pktr_conflict_graph_test, conflict_is_mutual_union)
+{
+  cg_link a = dl_link(7, 0x4601, 10.0F, -80.0F);
+  cg_link b = dl_link(2, 0x4602, 10.0F, -80.0F);
+  // a's receiver hears b's gNB weakly; b's receiver hears a's gNB strongly.
+  a.rx_pwr_from_dbm[{2, 0}] = -100.0F;
+  b.rx_pwr_from_dbm[{7, 0}] = -82.0F;
+  EXPECT_FALSE(in_exclusion_region(a, b.tx));
+  EXPECT_TRUE(in_exclusion_region(b, a.tx));
+  EXPECT_TRUE(links_conflict(a, b));
+  EXPECT_TRUE(links_conflict(b, a));
+}
+
+// Shared end node always conflicts; no shared node + no ER membership never conflicts.
+TEST(pktr_conflict_graph_test, shared_node_and_independent_links)
+{
+  cg_link a = dl_link(7, 0x4601, 10.0F, -80.0F);
+  cg_link u;
+  u.id  = make_link_id(7, 0x4601, link_dir::ul);
+  u.tx  = {7, 0x4601};
+  u.rx  = {7, 0};
+  u.dir = link_dir::ul;
+  EXPECT_TRUE(links_conflict(a, u)); // same UE/gNB
+  cg_link far = dl_link(3, 0x4603, 10.0F, -80.0F);
+  EXPECT_FALSE(links_conflict(a, far));
+  EXPECT_FALSE(links_conflict(a, a));
+}
+
+TEST(pktr_conflict_graph_test, graph_conflict_sets_and_pairs)
+{
+  pktr_conflict_graph g;
+  cg_link a = dl_link(7, 0x4601, 10.0F, -80.0F);
+  cg_link b = dl_link(2, 0x4602, 10.0F, -80.0F);
+  cg_link c = dl_link(3, 0x4603, 10.0F, -80.0F);
+  b.rx_pwr_from_dbm[{7, 0}] = -82.0F; // b conflicts with a
+  g.add_link(a);
+  g.add_link(b);
+  g.add_link(c);
+  EXPECT_EQ(g.conflict_set(a.id).size(), 1U);
+  EXPECT_EQ(g.conflict_set(a.id)[0], b.id);
+  EXPECT_EQ(g.conflict_set(c.id).size(), 0U);
+  EXPECT_EQ(g.conflict_pairs().size(), 1U);
+}
diff --git a/tests/unittests/scheduler/kaiair/pktr_neighbor_store_test.cpp b/tests/unittests/scheduler/kaiair/pktr_neighbor_store_test.cpp
new file mode 100644
index 0000000000..1a163e550c
--- /dev/null
+++ b/tests/unittests/scheduler/kaiair/pktr_neighbor_store_test.cpp
@@ -0,0 +1,70 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#include "ocudu/kaiair/pktr_neighbor_store.h"
+#include <cstdio>
+#include <gtest/gtest.h>
+
+using namespace ocudu;
+using namespace ocudu::kaiair;
+
+TEST(pktr_neighbor_store_test, rsrp_index_conversion)
+{
+  EXPECT_FLOAT_EQ(pktr_neighbor_store::rsrp_index_to_dbm(0), -156.0F);
+  EXPECT_FLOAT_EQ(pktr_neighbor_store::rsrp_index_to_dbm(76), -80.0F);
+}
+
+TEST(pktr_neighbor_store_test, ue_report_and_dl_candidates)
+{
+  pktr_neighbor_store st;
+  st.report_ue_measurement(0x4601, 7, -80.0F, {{2, -90.0F}, {3, -97.0F}}, 100.0);
+  EXPECT_TRUE(st.has_ue(0x4601));
+  auto pic = st.ue_picture(0x4601);
+  EXPECT_EQ(pic.serving_pci, 7);
+  EXPECT_FLOAT_EQ(pic.serving.rsrp_dbm, -80.0F);
+  auto cands = st.dl_candidates(0x4601, 101.0);
+  ASSERT_EQ(cands.size(), 2U);
+  EXPECT_EQ(cands[0].pci, 2);
+  EXPECT_FLOAT_EQ(cands[0].rx_pwr_dbm, -90.0F);
+  EXPECT_FLOAT_EQ(cands[0].activity, 1.0F); // no peer info => conservative
+  // Aged out.
+  EXPECT_TRUE(st.dl_candidates(0x4601, 200.0).empty());
+  st.forget_ue(0x4601);
+  EXPECT_FALSE(st.has_ue(0x4601));
+}
+
+TEST(pktr_neighbor_store_test, peers_file_parsing_and_gain)
+{
+  const char* path = "/tmp/kaiair_store_test_peers.txt";
+  FILE*       f    = std::fopen(path, "w");
+  std::fputs("# peer bus snapshot\n"
+             "cell 2 16.0 123.0\n"
+             "link 2 4602 8.5 20.0 0.35 1 -78.0\n"
+             "rxpwr 2 4602 7 -84.0\n"
+             "cell 3 13.0 123.0\n",
+             f);
+  std::fclose(f);
+  pktr_neighbor_store st;
+  st.refresh_peers_from_file(path, 1000);
+  auto peers = st.peers();
+  ASSERT_EQ(peers.size(), 2U);
+  EXPECT_FLOAT_EQ(peers[2].ssb_pwr_dbm, 16.0F);
+  ASSERT_EQ(peers[2].links.size(), 1U);
+  EXPECT_EQ(peers[2].links[0].rnti, 0x4602);
+  EXPECT_FLOAT_EQ(peers[2].links[0].k_db, 8.5F);
+  EXPECT_FLOAT_EQ(peers[2].links[0].beta, 0.35F);
+  EXPECT_FLOAT_EQ(peers[2].links[0].signal_rx_dbm, -78.0F);
+  EXPECT_FLOAT_EQ(peers[2].links[0].rx_pwr_from_pci_dbm.at(7), -84.0F);
+  // Rate limit: a second refresh within refresh_ms is a no-op (file unchanged anyway).
+  st.refresh_peers_from_file(path, 1100);
+  // Candidate activity now follows the peer's beta; DL gain uses the peer's SSB power.
+  st.report_ue_measurement(0x4601, 7, -80.0F, {{2, -90.0F}}, 100.0);
+  auto cands = st.dl_candidates(0x4601, 101.0);
+  ASSERT_EQ(cands.size(), 1U);
+  EXPECT_FLOAT_EQ(cands[0].activity, 0.35F);
+  float g = 0.0F;
+  ASSERT_TRUE(st.dl_gain_db(0x4601, 2, 16.0F, g));
+  EXPECT_FLOAT_EQ(g, -106.0F); // -90 dBm RSRP - 16 dBm SSB
+  EXPECT_FALSE(st.dl_gain_db(0x4601, 9, 16.0F, g));
+  std::remove(path);
+}
diff --git a/tests/unittests/scheduler/kaiair/pktr_slot_gate_test.cpp b/tests/unittests/scheduler/kaiair/pktr_slot_gate_test.cpp
new file mode 100644
index 0000000000..24d000fd77
--- /dev/null
+++ b/tests/unittests/scheduler/kaiair/pktr_slot_gate_test.cpp
@@ -0,0 +1,79 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#include "lib/scheduler/kaiair/pktr_slot_gate.h"
+#include <gtest/gtest.h>
+
+using namespace ocudu;
+using namespace ocudu::kaiair;
+
+// Deterministic and node-independent: the same (slot, link) always hashes identically.
+TEST(pktr_slot_gate_test, priority_is_deterministic)
+{
+  EXPECT_EQ(onama_priority(1234, 0x00070001), onama_priority(1234, 0x00070001));
+  EXPECT_NE(onama_priority(1234, 0x00070001), onama_priority(1235, 0x00070001));
+  EXPECT_NE(onama_priority(1234, 0x00070001), onama_priority(1234, 0x00020002));
+}
+
+// With no conflicts a link is always active.
+TEST(pktr_slot_gate_test, no_conflict_always_active)
+{
+  for (uint32_t s = 0; s < 100; ++s) {
+    EXPECT_TRUE(onama_active(s, 42, {}));
+  }
+}
+
+// Exactly one winner per conflicting pair per slot (no deadlock, no double-activation).
+TEST(pktr_slot_gate_test, one_winner_per_pair)
+{
+  const uint32_t a = 0x00070001, b = 0x00020002;
+  for (uint32_t s = 0; s < 2000; ++s) {
+    const bool aa = onama_active(s, a, {b});
+    const bool bb = onama_active(s, b, {a});
+    EXPECT_NE(aa, bb) << "slot " << s;
+  }
+}
+
+// Fair share: over many slots each of a 3-clique gets ~1/3 of the slots (no starvation).
+TEST(pktr_slot_gate_test, clique_share_is_fair)
+{
+  const uint32_t ids[3] = {0x00070001, 0x00020002, 0x00030003};
+  unsigned       wins[3] = {0, 0, 0};
+  const unsigned N       = 30000;
+  for (uint32_t s = 0; s < N; ++s) {
+    for (int i = 0; i < 3; ++i) {
+      std::vector<uint32_t> others;
+      for (int j = 0; j < 3; ++j) {
+        if (j != i) {
+          others.push_back(ids[j]);
+        }
+      }
+      wins[i] += onama_active(s, ids[i], others) ? 1 : 0;
+    }
+  }
+  for (unsigned w : wins) {
+    EXPECT_NEAR(static_cast<double>(w) / N, 1.0 / 3.0, 0.02);
+  }
+  EXPECT_EQ(wins[0] + wins[1] + wins[2], N); // exactly one active per slot in a clique
+}
+
+// Masks: window lookup matches the per-slot function; outside the window fails OPEN.
+TEST(pktr_slot_gate_test, mask_matches_and_fails_open)
+{
+  const uint32_t a = 0x00070001, b = 0x00020002;
+  link_slot_mask m = compute_link_mask(a, 1000, 64, {b});
+  for (uint32_t s = 1000; s < 1064; ++s) {
+    EXPECT_EQ(m.at(s), onama_active(s, a, {b}));
+  }
+  EXPECT_TRUE(m.at(5000));
+  EXPECT_NEAR(active_fraction(m), 0.5F, 0.2F);
+}
+
+TEST(pktr_slot_gate_test, gate_mode_parsing)
+{
+  EXPECT_EQ(parse_gate_mode(nullptr), er_gate_mode::off);
+  EXPECT_EQ(parse_gate_mode("observe"), er_gate_mode::observe);
+  EXPECT_EQ(parse_gate_mode("enforce"), er_gate_mode::enforce);
+  EXPECT_EQ(parse_gate_mode("1"), er_gate_mode::enforce);
+  EXPECT_EQ(parse_gate_mode("garbage"), er_gate_mode::off);
+}
