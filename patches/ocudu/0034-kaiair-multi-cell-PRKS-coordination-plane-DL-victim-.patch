+++ b/include/ocudu/kaiair/pktr_neighbor_store.h
@@ -0,0 +1,291 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+//
+// KaiAir / PktR, process-wide NEIGHBOR STORE: the multi-cell signal-map feed (LDP/PRKS plan
+// step B1/B2). Two producers, one consumer set:
+//
+//   producer 1 (CU-CP, cell_meas_manager): every RRC MeasurementReport of a UE publishes the
+//     serving-cell and neighbor-cell SSB-RSRP (dBm) keyed by the UE's C-RNTI, the dissertation's
+//     §4.5.5 "signal map updated from intra-frequency measurement reports (38.133)". The UE never
+//     computes K; it only measures.
+//   producer 2 (the co-design agent's peer bus): neighbor gNBs' per-cell info (SSB power) and
+//     per-link state (K, TX power, PRB occupancy beta, ER size) exchanged over UDP, PktR's
+//     "PktR-Signal" message, written to a flat text file this store re-reads at ~2 Hz.
+//   consumers (DU scheduler / metrics view): per-UE candidate interferer lists for the DL-victim
+//     GRK evaluation (signal = serving RSRP, candidates = neighbor RSRPs, SAME dBm scale from the
+//     SAME report), and the peer link table for the UL-victim attribution and the conflict graph.
+//
+// Identity: C-RNTI is the key shared by CU-CP and DU for a UE within one gNB; PCI identifies
+// cells on the peer bus. Thread-safe (mutex); all readers copy out. Header-only, public include
+// so both lib/cu_cp and lib/scheduler can see it.
+
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace ocudu {
+namespace kaiair {
+
+/// One neighbor-cell RSRP sample as reported by a UE (38.133 SS-RSRP, converted to dBm).
+struct nbr_rsrp_sample {
+  float  rsrp_dbm = 0.0F;
+  double ts       = 0.0; // wall-clock seconds
+};
+
+/// A UE's latest measurement picture: serving cell + neighbors, all from the same report.
+struct ue_meas_picture {
+  uint16_t                            serving_pci = 0xffff;
+  nbr_rsrp_sample                     serving;
+  std::map<uint16_t, nbr_rsrp_sample> neighbors; // pci -> sample
+};
+
+/// Per-link state a peer cell publishes (PktR-Signal contents).
+struct peer_link {
+  uint16_t rnti          = 0;
+  float    k_db          = 0.0F; // that link's current K (dB)
+  float    tx_pwr_dbm    = 0.0F; // avg TX power of the link's transmitter (UE for UL, gNB for DL)
+  float    beta          = 0.0F; // transmit probability / PRB occupancy fraction [0,1]
+  unsigned er_size       = 0;    // exclusion-region size (nodes)
+  float    signal_rx_dbm = 0.0F; // desired-signal power at that link's RECEIVER (its serving RSRP)
+  /// Received power at that link's receiver from OTHER cells (its UE's neighbor RSRPs, dBm), 
+  /// this is what lets us decide whether OUR transmitter sits inside THEIR exclusion region.
+  std::map<uint16_t, float> rx_pwr_from_pci_dbm;
+};
+
+struct peer_cell {
+  uint16_t               pci          = 0xffff;
+  float                  ssb_pwr_dbm  = 0.0F;
+  double                 ts           = 0.0;
+  std::vector<peer_link> links;
+};
+
+/// Candidate interferer for the GRK exclusion-region sizing, in the victim's dBm scale.
+struct nbr_candidate {
+  uint16_t pci          = 0xffff;
+  float    rx_pwr_dbm   = 0.0F;  // received power of that cell at the victim (= its SSB RSRP)
+  float    activity     = 1.0F;  // peer's reported beta if known, else 1 (conservative)
+  double   age_s        = 0.0;
+};
+
+class pktr_neighbor_store
+{
+public:
+  /// 38.133 Table 10.1.6.1-1: SS-RSRP report index 0..127 -> dBm = idx - 156.
+  static float rsrp_index_to_dbm(unsigned idx) { return static_cast<float>(idx) - 156.0F; }
+
+  // ---------------------------------------------------------------- producer 1: CU-CP reports
+  void report_ue_measurement(uint16_t rnti, uint16_t serving_pci, float serving_rsrp_dbm,
+                             const std::vector<std::pair<uint16_t, float>>& neighbor_rsrp_dbm, double ts)
+  {
+    std::lock_guard<std::mutex> lk(m_);
+    ue_meas_picture& p = ues_[rnti];
+    p.serving_pci      = serving_pci;
+    p.serving          = {serving_rsrp_dbm, ts};
+    for (const auto& [pci, v] : neighbor_rsrp_dbm) {
+      p.neighbors[pci] = {v, ts};
+    }
+    ++nof_reports_;
+  }
+
+  void forget_ue(uint16_t rnti)
+  {
+    std::lock_guard<std::mutex> lk(m_);
+    ues_.erase(rnti);
+  }
+
+  // ---------------------------------------------------------------- producer 2: peer bus file
+  /// Flat text format written by the agent (one record per line, '#' comments):
+  ///   cell <pci> <ssb_dbm> <ts>
+  ///   link <pci> <rnti_hex> <k_db> <tx_dbm> <beta> <er_size> <signal_rx_dbm>
+  ///   rxpwr <pci> <rnti_hex> <from_pci> <rx_dbm>      (that link's receiver hears cell from_pci)
+  /// Re-read at most every refresh_ms; cheap when the file is absent (env unset => no-op).
+  void refresh_peers_from_file(const char* path, long long now_ms, long long refresh_ms = 500)
+  {
+    if (path == nullptr || *path == '\0') {
+      return;
+    }
+    {
+      std::lock_guard<std::mutex> lk(m_);
+      if (now_ms - last_peer_refresh_ms_ < refresh_ms) {
+        return;
+      }
+      last_peer_refresh_ms_ = now_ms;
+    }
+    FILE* f = std::fopen(path, "r");
+    if (f == nullptr) {
+      return;
+    }
+    std::map<uint16_t, peer_cell> fresh;
+    char line[512];
+    while (std::fgets(line, sizeof(line), f) != nullptr) {
+      char     kind[8] = {0};
+      unsigned pci = 0;
+      if (std::sscanf(line, "%7s %u", kind, &pci) != 2) {
+        continue;
+      }
+      peer_cell& c = fresh[static_cast<uint16_t>(pci)];
+      c.pci        = static_cast<uint16_t>(pci);
+      if (std::strcmp(kind, "cell") == 0) {
+        double ts = 0.0;
+        std::sscanf(line, "%*s %*u %f %lf", &c.ssb_pwr_dbm, &ts);
+        c.ts = ts;
+      } else if (std::strcmp(kind, "link") == 0) {
+        peer_link l;
+        unsigned  rnti = 0, er = 0;
+        if (std::sscanf(line, "%*s %*u %x %f %f %f %u %f", &rnti, &l.k_db, &l.tx_pwr_dbm, &l.beta, &er,
+                        &l.signal_rx_dbm) >= 4) {
+          l.rnti    = static_cast<uint16_t>(rnti);
+          l.er_size = er;
+          c.links.push_back(l);
+        }
+      } else if (std::strcmp(kind, "rxpwr") == 0) {
+        unsigned rnti = 0, from = 0;
+        float    v    = 0.0F;
+        if (std::sscanf(line, "%*s %*u %x %u %f", &rnti, &from, &v) == 3) {
+          for (peer_link& l : c.links) {
+            if (l.rnti == static_cast<uint16_t>(rnti)) {
+              l.rx_pwr_from_pci_dbm[static_cast<uint16_t>(from)] = v;
+            }
+          }
+        }
+      }
+    }
+    std::fclose(f);
+    std::lock_guard<std::mutex> lk(m_);
+    peers_ = std::move(fresh);
+  }
+
+  // ---------------------------------------------------------------- consumers
+  bool has_ue(uint16_t rnti) const
+  {
+    std::lock_guard<std::mutex> lk(m_);
+    return ues_.count(rnti) > 0;
+  }
+
+  ue_meas_picture ue_picture(uint16_t rnti) const
+  {
+    std::lock_guard<std::mutex> lk(m_);
+    auto it = ues_.find(rnti);
+    return it == ues_.end() ? ue_meas_picture{} : it->second;
+  }
+
+  /// DL-victim candidate list for a UE: every neighbor cell it reported, as received power at the
+  /// UE (dBm), directly comparable with the serving RSRP from the same report. The peer's PRB
+  /// occupancy (if published) becomes the activity factor. Samples older than max_age_s are dropped.
+  std::vector<nbr_candidate> dl_candidates(uint16_t rnti, double now, double max_age_s = 5.0) const
+  {
+    std::vector<nbr_candidate> out;
+    std::lock_guard<std::mutex> lk(m_);
+    auto it = ues_.find(rnti);
+    if (it == ues_.end()) {
+      return out;
+    }
+    for (const auto& [pci, s] : it->second.neighbors) {
+      if (pci == it->second.serving_pci || now - s.ts > max_age_s) {
+        continue;
+      }
+      nbr_candidate c;
+      c.pci        = pci;
+      c.rx_pwr_dbm = s.rsrp_dbm;
+      c.age_s      = now - s.ts;
+      auto pit     = peers_.find(pci);
+      if (pit != peers_.end() && !pit->second.links.empty()) {
+        float b = 0.0F;
+        for (const peer_link& l : pit->second.links) {
+          b = std::max(b, l.beta);
+        }
+        c.activity = b > 0.0F ? b : 1.0F;
+      }
+      out.push_back(c);
+    }
+    return out;
+  }
+
+  std::map<uint16_t, peer_cell> peers() const
+  {
+    std::lock_guard<std::mutex> lk(m_);
+    return peers_;
+  }
+
+  /// DL gain of neighbor cell -> this UE (dB, negative path gain): G = SSB_power(peer) - RSRP.
+  /// Falls back to fallback_ssb_dbm (our own cell's SSB power) when the peer never published.
+  bool dl_gain_db(uint16_t rnti, uint16_t nbr_pci, float fallback_ssb_dbm, float& gain_db) const
+  {
+    std::lock_guard<std::mutex> lk(m_);
+    auto it = ues_.find(rnti);
+    if (it == ues_.end()) {
+      return false;
+    }
+    auto nit = it->second.neighbors.find(nbr_pci);
+    if (nit == it->second.neighbors.end()) {
+      return false;
+    }
+    float ssb = fallback_ssb_dbm;
+    auto  pit = peers_.find(nbr_pci);
+    if (pit != peers_.end()) {
+      ssb = pit->second.ssb_pwr_dbm;
+    }
+    gain_db = nit->second.rsrp_dbm - ssb;
+    return true;
+  }
+
+  uint64_t nof_reports() const
+  {
+    std::lock_guard<std::mutex> lk(m_);
+    return nof_reports_;
+  }
+
+  std::vector<uint16_t> known_ues() const
+  {
+    std::vector<uint16_t> v;
+    std::lock_guard<std::mutex> lk(m_);
+    for (const auto& [rnti, p] : ues_) {
+      v.push_back(rnti);
+    }
+    return v;
+  }
+
+private:
+  mutable std::mutex                  m_;
+  std::map<uint16_t, ue_meas_picture> ues_;
+  std::map<uint16_t, peer_cell>       peers_;
+  long long                           last_peer_refresh_ms_ = 0;
+  uint64_t                            nof_reports_          = 0;
+};
+
+/// Process-wide instance (one gNB process = one cell on this bench).
+inline pktr_neighbor_store& neighbor_store()
+{
+  static pktr_neighbor_store s;
+  return s;
+}
+
+/// Path of the peer-bus file (KAIAIR_PKTR_PEERS_FILE), read once; nullptr => peer bus off.
+inline const char* peers_file_path()
+{
+  static const char* p = std::getenv("KAIAIR_PKTR_PEERS_FILE");
+  return (p != nullptr && *p != '\0') ? p : nullptr;
+}
+
+inline double wall_now_s()
+{
+  return std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+inline long long steady_now_ms_ns()
+{
+  return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+} // namespace kaiair
+} // namespace ocudu
