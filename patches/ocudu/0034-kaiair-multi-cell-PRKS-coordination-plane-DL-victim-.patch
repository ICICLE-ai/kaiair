diff --git a/lib/scheduler/kaiair/pktr_conflict_graph.h b/lib/scheduler/kaiair/pktr_conflict_graph.h
new file mode 100644
index 0000000000..2ae3757adf
--- /dev/null
+++ b/lib/scheduler/kaiair/pktr_conflict_graph.h
@@ -0,0 +1,124 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+//
+// KaiAir / PktR, conflict graph over links (PRKS-TWC §III-D; plan step B4).
+//
+// A link is (transmitter T, receiver R, direction). Under the PRK/GRK model the exclusion region
+// of link (S,R) with parameter K is E_{S,R} = { C : G(C,R) >= G(S,R)/K }, i.e. in dB
+//   C in ER  <=>  rx_pwr_dbm(C at R) >= rx_pwr_dbm(S at R) - K_db
+// (equal-TX-power form; with published TX powers the gains are compared instead).
+// Two links CONFLICT iff (a) they share an end node, or (b) the transmitter of one lies inside the
+// exclusion region of the other, in EITHER direction (the union, deferral is mutual by
+// construction, so no node ever waits on a node that is waiting on it).
+//
+// Pure data + math, header-only, unit-testable offline. The scheduler's slot gate (pktr_slot_gate.h)
+// consumes the conflict sets; the neighbor store supplies the inputs.
+
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <map>
+#include <vector>
+
+namespace ocudu {
+namespace kaiair {
+
+enum class link_dir : uint8_t { dl, ul };
+
+/// A node id that is unique across cells: (pci, rnti) for UEs; (pci, 0) for the gNB itself.
+struct node_id {
+  uint16_t pci  = 0xffff;
+  uint16_t rnti = 0; // 0 = the cell's gNB
+  bool operator==(const node_id& o) const { return pci == o.pci && rnti == o.rnti; }
+  bool operator<(const node_id& o) const { return pci != o.pci ? pci < o.pci : rnti < o.rnti; }
+};
+
+/// A link as known to the conflict graph.
+struct cg_link {
+  uint32_t id = 0;       // stable link id used for priority hashing (e.g. pci<<16 | rnti | dir<<31)
+  node_id  tx;           // transmitter
+  node_id  rx;           // receiver
+  link_dir dir = link_dir::dl;
+  float    k_db = 0.0F;  // link's current K (dB). <= 0 => ER empty (tolerate everything)
+  float    signal_rx_dbm = 0.0F; // desired-signal received power at rx (dBm-scale used below)
+  /// Received power at THIS link's receiver from other nodes' transmitters, same dBm scale.
+  std::map<node_id, float> rx_pwr_from_dbm;
+};
+
+/// Stable link id helper.
+inline uint32_t make_link_id(uint16_t pci, uint16_t rnti, link_dir d)
+{
+  return (static_cast<uint32_t>(d == link_dir::ul ? 1U : 0U) << 31) | (static_cast<uint32_t>(pci) << 16) | rnti;
+}
+
+/// Is node C inside link L's exclusion region? Unknown gains => not in ER (we cannot claim
+/// interference we have not measured; the K regulator will expand K if reliability suffers).
+inline bool in_exclusion_region(const cg_link& l, const node_id& c)
+{
+  if (l.k_db <= 0.0F) {
+    return false;
+  }
+  auto it = l.rx_pwr_from_dbm.find(c);
+  if (it == l.rx_pwr_from_dbm.end()) {
+    return false;
+  }
+  return it->second >= l.signal_rx_dbm - l.k_db;
+}
+
+/// Conflict predicate (PRKS §III-D): shared end node, or mutual-ER membership in either direction.
+inline bool links_conflict(const cg_link& a, const cg_link& b)
+{
+  if (a.id == b.id) {
+    return false;
+  }
+  if (a.tx == b.tx || a.rx == b.rx || a.tx == b.rx || a.rx == b.tx) {
+    return true;
+  }
+  return in_exclusion_region(a, b.tx) || in_exclusion_region(b, a.tx);
+}
+
+/// The conflict graph: links + adjacency (M_i sets).
+class pktr_conflict_graph
+{
+public:
+  void clear() { links_.clear(); }
+  void add_link(const cg_link& l) { links_[l.id] = l; }
+  const std::map<uint32_t, cg_link>& links() const { return links_; }
+
+  /// Conflict set M_i of link id (excludes itself).
+  std::vector<uint32_t> conflict_set(uint32_t id) const
+  {
+    std::vector<uint32_t> out;
+    auto it = links_.find(id);
+    if (it == links_.end()) {
+      return out;
+    }
+    for (const auto& [oid, ol] : links_) {
+      if (links_conflict(it->second, ol)) {
+        out.push_back(oid);
+      }
+    }
+    return out;
+  }
+
+  /// All conflicting pairs (id_a < id_b).
+  std::vector<std::pair<uint32_t, uint32_t>> conflict_pairs() const
+  {
+    std::vector<std::pair<uint32_t, uint32_t>> out;
+    for (auto a = links_.begin(); a != links_.end(); ++a) {
+      for (auto b = std::next(a); b != links_.end(); ++b) {
+        if (links_conflict(a->second, b->second)) {
+          out.emplace_back(a->first, b->first);
+        }
+      }
+    }
+    return out;
+  }
+
+private:
+  std::map<uint32_t, cg_link> links_;
+};
+
+} // namespace kaiair
+} // namespace ocudu
diff --git a/lib/scheduler/kaiair/pktr_er_controller.h b/lib/scheduler/kaiair/pktr_er_controller.h
new file mode 100644
index 0000000000..9a52863fe0
--- /dev/null
+++ b/lib/scheduler/kaiair/pktr_er_controller.h
@@ -0,0 +1,167 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+//
+// KaiAir / PktR, EXCLUSION-REGION CONTROLLER tick (plan steps B3-B5, DL-victim half).
+//
+// Once per tick (today: the 1 s metrics tick; later: a DU background executor) it
+//   1. takes every UE we serve and builds its DL link's GRK state LIVE from the neighbor store:
+//      signal S = the UE's serving-cell RSRP, candidates = the neighbor cells' RSRPs the SAME UE
+//      reported (same dBm scale, no calibration needed), E_max[I_R] = S - gamma_DL - sigma_DL*k(beta)
+//      -> size_exclusion_region() gives K and the ER (PRKS/PktR: K quantized to the boundary
+//      interferer). This replaces the bench-calibrated env pseudo-interferer.
+//   2. adds the PEER links published on the bus (their K, their receivers' view of our cell),
+//   3. builds the conflict graph (mutual ER membership, PRKS §III-D),
+//   4. computes ONAMA masks for OUR links over a look-ahead window and publishes them to the gate
+//      table the scheduler consults (observe-only or enforce per KAIAIR_PKTR_ER_GATE).
+// It also returns a per-UE summary for the telemetry JSON / the peer bus ("links" array).
+
+#pragma once
+
+#include "ocudu/kaiair/pktr_neighbor_store.h"
+#include "pktr_conflict_graph.h"
+#include "pktr_gate_table.h"
+#include "pktr_grk.h"
+#include "pktr_ipc.h"
+#include "pktr_runtime_config.h"
+#include <cstdint>
+#include <cstdlib>
+#include <map>
+#include <memory>
+#include <vector>
+
+namespace ocudu {
+namespace kaiair {
+
+/// Per-UE input the tick needs from the scheduler metrics.
+struct er_ue_input {
+  uint16_t rnti        = 0;
+  float    dl_sigma_db = 0.0F; // DL Cantelli sigma (from the true-SINR link state)
+  float    dl_shed_db  = 0.0F; // current DL power shed (actuator), for the published TX power
+  float    beta        = 0.0F; // PRB-occupancy fraction this interval
+};
+
+/// Per-UE output: the live GRK verdict + what the peer bus publishes.
+struct er_ue_result {
+  uint16_t                  rnti            = 0;
+  bool                      live            = false; // true when built from measured neighbors
+  float                     serv_rsrp_dbm   = 0.0F;
+  float                     e_max_dbm       = 0.0F;
+  float                     k_db            = 0.0F;
+  unsigned                  er_size         = 0;
+  float                     residual_dbm    = 0.0F;
+  std::map<uint16_t, float> nbr_rsrp_dbm;             // pci -> dBm (what this UE hears)
+  std::vector<uint16_t>     er_pcis;                  // cells inside this link's ER
+  std::vector<uint32_t>     conflicts;                // conflicting link ids (ours + peers)
+  float                     active_fraction = 1.0F;   // of the computed mask window
+};
+
+struct er_tick_result {
+  std::vector<er_ue_result> ues;
+  unsigned                  nof_peer_cells = 0;
+  unsigned                  nof_peer_links = 0;
+  er_gate_mode              mode           = er_gate_mode::off;
+};
+
+/// Run one controller tick. \p now_slot is the current slot count (for mask windows), \p window the
+/// look-ahead length in slots (>= the pipelining margin plus one tick's worth of slots).
+inline er_tick_result er_controller_tick(uint16_t                        my_pci,
+                                         const std::vector<er_ue_input>& ues,
+                                         uint32_t                        now_slot,
+                                         unsigned                        window,
+                                         const pktr_settings&            s = pktr_runtime())
+{
+  er_tick_result       out;
+  pktr_neighbor_store& store = neighbor_store();
+  store.refresh_peers_from_file(peers_file_path(), steady_now_ms_ns());
+  const double now = wall_now_s();
+
+  out.mode = parse_gate_mode(std::getenv("KAIAIR_PKTR_ER_GATE"));
+
+  pktr_conflict_graph graph;
+  const float         gamma_dl = pktr_dl_gamma_now(s.dl_gamma_db);
+
+  // 1. Our DL links from live neighbor measurements.
+  for (const er_ue_input& in : ues) {
+    er_ue_result r;
+    r.rnti           = in.rnti;
+    const auto pic   = store.ue_picture(in.rnti);
+    const auto cands = store.dl_candidates(in.rnti, now);
+    if (pic.serving_pci == 0xffff || cands.empty()) {
+      out.ues.push_back(r); // no measurements yet: not live
+      continue;
+    }
+    r.live          = true;
+    r.serv_rsrp_dbm = pic.serving.rsrp_dbm;
+    for (const auto& [pci, smp] : pic.neighbors) {
+      r.nbr_rsrp_dbm[pci] = smp.rsrp_dbm;
+    }
+    // E_max[I_R] in the UE's dBm scale: S - gamma_DL - sigma_DL * k(beta).
+    pktr_config cfg = s.ipc;
+    cfg.gamma_db    = gamma_dl;
+    r.e_max_dbm     = max_tolerable_interference_db(r.serv_rsrp_dbm, in.dl_sigma_db, cfg);
+    std::vector<grk_interferer> gi;
+    for (const nbr_candidate& c : cands) {
+      // Equal-TX-power form: received power stands in for gain (tx term 0), activity = peer beta.
+      gi.push_back(grk_interferer{c.pci, c.rx_pwr_dbm, 0.0F, c.activity});
+    }
+    const grk_state g = size_exclusion_region(r.serv_rsrp_dbm, r.e_max_dbm, std::move(gi));
+    r.k_db            = g.k_db;
+    r.er_size         = static_cast<unsigned>(g.exclusion_region.size());
+    r.residual_dbm    = g.residual_interference_db;
+    for (uint32_t id : g.exclusion_region) {
+      r.er_pcis.push_back(static_cast<uint16_t>(id));
+    }
+
+    cg_link l;
+    l.id            = make_link_id(my_pci, in.rnti, link_dir::dl);
+    l.tx            = {my_pci, 0};
+    l.rx            = {my_pci, in.rnti};
+    l.dir           = link_dir::dl;
+    l.k_db          = g.k_db;
+    l.signal_rx_dbm = r.serv_rsrp_dbm;
+    for (const auto& [pci, v] : r.nbr_rsrp_dbm) {
+      l.rx_pwr_from_dbm[{pci, 0}] = v;
+    }
+    graph.add_link(l);
+    out.ues.push_back(r);
+  }
+
+  // 2. Peer links from the bus (their receivers' view of us decides if WE are in THEIR ER).
+  for (const auto& [pci, cell] : store.peers()) {
+    ++out.nof_peer_cells;
+    for (const peer_link& pl : cell.links) {
+      cg_link l;
+      l.id            = make_link_id(pci, pl.rnti, link_dir::dl);
+      l.tx            = {pci, 0};
+      l.rx            = {pci, pl.rnti};
+      l.dir           = link_dir::dl;
+      l.k_db          = pl.k_db;
+      l.signal_rx_dbm = pl.signal_rx_dbm;
+      for (const auto& [from, v] : pl.rx_pwr_from_pci_dbm) {
+        l.rx_pwr_from_dbm[{from, 0}] = v;
+      }
+      graph.add_link(l);
+      ++out.nof_peer_links;
+    }
+  }
+
+  // 3./4. Conflict sets for OUR links -> ONAMA masks -> gate table.
+  auto snap    = std::make_shared<gate_snapshot>();
+  snap->mode   = out.mode;
+  snap->my_pci = my_pci;
+  for (er_ue_result& r : out.ues) {
+    if (!r.live) {
+      continue;
+    }
+    const uint32_t id = make_link_id(my_pci, r.rnti, link_dir::dl);
+    r.conflicts       = graph.conflict_set(id);
+    link_slot_mask m  = compute_link_mask(id, now_slot, window, r.conflicts);
+    r.active_fraction = active_fraction(m);
+    snap->masks[id]   = std::move(m);
+  }
+  gate_table().publish(std::move(snap));
+  return out;
+}
+
+} // namespace kaiair
+} // namespace ocudu
diff --git a/lib/scheduler/kaiair/pktr_gate_table.h b/lib/scheduler/kaiair/pktr_gate_table.h
new file mode 100644
index 0000000000..346931e589
--- /dev/null
+++ b/lib/scheduler/kaiair/pktr_gate_table.h
@@ -0,0 +1,69 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+//
+// KaiAir / PktR, process-wide GATE TABLE: the slot path's read-only view of the ONAMA masks.
+// A background tick (pktr_er_controller) builds a fresh snapshot {link -> slot mask} and swaps it
+// in atomically; the scheduler's per-UE allocation predicates do one shared_ptr load + map lookup.
+// Never blocks, never throws; an absent link or a slot outside the window FAILS OPEN (allowed).
+
+#pragma once
+
+#include "pktr_conflict_graph.h"
+#include "pktr_slot_gate.h"
+#include <atomic>
+#include <cstdint>
+#include <map>
+#include <memory>
+
+namespace ocudu {
+namespace kaiair {
+
+struct gate_snapshot {
+  er_gate_mode                       mode   = er_gate_mode::off;
+  uint16_t                           my_pci = 0xffff; // this cell (one gNB process = one cell here)
+  std::map<uint32_t, link_slot_mask> masks;           // link id -> mask
+};
+
+class pktr_gate_table
+{
+public:
+  void publish(std::shared_ptr<const gate_snapshot> snap) { std::atomic_store(&snap_, std::move(snap)); }
+  std::shared_ptr<const gate_snapshot> load() const { return std::atomic_load(&snap_); }
+
+  /// Slot-path query for one of OUR links. Returns true when the link may transmit in this slot.
+  /// In observe mode the answer is always true but would-be mutings are counted for telemetry.
+  bool allowed(uint16_t rnti, link_dir dir, uint32_t slot_count)
+  {
+    auto s = load();
+    if (!s || s->mode == er_gate_mode::off) {
+      return true;
+    }
+    auto it = s->masks.find(make_link_id(s->my_pci, rnti, dir));
+    if (it == s->masks.end()) {
+      return true;
+    }
+    if (it->second.at(slot_count)) {
+      allowed_decisions_.fetch_add(1, std::memory_order_relaxed);
+      return true;
+    }
+    muted_decisions_.fetch_add(1, std::memory_order_relaxed);
+    return s->mode != er_gate_mode::enforce;
+  }
+
+  uint64_t muted_decisions() const { return muted_decisions_.load(std::memory_order_relaxed); }
+  uint64_t allowed_decisions() const { return allowed_decisions_.load(std::memory_order_relaxed); }
+
+private:
+  std::shared_ptr<const gate_snapshot> snap_;
+  std::atomic<uint64_t>                muted_decisions_{0};
+  std::atomic<uint64_t>                allowed_decisions_{0};
+};
+
+inline pktr_gate_table& gate_table()
+{
+  static pktr_gate_table t;
+  return t;
+}
+
+} // namespace kaiair
+} // namespace ocudu
