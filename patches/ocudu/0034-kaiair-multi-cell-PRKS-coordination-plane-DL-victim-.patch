diff --git a/lib/scheduler/kaiair/pktr_slot_gate.h b/lib/scheduler/kaiair/pktr_slot_gate.h
new file mode 100644
index 0000000000..5453b5fe15
--- /dev/null
+++ b/lib/scheduler/kaiair/pktr_slot_gate.h
@@ -0,0 +1,107 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+//
+// KaiAir / PktR, ONAMA slot gate (PRKS-TWC §III-D, pktR §V; plan step B5).
+//
+// Per slot, every link gets a pseudo-random priority from a deterministic hash of (slot, link id)
+// that EVERY cell computes identically (no message needed per slot). A link is ACTIVE in a slot
+// iff it outranks every link in its conflict set for that slot; otherwise it is MUTED. One winner
+// per conflicting pair per slot => no mutual deferral deadlock; randomization per slot => no
+// starvation; expected share ~ 1/(|M_i|+1) for a full clique.
+//
+// Masks are meant to be precomputed M slots ahead on a background executor (pipelining, as in
+// PktR's OAI prototype) and looked up in the slot path. This header is the pure function core:
+// given the conflict sets, answer "is link L active in slot s?". Gate policy:
+//   off     : never mute (stock scheduling)
+//   observe : compute, count would-be mutings, never mute
+//   enforce : mute losing links (the slice scheduler skips them)
+
+#pragma once
+
+#include <cstdint>
+#include <string_view>
+#include <vector>
+
+namespace ocudu {
+namespace kaiair {
+
+enum class er_gate_mode : uint8_t { off, observe, enforce };
+
+inline er_gate_mode parse_gate_mode(const char* s)
+{
+  if (s == nullptr) {
+    return er_gate_mode::off;
+  }
+  std::string_view v(s);
+  if (v == "enforce" || v == "1") {
+    return er_gate_mode::enforce;
+  }
+  if (v == "observe") {
+    return er_gate_mode::observe;
+  }
+  return er_gate_mode::off;
+}
+
+/// Deterministic per-(slot, link) priority: splitmix64 finalizer over the pair. Identical on every
+/// node by construction; uniform enough that ties are negligible (ties broken by link id).
+inline uint64_t onama_priority(uint32_t slot_count, uint32_t link_id)
+{
+  uint64_t z = (static_cast<uint64_t>(slot_count) << 32) ^ link_id ^ 0x9E3779B97F4A7C15ULL;
+  z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
+  z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
+  return z ^ (z >> 31);
+}
+
+/// ACTIVE iff L outranks every conflicting link in this slot (tie -> larger link id wins).
+inline bool onama_active(uint32_t slot_count, uint32_t link_id, const std::vector<uint32_t>& conflict_set)
+{
+  const uint64_t mine = onama_priority(slot_count, link_id);
+  for (uint32_t other : conflict_set) {
+    const uint64_t theirs = onama_priority(slot_count, other);
+    if (theirs > mine || (theirs == mine && other > link_id)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+/// Precomputed activity mask for one link over a window of slots (bit i = slot base+i active).
+struct link_slot_mask {
+  uint32_t              link_id    = 0;
+  uint32_t              base_slot  = 0;
+  std::vector<uint8_t>  active;  // 1 = active, 0 = muted; size = window
+  bool at(uint32_t slot_count) const
+  {
+    const uint32_t i = slot_count - base_slot;
+    return i < active.size() ? active[i] != 0 : true; // outside window => fail-open (never block)
+  }
+};
+
+inline link_slot_mask
+compute_link_mask(uint32_t link_id, uint32_t base_slot, unsigned window, const std::vector<uint32_t>& conflict_set)
+{
+  link_slot_mask m;
+  m.link_id   = link_id;
+  m.base_slot = base_slot;
+  m.active.resize(window);
+  for (unsigned i = 0; i < window; ++i) {
+    m.active[i] = onama_active(base_slot + i, link_id, conflict_set) ? 1 : 0;
+  }
+  return m;
+}
+
+/// Fraction of slots a link is active over a window (for telemetry / the concurrency metric).
+inline float active_fraction(const link_slot_mask& m)
+{
+  if (m.active.empty()) {
+    return 1.0F;
+  }
+  unsigned n = 0;
+  for (uint8_t a : m.active) {
+    n += a;
+  }
+  return static_cast<float>(n) / static_cast<float>(m.active.size());
+}
+
+} // namespace kaiair
+} // namespace ocudu
