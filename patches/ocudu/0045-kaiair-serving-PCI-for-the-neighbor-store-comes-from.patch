From ab8c2088e66490d74ef8ce960785c20f3ebd1297 Mon Sep 17 00:00:00 2001
From: Taimoor Ul Islam <tislam@iastate.edu>
Date: Sat, 22 Aug 2026 16:27:53 -0500
Subject: [PATCH 45/54] kaiair: serving PCI for the neighbor store comes from
 the UE context, not the (neighbor-keyed) meas context

---
 lib/cu_cp/cell_meas_manager/cell_meas_manager_impl.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/lib/cu_cp/cell_meas_manager/cell_meas_manager_impl.cpp b/lib/cu_cp/cell_meas_manager/cell_meas_manager_impl.cpp
index ba3610323c..7a08a5be8d 100644
--- a/lib/cu_cp/cell_meas_manager/cell_meas_manager_impl.cpp
+++ b/lib/cu_cp/cell_meas_manager/cell_meas_manager_impl.cpp
@@ -361,8 +361,10 @@ void cell_meas_manager::report_measurement(cu_cp_ue_index_t ue_index, const rrc_
       }
     }
     {
-      const auto&    kaiair_cell = cfg.cells.at(meas_ctxt.nci).serving_cell_cfg;
-      const uint16_t kaiair_pci  = kaiair_cell.pci.has_value() ? static_cast<uint16_t>(kaiair_cell.pci.value()) : 0xffff;
+      // Serving PCI = the UE's own cell. NOT meas_ctxt.nci: for neighbor-triggered (A3) meas IDs the
+      // measurement context is keyed by the NEIGHBOR cell (bench: serving showed as pci2 and the
+      // candidate list skipped the real neighbor as "serving").
+      const uint16_t kaiair_pci = static_cast<uint16_t>(kaiair_ue->get_pci());
       // Serving RSRP may be absent in an event-triggered report (OAI nrUE); store NaN and let the
       // consumer fall back (the DU knows the serving signal from its own feedback chain).
       const float kaiair_serv_dbm =
