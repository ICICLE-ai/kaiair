+  float dl_eta = 0.1F;
+  /// IPC-DL loop initial / backed-off nominal offset (dB), clamped to [0,15]. The loop modulates DOWN
+  /// from the ceiling (offset 0 = max power) and NEVER goes negative, so it never clips (Check B).
+  float dl_nominal_db = 0.0F;
 };
 
 namespace detail {
@@ -76,6 +95,11 @@ inline pktr_settings load_pktr_settings()
   s.ipc.beta           = std::clamp(env_float("KAIAIR_PKTR_BETA", s.ipc.beta), 0.0F, 0.999999F);
   s.ipc.ewma_c         = std::clamp(env_float("KAIAIR_PKTR_EWMA_C", s.ipc.ewma_c), 0.0F, 0.999999F);
   s.sigma_transient_db = std::max(0.0F, env_float("KAIAIR_PKTR_SIGMA_TRANSIENT_DB", s.sigma_transient_db));
+  s.dl_actuate         = env_flag("KAIAIR_PKTR_DL_ACTUATE");
+  s.dl_pwr_offset_db   = std::clamp(env_float("KAIAIR_PKTR_DL_PWR_OFFSET", 0.0F), -8.0F, 15.0F);
+  s.dl_loop            = env_flag("KAIAIR_PKTR_DL_LOOP");
+  s.dl_eta             = std::max(0.0F, env_float("KAIAIR_PKTR_DL_ETA", s.dl_eta));
+  s.dl_nominal_db      = std::clamp(env_float("KAIAIR_PKTR_DL_NOMINAL_DB", s.dl_nominal_db), 0.0F, 15.0F);
   return s;
 }
 
@@ -110,5 +134,26 @@ inline float pktr_ul_sinr_offset_db(const pktr_link_state& ls)
   return pktr_ul_sinr_offset_db(ls, pktr_runtime());
 }
 
+/// Per-grant DL power offset (as a \c pwr_ctrl_offset value) for Tier-A DL actuation. Returns the
+/// value to write into \c pdsch.tx_pwr_info.pwr_ctrl_offset for C-RNTI data PDSCH, or \c nullopt to
+/// keep the stock (CSI-derived) value. This is the single home of the IPC-DL actuation policy
+/// (mirrors the UL \c pktr_ul_sinr_offset_db). Increment 1 returns the static env offset; Increment 2
+/// will take a per-UE argument from the DL \c pktr_link_state / HARQ-ACK BLER loop. Quantized to the
+/// int8 1-dB field and clamped to the 3GPP {-8..15} range (HIGHER = LOWER PDSCH power).
+inline std::optional<int8_t> pktr_dl_pwr_ctrl_offset(const pktr_settings& s)
+{
+  // The closed loop, when active, drives the per-UE offset in the allocator instead of this static one.
+  if (not s.dl_actuate or s.dl_loop) {
+    return std::nullopt;
+  }
+  return static_cast<int8_t>(std::lround(std::clamp(s.dl_pwr_offset_db, -8.0F, 15.0F)));
+}
+
+/// Convenience overload using the process-wide settings.
+inline std::optional<int8_t> pktr_dl_pwr_ctrl_offset()
+{
+  return pktr_dl_pwr_ctrl_offset(pktr_runtime());
+}
+
 } // namespace kaiair
 } // namespace ocudu
