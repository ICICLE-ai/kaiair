+
+// --- Tier-A DL power actuation (Increment 1: open-loop per-PDSCH offset) ---
+
+// DL actuation off => no override (the stock CSI-derived pwr_ctrl_offset is kept).
+TEST(pktr_runtime_config_test, dl_offset_nullopt_when_actuation_disabled)
+{
+  pktr_settings s;
+  s.dl_actuate       = false;
+  s.dl_pwr_offset_db = 12.0F; // ignored while off
+  EXPECT_FALSE(pktr_dl_pwr_ctrl_offset(s).has_value());
+}
+
+// DL actuation on => returns the offset, quantized to the int8 1-dB pwr_ctrl_offset field.
+TEST(pktr_runtime_config_test, dl_offset_returns_quantized_value_when_enabled)
+{
+  pktr_settings s;
+  s.dl_actuate       = true;
+  s.dl_pwr_offset_db = 15.0F;
+  const auto off     = pktr_dl_pwr_ctrl_offset(s);
+  ASSERT_TRUE(off.has_value());
+  EXPECT_EQ(*off, static_cast<int8_t>(15));
+  s.dl_pwr_offset_db = 5.6F; // fractional dB rounds to nearest 1-dB step
+  EXPECT_EQ(*pktr_dl_pwr_ctrl_offset(s), static_cast<int8_t>(6));
+}
+
+// The returned offset is clamped to the 3GPP {-8..15} field range.
+TEST(pktr_runtime_config_test, dl_offset_clamped_to_field_range)
+{
+  pktr_settings s;
+  s.dl_actuate       = true;
+  s.dl_pwr_offset_db = 100.0F;
+  EXPECT_EQ(*pktr_dl_pwr_ctrl_offset(s), static_cast<int8_t>(15));
+  s.dl_pwr_offset_db = -100.0F;
+  EXPECT_EQ(*pktr_dl_pwr_ctrl_offset(s), static_cast<int8_t>(-8));
+}
+
+// Env loads the DL knobs; the static offset is clamped at load time.
+TEST(pktr_runtime_config_test, dl_env_loads_and_clamps)
+{
+  clear_env();
+  ::setenv("KAIAIR_PKTR_DL_ACTUATE", "1", 1);
+  ::setenv("KAIAIR_PKTR_DL_PWR_OFFSET", "12", 1);
+  const pktr_settings s = detail::load_pktr_settings();
+  EXPECT_TRUE(s.dl_actuate);
+  EXPECT_FLOAT_EQ(s.dl_pwr_offset_db, 12.0F);
+  ::setenv("KAIAIR_PKTR_DL_PWR_OFFSET", "40", 1); // out of range -> clamped
+  EXPECT_FLOAT_EQ(detail::load_pktr_settings().dl_pwr_offset_db, 15.0F);
+  clear_env();
+}
+
+// DL actuation is off by default (unset env).
+TEST(pktr_runtime_config_test, dl_actuate_off_by_default)
+{
+  clear_env();
+  EXPECT_FALSE(detail::load_pktr_settings().dl_actuate);
+  clear_env();
+}
