diff --git a/lib/scheduler/kaiair/pktr_dl_power_controller.h b/lib/scheduler/kaiair/pktr_dl_power_controller.h
new file mode 100644
index 0000000000..2706faa5a2
--- /dev/null
+++ b/lib/scheduler/kaiair/pktr_dl_power_controller.h
@@ -0,0 +1,90 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+//
+// KaiAir / PktR, Tier-A IPC-DL closed-loop power controller (one per UE-per-cell link).
+//
+// On DL the gNB is not the receiver, so it cannot measure per-packet SINR. Instead it drives the
+// per-PDSCH transmit-power offset from the per-packet HARQ-ACK stream, holding the empirical BLER at
+// the PktR target (1 - beta), per-packet reliability P(success) >= beta. The actuator is the
+// pwr_ctrl_offset field (validated on hardware to move real TX power; see dl-power-actuator-confirmed).
+//
+// Authority is one-sided on this platform: boosting clips (the lower-PHY amplitude controller keeps
+// ~12 dB PAPR headroom and PDSCH already sits near the ceiling). So the offset is a SHED-from-ceiling
+// value clamped to [0, 15] dB (0 = max power = ceiling, 15 = -15 dB). The loop adds power by moving
+// toward 0 and sheds by moving toward 15; it never goes negative, so it never clips.
+//
+// Control law (per HARQ-ACK, OLLA-style asymmetric step, converges to BLER = target = 1 - beta):
+//   ack  -> offset += eta * target           (success: shed a little, save power)
+//   nack -> offset -= eta * (1 - target)      (failure: add power)
+// At equilibrium E[delta] = (1-bler)*eta*target - bler*eta*(1-target) = 0  =>  bler = target.
+// The integrator self-smooths, so no separate BLER filter is needed for control (one is kept only
+// for display/debug). This is the measurement-based half of the IPC law; the CQI-based feedforward
+// (set-point) is layered on in a later increment.
+
+#pragma once
+
+#include "pktr_runtime_config.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+
+namespace ocudu {
+namespace kaiair {
+
+/// Tier-A IPC-DL closed-loop power controller. Drives a UE's per-PDSCH DL power offset from its
+/// HARQ-ACK stream to hold the empirical BLER at the PktR target (1 - beta).
+class pktr_dl_power_controller
+{
+public:
+  /// Display-only BLER EWMA memory (not used by the control law, which self-smooths).
+  static constexpr float bler_ewma_c = 0.95F;
+
+  explicit pktr_dl_power_controller(const pktr_settings& s = pktr_runtime()) :
+    enabled_(s.dl_loop),
+    target_(std::clamp(1.0F - s.ipc.beta, 0.0F, 1.0F)),
+    eta_(std::max(0.0F, s.dl_eta)),
+    offset_db_(std::clamp(s.dl_nominal_db, 0.0F, 15.0F))
+  {
+  }
+
+  /// Feed one DL HARQ outcome (true = ACK, false = NACK). The caller filters out DTX.
+  void update(bool ack)
+  {
+    ++nof_acks_;
+    bler_ewma_ = bler_ewma_c * bler_ewma_ + (1.0F - bler_ewma_c) * (ack ? 0.0F : 1.0F);
+    if (not enabled_) {
+      return;
+    }
+    // OLLA-style asymmetric step toward BLER = target. ack -> shed (offset up); nack -> add power (down).
+    offset_db_ += ack ? (eta_ * target_) : -(eta_ * (1.0F - target_));
+    offset_db_ = std::clamp(offset_db_, 0.0F, 15.0F);
+  }
+
+  /// Per-grant DL power offset to write into pwr_ctrl_offset, or nullopt when the loop is disabled
+  /// (in which case the stock / static path applies). Quantized to the int8 1-dB field.
+  std::optional<int8_t> pwr_ctrl_offset() const
+  {
+    if (not enabled_) {
+      return std::nullopt;
+    }
+    return static_cast<int8_t>(std::lround(offset_db_));
+  }
+
+  bool     enabled() const { return enabled_; }
+  float    offset_db() const { return offset_db_; }
+  float    target() const { return target_; }
+  float    bler() const { return bler_ewma_; }
+  uint64_t nof_acks() const { return nof_acks_; }
+
+private:
+  bool     enabled_;
+  float    target_;            // 1 - beta
+  float    eta_;               // base step size (dB)
+  float    offset_db_;         // integrator state, shed-from-ceiling, [0,15]
+  float    bler_ewma_ = 0.0F;  // display/debug only
+  uint64_t nof_acks_  = 0;
+};
+
+} // namespace kaiair
+} // namespace ocudu
