diff --git a/tests/unittests/scheduler/kaiair/pktr_dl_power_controller_test.cpp b/tests/unittests/scheduler/kaiair/pktr_dl_power_controller_test.cpp
new file mode 100644
index 0000000000..b5ad988cfd
--- /dev/null
+++ b/tests/unittests/scheduler/kaiair/pktr_dl_power_controller_test.cpp
@@ -0,0 +1,102 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#include "lib/scheduler/kaiair/pktr_dl_power_controller.h"
+#include <cmath>
+#include <gtest/gtest.h>
+
+using namespace ocudu;
+using namespace ocudu::kaiair;
+
+namespace {
+
+pktr_settings loop_settings(float beta = 0.9F, float eta = 0.1F, float nominal = 7.0F)
+{
+  pktr_settings s;
+  s.dl_loop       = true;
+  s.ipc.beta      = beta;
+  s.dl_eta        = eta;
+  s.dl_nominal_db = nominal;
+  return s;
+}
+
+} // namespace
+
+// Disabled loop: no offset override, and updates never produce an actuation value.
+TEST(pktr_dl_power_controller_test, disabled_returns_nullopt)
+{
+  pktr_settings s = loop_settings();
+  s.dl_loop       = false;
+  pktr_dl_power_controller c(s);
+  EXPECT_FALSE(c.enabled());
+  EXPECT_FALSE(c.pwr_ctrl_offset().has_value());
+  for (int i = 0; i < 100; ++i) {
+    c.update(false); // even all-NACK
+  }
+  EXPECT_FALSE(c.pwr_ctrl_offset().has_value());
+}
+
+// The reliability target is 1 - beta.
+TEST(pktr_dl_power_controller_test, target_is_one_minus_beta)
+{
+  EXPECT_NEAR(pktr_dl_power_controller(loop_settings(0.9F)).target(), 0.1F, 1e-6F);
+  EXPECT_NEAR(pktr_dl_power_controller(loop_settings(0.99F)).target(), 0.01F, 1e-6F);
+}
+
+// Starts at the (backed-off) nominal offset, quantized to the 1-dB field.
+TEST(pktr_dl_power_controller_test, starts_at_nominal)
+{
+  pktr_dl_power_controller c(loop_settings(0.9F, 0.1F, 7.0F));
+  EXPECT_NEAR(c.offset_db(), 7.0F, 1e-6F);
+  ASSERT_TRUE(c.pwr_ctrl_offset().has_value());
+  EXPECT_EQ(*c.pwr_ctrl_offset(), static_cast<int8_t>(7));
+}
+
+// All ACKs => sheds power (offset rises) and saturates at the 15 dB floor, never beyond.
+TEST(pktr_dl_power_controller_test, all_acks_shed_to_max_offset)
+{
+  pktr_dl_power_controller c(loop_settings(0.9F, 0.5F, 7.0F));
+  for (int i = 0; i < 10000; ++i) {
+    c.update(true);
+  }
+  EXPECT_NEAR(c.offset_db(), 15.0F, 1e-3F);
+  EXPECT_EQ(*c.pwr_ctrl_offset(), static_cast<int8_t>(15));
+}
+
+// All NACKs => adds power (offset falls) and saturates at 0 (ceiling), NEVER negative (no clipping).
+TEST(pktr_dl_power_controller_test, all_nacks_add_to_ceiling_never_negative)
+{
+  pktr_dl_power_controller c(loop_settings(0.9F, 0.5F, 7.0F));
+  for (int i = 0; i < 10000; ++i) {
+    c.update(false);
+  }
+  EXPECT_GE(c.offset_db(), 0.0F);
+  EXPECT_NEAR(c.offset_db(), 0.0F, 1e-3F);
+  EXPECT_EQ(*c.pwr_ctrl_offset(), static_cast<int8_t>(0));
+}
+
+// Asymmetric step: a single NACK moves the offset more than a single ACK (for beta > 0.5).
+TEST(pktr_dl_power_controller_test, nack_step_larger_than_ack_step)
+{
+  pktr_dl_power_controller ca(loop_settings(0.9F, 0.1F, 7.0F));
+  ca.update(true);
+  const float ack_delta = std::fabs(ca.offset_db() - 7.0F);
+
+  pktr_dl_power_controller cn(loop_settings(0.9F, 0.1F, 7.0F));
+  cn.update(false);
+  const float nack_delta = std::fabs(cn.offset_db() - 7.0F);
+
+  EXPECT_GT(nack_delta, ack_delta);
+}
+
+// Convergence: a stream at exactly the target BLER keeps the offset near its start (zero net drift).
+TEST(pktr_dl_power_controller_test, stays_near_equilibrium_at_target_bler)
+{
+  pktr_dl_power_controller c(loop_settings(0.9F, 0.05F, 7.0F)); // target = 0.10
+  // Deterministic 9 ACK : 1 NACK pattern == 10% BLER == target.
+  for (int i = 0; i < 5000; ++i) {
+    c.update((i % 10) != 0); // NACK on every 10th update
+  }
+  EXPECT_GT(c.offset_db(), 5.0F);
+  EXPECT_LT(c.offset_db(), 9.0F);
+}
