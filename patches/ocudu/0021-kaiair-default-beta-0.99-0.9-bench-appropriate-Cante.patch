From 9d5237f3f246de63989faed30f650874f0acd7ac Mon Sep 17 00:00:00 2001
From: Taimoor Ul Islam <tislam@iastate.edu>
Date: Mon, 27 Jul 2026 12:26:35 -0500
Subject: [PATCH 21/53] kaiair: default beta 0.99 -> 0.9 (bench-appropriate
 Cantelli cushion)

0.99 (k~10) turns tenth-dB SINR jitter into multi-dB cushion and pins the loop at
max power on the testbed; 0.9 (k=3) is the long-agreed bench value. Env
KAIAIR_PKTR_BETA still overrides.
---
 lib/scheduler/kaiair/pktr_ipc.h | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/lib/scheduler/kaiair/pktr_ipc.h b/lib/scheduler/kaiair/pktr_ipc.h
index 30d826ac2f..3a175f5d95 100644
--- a/lib/scheduler/kaiair/pktr_ipc.h
+++ b/lib/scheduler/kaiair/pktr_ipc.h
@@ -45,8 +45,9 @@ namespace kaiair {
 struct pktr_config {
   /// Required SINR margin gamma (dB).
   float gamma_db = 3.0F;
-  /// Target reliability beta in (0, 1), e.g. 0.99 for 99% delivery.
-  float beta = 0.99F;
+  /// Target reliability beta in (0, 1). Bench default 0.9 (k=3): 0.99 (k~10) over-inflates the
+  /// Cantelli cushion at the testbed's SINR jitter and pins the loop at max power.
+  float beta = 0.9F;
   /// EWMA old-sample weight c for the interference filter (filter memory).
   float ewma_c = pktr_link_state::default_ewma_c;
 };
