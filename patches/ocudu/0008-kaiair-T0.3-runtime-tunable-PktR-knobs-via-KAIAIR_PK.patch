diff --git a/tests/unittests/scheduler/kaiair/pktr_runtime_config_test.cpp b/tests/unittests/scheduler/kaiair/pktr_runtime_config_test.cpp
new file mode 100644
index 0000000000..540c04b00a
--- /dev/null
+++ b/tests/unittests/scheduler/kaiair/pktr_runtime_config_test.cpp
@@ -0,0 +1,92 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#include "lib/scheduler/kaiair/pktr_runtime_config.h"
+#include <cstdlib>
+#include <gtest/gtest.h>
+
+using namespace ocudu;
+using namespace ocudu::kaiair;
+
+namespace {
+
+// Clear all KAIAIR_PKTR_* vars so each case starts from a known state. We test the (uncached)
+// detail::load_pktr_settings() directly, since pktr_runtime() caches on first use.
+void clear_env()
+{
+  ::unsetenv("KAIAIR_PKTR_METRICS");
+  ::unsetenv("KAIAIR_PKTR_GAMMA_DB");
+  ::unsetenv("KAIAIR_PKTR_BETA");
+  ::unsetenv("KAIAIR_PKTR_EWMA_C");
+  ::unsetenv("KAIAIR_PKTR_SIGMA_TRANSIENT_DB");
+}
+
+} // namespace
+
+// With nothing set, the loader returns the pktr_config defaults and disabled.
+TEST(pktr_runtime_config_test, defaults_when_unset)
+{
+  clear_env();
+  const pktr_settings s = detail::load_pktr_settings();
+  EXPECT_FALSE(s.enabled);
+  EXPECT_FLOAT_EQ(s.ipc.gamma_db, pktr_config{}.gamma_db);
+  EXPECT_FLOAT_EQ(s.ipc.beta, pktr_config{}.beta);
+  EXPECT_FLOAT_EQ(s.ipc.ewma_c, pktr_config{}.ewma_c);
+  EXPECT_FLOAT_EQ(s.sigma_transient_db, 6.0F);
+}
+
+// Valid env values are parsed into the settings.
+TEST(pktr_runtime_config_test, parses_env_values)
+{
+  clear_env();
+  ::setenv("KAIAIR_PKTR_METRICS", "1", 1);
+  ::setenv("KAIAIR_PKTR_GAMMA_DB", "5.5", 1);
+  ::setenv("KAIAIR_PKTR_BETA", "0.9", 1);
+  ::setenv("KAIAIR_PKTR_EWMA_C", "0.5", 1);
+  ::setenv("KAIAIR_PKTR_SIGMA_TRANSIENT_DB", "4.0", 1);
+  const pktr_settings s = detail::load_pktr_settings();
+  EXPECT_TRUE(s.enabled);
+  EXPECT_FLOAT_EQ(s.ipc.gamma_db, 5.5F);
+  EXPECT_FLOAT_EQ(s.ipc.beta, 0.9F);
+  EXPECT_FLOAT_EQ(s.ipc.ewma_c, 0.5F);
+  EXPECT_FLOAT_EQ(s.sigma_transient_db, 4.0F);
+  clear_env();
+}
+
+// An unparseable value falls back to the default rather than producing 0/garbage.
+TEST(pktr_runtime_config_test, bad_value_falls_back_to_default)
+{
+  clear_env();
+  ::setenv("KAIAIR_PKTR_GAMMA_DB", "not_a_number", 1);
+  const pktr_settings s = detail::load_pktr_settings();
+  EXPECT_FLOAT_EQ(s.ipc.gamma_db, pktr_config{}.gamma_db);
+  clear_env();
+}
+
+// beta and ewma_c are clamped to a finite range (no k=inf, no negative memory).
+TEST(pktr_runtime_config_test, clamps_out_of_range)
+{
+  clear_env();
+  ::setenv("KAIAIR_PKTR_BETA", "1.0", 1);    // would give k=inf unclamped
+  ::setenv("KAIAIR_PKTR_EWMA_C", "-0.5", 1); // negative memory is nonsense
+  ::setenv("KAIAIR_PKTR_SIGMA_TRANSIENT_DB", "-3.0", 1);
+  const pktr_settings s = detail::load_pktr_settings();
+  EXPECT_LT(s.ipc.beta, 1.0F);
+  EXPECT_TRUE(std::isfinite(cantelli_sigma_factor(s.ipc.beta)));
+  EXPECT_GE(s.ipc.ewma_c, 0.0F);
+  EXPECT_GE(s.sigma_transient_db, 0.0F);
+  clear_env();
+}
+
+// KAIAIR_PKTR_METRICS only enables on exactly "1".
+TEST(pktr_runtime_config_test, metrics_flag_requires_one)
+{
+  clear_env();
+  ::setenv("KAIAIR_PKTR_METRICS", "0", 1);
+  EXPECT_FALSE(detail::load_pktr_settings().enabled);
+  ::setenv("KAIAIR_PKTR_METRICS", "true", 1);
+  EXPECT_FALSE(detail::load_pktr_settings().enabled);
+  ::setenv("KAIAIR_PKTR_METRICS", "1", 1);
+  EXPECT_TRUE(detail::load_pktr_settings().enabled);
+  clear_env();
+}
