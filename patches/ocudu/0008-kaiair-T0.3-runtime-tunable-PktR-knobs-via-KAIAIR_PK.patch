index 0000000000..c24d1df581
--- /dev/null
+++ b/lib/scheduler/kaiair/pktr_runtime_config.h
@@ -0,0 +1,84 @@
+// SPDX-FileCopyrightText: Copyright (C) 2021-2026 Software Radio Systems Limited
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+//
+// KaiAir / PktR, process-wide runtime settings, loaded ONCE from the environment (T0.3).
+//
+// These are the research knobs for the PktR loops. They are read from KAIAIR_PKTR_* environment
+// variables at first use and cached, so they can be swept between gNB runs without recompiling:
+//
+//   KAIAIR_PKTR_METRICS            = 1            enable the PktR feedback view (as before)
+//   KAIAIR_PKTR_GAMMA_DB           = 3.0          required SINR margin gamma (dB)
+//   KAIAIR_PKTR_BETA               = 0.99         reliability target beta in (0,1); k=sqrt(b/(1-b))
+//   KAIAIR_PKTR_EWMA_C             = 0.9375       interference-EWMA memory c (15/16); agility knob
+//   KAIAIR_PKTR_SIGMA_TRANSIENT_DB = 6.0          sigma above which an interval is a regime transition
+//
+// Defaults match pktr_config. The gNB-YAML `pktr:` section is the planned productization (T0.3b),
+// once good operating values are found; until then the env path keeps c (a scheduler-internal knob)
+// tunable without threading config through the scheduler-config plumbing.
+
+#pragma once
+
+#include "pktr_ipc.h"
+#include <algorithm>
+#include <cstdlib>
+#include <string_view>
+
+namespace ocudu {
+namespace kaiair {
+
+/// Process-wide PktR settings.
+struct pktr_settings {
+  /// Whether the PktR feedback view is printed.
+  bool enabled = false;
+  /// IPC parameters (gamma_db, beta, ewma_c).
+  pktr_config ipc{};
+  /// EWMA sigma (dB) above which the view treats the interval as a regime transition and suppresses
+  /// the (invalid, mean-lag-dominated) Cantelli cushion.
+  float sigma_transient_db = 6.0F;
+};
+
+namespace detail {
+
+/// Parse a float environment variable; returns fallback if unset/empty/unparseable.
+inline float env_float(const char* name, float fallback)
+{
+  const char* e = std::getenv(name);
+  if (e == nullptr || *e == '\0') {
+    return fallback;
+  }
+  char*       end = nullptr;
+  const float v   = std::strtof(e, &end);
+  return (end == e) ? fallback : v;
+}
+
+/// Parse a "1"/not-"1" boolean environment flag.
+inline bool env_flag(const char* name)
+{
+  const char* e = std::getenv(name);
+  return e != nullptr && std::string_view(e) == "1";
+}
+
+/// Load settings from the environment, clamping to sane ranges. Not cached (the cache is in
+/// pktr_runtime()); exposed for unit tests that want to drive it via setenv.
+inline pktr_settings load_pktr_settings()
+{
+  pktr_settings s;
+  s.enabled            = env_flag("KAIAIR_PKTR_METRICS");
+  s.ipc.gamma_db       = env_float("KAIAIR_PKTR_GAMMA_DB", s.ipc.gamma_db);
+  s.ipc.beta           = std::clamp(env_float("KAIAIR_PKTR_BETA", s.ipc.beta), 0.0F, 0.999999F);
+  s.ipc.ewma_c         = std::clamp(env_float("KAIAIR_PKTR_EWMA_C", s.ipc.ewma_c), 0.0F, 0.999999F);
+  s.sigma_transient_db = std::max(0.0F, env_float("KAIAIR_PKTR_SIGMA_TRANSIENT_DB", s.sigma_transient_db));
+  return s;
+}
+
+} // namespace detail
+
+/// Process-wide PktR settings, loaded once from the environment (KAIAIR_PKTR_*) and cached.
+inline const pktr_settings& pktr_runtime()
+{
+  static const pktr_settings s = detail::load_pktr_settings();
+  return s;
+}
+
+} // namespace kaiair
+} // namespace ocudu
