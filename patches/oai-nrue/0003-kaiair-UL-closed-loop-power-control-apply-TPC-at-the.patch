 #include <math.h>
 #include <pthread.h>
 
@@ -803,10 +804,20 @@ int nr_config_pusch_pdu(NR_UE_MAC_INST_t *mac,
       delta_pusch = table_38_213_7_1_1_1[0][dci->tpc];
