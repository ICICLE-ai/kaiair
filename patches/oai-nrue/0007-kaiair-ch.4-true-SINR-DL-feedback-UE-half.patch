 }
 
+// KaiAir ch.4 true-SINR DL feedback (thesis §4.5.3): custom 10-bit CSI payload replacing the
+// standard report, 5-bit quantized PDSCH-data RSSI (bits 0-4) + 5-bit quantized interference
+// (bits 5-9), LSB-first per Eq. (4.56), then bit-reversed so the intended fields survive the
+// PUCCH small-block encoding chain (§4.5.3.2). Quantization: q = round((dB - REF)/STEP) clamped
+// to [0,31]; REF/STEP via KAIAIR_CH4_CSI_REF_DB / KAIAIR_CH4_CSI_STEP_DB (STEP must match the gNB).
+static nfapi_nr_ue_csi_payload_t kaiair_get_ch4_csi_payload(NR_UE_MAC_INST_t *mac)
+{
+  static float kaiair_step_db = -1.0f;
+  static float kaiair_ref_db = 0.0f;
+  if (kaiair_step_db < 0.0f) {
+    const char *s = getenv("KAIAIR_CH4_CSI_STEP_DB");
+    kaiair_step_db = s ? atof(s) : 2.0f;
+    if (kaiair_step_db < 0.25f || kaiair_step_db > 6.0f)
+      kaiair_step_db = 2.0f;
+    const char *r = getenv("KAIAIR_CH4_CSI_REF_DB");
+    kaiair_ref_db = r ? atof(r) : 0.0f;
+  }
+  const int n_bits = 10;
+  const int rsrp_bits = 5;
+  int rsrp_q = (int)lroundf((mac->csirs_measurements.kaiair_pdsch_rssi_db - kaiair_ref_db) / kaiair_step_db);
+  int interf_q = (int)lroundf((mac->csirs_measurements.kaiair_intf_db - kaiair_ref_db) / kaiair_step_db);
+  rsrp_q = rsrp_q < 0 ? 0 : (rsrp_q > 31 ? 31 : rsrp_q);
+  interf_q = interf_q < 0 ? 0 : (interf_q > 31 ? 31 : interf_q);
+  uint16_t payload = 0;
+  payload |= (uint16_t)(rsrp_q & 0x1F);
+  payload |= (uint16_t)((interf_q & 0x1F) << rsrp_bits);
+  uint64_t reversed = reverse_bits((uint64_t)payload, n_bits);
+  static int kaiair_dbg = -1;
+  if (kaiair_dbg < 0)
+    kaiair_dbg = getenv("KAIAIR_CH4_CSI_DEBUG") ? 1 : 0;
+  if (kaiair_dbg)
+    LOG_I(NR_MAC,
+          "[KaiAir ch4] CSI payload: RSSI=%.1f dB -> q=%d, I=%.1f dB -> q=%d, raw=0x%03x rev=0x%03lx (valid=%d)\n",
+          mac->csirs_measurements.kaiair_pdsch_rssi_db,
+          rsrp_q,
+          mac->csirs_measurements.kaiair_intf_db,
+          interf_q,
+          payload,
+          (unsigned long)reversed,
+          mac->csirs_measurements.kaiair_meas_valid);
+  nfapi_nr_ue_csi_payload_t csi = {.part1_payload = reversed, .p1_bits = n_bits, .p2_bits = 0};
+  return csi;
+}
+
 nfapi_nr_ue_csi_payload_t nr_get_csi_payload(NR_UE_MAC_INST_t *mac,
                                              int csi_report_id,
                                              CSI_mapping_t mapping_type,
@@ -3085,6 +3133,16 @@ nfapi_nr_ue_csi_payload_t nr_get_csi_payload(NR_UE_MAC_INST_t *mac,
 {
   AssertFatal(csi_MeasConfig->csi_ReportConfigToAddModList->list.count > 0,"No CSI Report configuration available\n");
   nfapi_nr_ue_csi_payload_t csi = {0};
+
+  // KaiAir ch.4: replace the standard CSI payload with the custom 10-bit (RSSI, I) report.
+  static int kaiair_ch4 = -1;
+  if (kaiair_ch4 < 0) {
+    const char *e = getenv("KAIAIR_CH4_CSI");
+    kaiair_ch4 = (e && e[0] == '1') ? 1 : 0;
+  }
+  if (kaiair_ch4)
+    return kaiair_get_ch4_csi_payload(mac);
+
   struct NR_CSI_ReportConfig *csi_reportconfig = csi_MeasConfig->csi_ReportConfigToAddModList->list.array[csi_report_id];
   NR_CSI_ResourceConfigId_t csi_ResourceConfigId = csi_reportconfig->resourcesForChannelMeasurement;
   if (csi_reportconfig->ext2 && csi_reportconfig->ext2->reportQuantity_r16) {
